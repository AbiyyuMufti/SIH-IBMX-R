icalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1340" y="700" width="230" height="50" as="geometry"/></mxCell><mxCell id="ch3c51" value="&lt;b&gt;DG to EL&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="110" height="70" as="geometry"/></mxCell><mxCell id="ch3c52" value="Réglages &amp;lt;partie machine&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="150" y="750" width="430" height="70" as="geometry"/></mxCell><mxCell id="ch3c53" value="Adjustments of &amp;lt;machine part&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="750" width="430" height="70" as="geometry"/></mxCell><mxCell id="ch3c54" value="33 slots (the first is &quot;Réglages Camera&quot; in some files). Category: &quot;Adjustment&quot; (macro export: Minor stop)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1010" y="750" width="330" height="70" as="geometry"/></mxCell><mxCell id="ch3c55" value="Daily_Losses_EU" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1340" y="750" width="230" height="70" as="geometry"/></mxCell><mxCell id="ch3c56" value="&lt;b&gt;EM to ES&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="110" height="50" as="geometry"/></mxCell><mxCell id="ch3c57" value="Auto Maintenance, Maintenance Préventive Mensuelle / Annuelle / Autre, Action Maintenance Planifiée, Libre 1, 2" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="150" y="820" width="430" height="50" as="geometry"/></mxCell><mxCell id="ch3c58" value="Operator asset care, Monthly / Annual / Other maintenance, Planned actions, spare" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="820" width="430" height="50" as="geometry"/></mxCell><mxCell id="ch3c59" value="Minutes. Planned losses, group &quot;Planned maintenance&quot;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1010" y="820" width="330" height="50" as="geometry"/></mxCell><mxCell id="ch3c60" value="Daily_Losses_EU" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1340" y="820" width="230" height="50" as="geometry"/></mxCell><mxCell id="ch3c61" value="&lt;b&gt;ET to LQ (180)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="110" height="110" as="geometry"/></mxCell><mxCell id="ch3c62" value="&amp;lt;Champ&gt; PF&amp;lt;n&gt; &amp;lt;équipe&gt;: Code, Temps, Volume, Déchets, Nom, Nom Formule, Caisse, Format, Vitesse" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="150" y="870" width="430" height="110" as="geometry"/></mxCell><mxCell id="ch3c63" value="&amp;lt;Field&gt; product slot &amp;lt;n&gt; &amp;lt;shift&gt;: Code, Time, Volume, Waste, Name, Formula name, Case, Format, Speed" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="870" width="430" height="110" as="geometry"/></mxCell><mxCell id="ch3c64" value="PF = Produit Fini = finished product, 4 slots (PF1 to PF4) per shift. 5 shifts: Semaine Matin / Après Midi / Nuit = weekday morning / afternoon / night; Weekend Matin / Nuit = weekend morning / night. 9 fields x 4 x 5 = 180. Temps = minutes run, Vitesse = units per minute, Caisse = case pack" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1010" y="870" width="330" height="110" as="geometry"/></mxCell><mxCell id="ch3c65" value="Plan_OPT_EU (one row per filled slot)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1340" y="870" width="230" height="110" as="geometry"/></mxCell><mxCell id="ch3c66" value="&lt;b&gt;LR to LW&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="980" width="110" height="50" as="geometry"/></mxCell><mxCell id="ch3c67" value="TownHall - Réunion, Essais Planifiés, Formation, Validation / Qualification, Temps non compté Libre 1, 2" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="150" y="980" width="430" height="50" as="geometry"/></mxCell><mxCell id="ch3c68" value="Town hall meeting, Planned trials, Training, Validation / Qualification, spare" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="980" width="430" height="50" as="geometry"/></mxCell><mxCell id="ch3c69" value="Time not counted in TOR. Groups &quot;Production not scheduled&quot; and &quot;NPD/CapEX &amp; Trials&quot;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1010" y="980" width="330" height="50" as="geometry"/></mxCell><mxCell id="ch3c70" value="Daily_Losses_EU (decide)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1340" y="980" width="230" height="50" as="geometry"/></mxCell><mxCell id="ch3c71" value="&lt;b&gt;LX to MI&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="110" height="70" as="geometry"/></mxCell><mxCell id="ch3c72" value="People Journée, Matin, Après Midi, Nuit, Week End Matin, Week End Nuit, Libre 1 to 6" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="150" y="1030" width="430" height="70" as="geometry"/></mxCell><mxCell id="ch3c73" value="People: day, morning, afternoon, night, weekend morning, weekend night, spare" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="1030" width="430" height="70" as="geometry"/></mxCell><mxCell id="ch3c74" value="Labour time in person-minutes, not a headcount (IWKA 2 values 1800, 2250, 2460, 2700; inferred). No target table has it" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1010" y="1030" width="330" height="70" as="geometry"/></mxCell><mxCell id="ch3c75" value="not used" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1340" y="1030" width="230" height="70" as="geometry"/></mxCell><mxCell id="ch3c76" value="&lt;b&gt;MJ to MS&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="110" height="50" as="geometry"/></mxCell><mxCell id="ch3c77" value="Total Organisation, Changement, Rupture, Qualité, Dysfonctionnement, Panne, Réglage, Maintenance Planifiée, Temps Fermeture, Volume" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="150" y="1100" width="430" height="50" as="geometry"/></mxCell><mxCell id="ch3c78" value="Totals per block, closed time, total volume" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="1100" width="430" height="50" as="geometry"/></mxCell><mxCell id="ch3c79" value="Formulas (SUM of the block). Good for checks, not needed as input" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1010" y="1100" width="330" height="50" as="geometry"/></mxCell><mxCell id="ch3c80" value="check only" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1340" y="1100" width="230" height="50" as="geometry"/></mxCell><mxCell id="ch3c81" value="&lt;b&gt;MT to NG&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="1150" width="110" height="70" as="geometry"/></mxCell><mxCell id="ch3c82" value="Vérification TO, OEE, Date, Vérification Semaine, Vérification TOR, Total Déchets, Total Temps de production, Vérification TU, Date et heure de la saisie, Vérification Libre 5 to 9" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="150" y="1150" width="430" height="70" as="geometry"/></mxCell><mxCell id="ch3c83" value="Check TO, OEE, Date, Week check, TOR check, Total waste, Total production time, TU check, Entry date and time, spare checks" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="1150" width="430" height="70" as="geometry"/></mxCell><mxCell id="ch3c84" value="OEE is a stored value (macro), not a formula. Vérification TO = TU + NR + 8 loss totals and must equal TOR" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1010" y="1150" width="330" height="70" as="geometry"/></mxCell><mxCell id="ch3c85" value="check, and OEE for the test" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1340" y="1150" width="230" height="70" as="geometry"/></mxCell><mxCell id="ch3c86" value="&lt;b&gt;NH to NS&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="1220" width="110" height="50" as="geometry"/></mxCell><mxCell id="ch3c87" value="Sécurité Nombre d'actions ouvertes, Nombre d'actions cloturées, Nombre de &quot;NON&quot; total de la journée, Sécurité Libre 1 to 9" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="150" y="1220" width="430" height="50" as="geometry"/></mxCell><mxCell id="ch3c88" value="Safety: number of open actions, closed actions, number of &quot;NO&quot; answers of the day" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="1220" width="430" height="50" as="geometry"/></mxCell><mxCell id="ch3c89" value="Safety check of the shift. No target table has it" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1010" y="1220" width="330" height="50" as="geometry"/></mxCell><mxCell id="ch3c90" value="not used" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1340" y="1220" width="230" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4 Differences per line" id="chartres4"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ch4c2" value="&lt;b&gt;Base columns: what differs between lines and years&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;Same skeleton in all 36 files (blocks and formulas of page 3). Differences are in the names of the three machine blocks and in a few extra columns. The machine part list is the same in the Dysf, Panne and Réglages blocks of a line, so it is shown once.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="60" as="geometry"/></mxCell><mxCell id="ch4c3" value="&lt;b&gt;FROM BASE, CHECKED ON THE FILES&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="230" height="30" as="geometry"/></mxCell><mxCell id="ch4c4" value="&lt;b&gt;WATCH / DIFFERENCE&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1"><mxGeometry x="280" y="90" width="230" height="30" as="geometry"/></mxCell><mxCell id="ch4c5" value="&lt;b&gt;NO SOURCE IN THE CHARTRES FILES&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="230" height="30" as="geometry"/></mxCell><mxCell id="ch4c6" value="&lt;b&gt;Difference&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="250" height="40" as="geometry"/></mxCell><mxCell id="ch4c7" value="&lt;b&gt;Which files&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="290" y="140" width="560" height="40" as="geometry"/></mxCell><mxCell id="ch4c8" value="&lt;b&gt;What it means for the mapping&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="850" y="140" width="700" height="40" as="geometry"/></mxCell><mxCell id="ch4c9" value="&lt;b&gt;Machine part names&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="250" height="50" as="geometry"/></mxCell><mxCell id="ch4c10" value="Every line has its own list: 9 to 24 named parts out of 32 slots, the rest are &quot;Libre&quot; (spare)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="290" y="180" width="560" height="50" as="geometry"/></mxCell><mxCell id="ch4c11" value="The loss description (Level 3) comes from the Category sheet, so a new part needs no code change. Without a Category sheet (all 2025 files, CUPIDON and DAISY 2026) a French to English dictionary is needed" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="850" y="180" width="700" height="50" as="geometry"/></mxCell><mxCell id="ch4c12" value="&lt;b&gt;Fewer columns: 353&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="250" height="40" as="geometry"/></mxCell><mxCell id="ch4c13" value="IWKA 3, 2025 and 2026 (22 slots per block instead of 32)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="290" y="230" width="560" height="40" as="geometry"/></mxCell><mxCell id="ch4c14" value="Read the block by header name, never by column letter" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="850" y="230" width="700" height="40" as="geometry"/></mxCell><mxCell id="ch4c15" value="&lt;b&gt;More columns: 404&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="250" height="70" as="geometry"/></mxCell><mxCell id="ch4c16" value="NON TISSE HOME 1 to 4 and SACHA 1 and 2, 2025 and 2026: &quot;People ZAC&quot; and &quot;People Ext ZAC&quot; (12), &quot;Déchets &amp;lt;machine&gt; &amp;lt;shift&gt;&quot; (15 in HOME: SIEREM - NORDSON, CAM, CERMEX; 5 in SACHA) and &quot;Déchets Libre 1 to 6&quot;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="290" y="270" width="560" height="70" as="geometry"/></mxCell><mxCell id="ch4c17" value="Total Déchets of these files sums the per-machine waste columns, not the product waste cells. Decide which waste to use before Good Parts" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="850" y="270" width="700" height="70" as="geometry"/></mxCell><mxCell id="ch4c18" value="&lt;b&gt;People ZAC (12)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="250" height="50" as="geometry"/></mxCell><mxCell id="ch4c19" value="All SKIN CARE files and NON TISSE HOME / SACHA. CREAM and SUGAR have only the 12 generic People columns" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="290" y="340" width="560" height="50" as="geometry"/></mxCell><mxCell id="ch4c20" value="Not used in the three tables" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="850" y="340" width="700" height="50" as="geometry"/></mxCell><mxCell id="ch4c21" value="&lt;b&gt;&amp;quot;Réglage&amp;quot; (singular)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="250" height="50" as="geometry"/></mxCell><mxCell id="ch4c22" value="APOLLON and CLÉOPATRE: the first 18 adjustment slots are &quot;Réglage &amp;lt;part&gt;&quot;; the others &quot;Réglages &amp;lt;part&gt;&quot;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="290" y="390" width="560" height="50" as="geometry"/></mxCell><mxCell id="ch4c23" value="Match the prefix with a pattern, not an exact word" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="850" y="390" width="700" height="50" as="geometry"/></mxCell><mxCell id="ch4c24" value="&lt;b&gt;Category sheet&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="250" height="50" as="geometry"/></mxCell><mxCell id="ch4c25" value="Only in the 2026 files of 16 lines (all except CUPIDON and DAISY); not in any 2025 file" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="290" y="440" width="560" height="50" as="geometry"/></mxCell><mxCell id="ch4c26" value="For the others the same French name usually exists in another file of the group: build one dictionary from all Category sheets and check the gaps" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="850" y="440" width="700" height="50" as="geometry"/></mxCell><mxCell id="ch4c27" value="&lt;b&gt;Empty or short files&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="250" height="50" as="geometry"/></mxCell><mxCell id="ch4c28" value="CUPIDON 2026 and DAISY 2026 hold no day. CUPIDON 2025 ends 2025-09-22, DAISY 2025 ends 2025-11-06, CLÉOPATRE has the fewest days" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="290" y="490" width="560" height="50" as="geometry"/></mxCell><mxCell id="ch4c29" value="Nothing to load for the two empty files" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="850" y="490" width="700" height="50" as="geometry"/></mxCell><mxCell id="ch4c30" value="&lt;b&gt;Repeated date&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="250" height="40" as="geometry"/></mxCell><mxCell id="ch4c31" value="CUMULUS 2025 (7 days) and ZEUS 2025 (2 days) have two rows for one date" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="290" y="540" width="560" height="40" as="geometry"/></mxCell><mxCell id="ch4c32" value="Needs a rule: second entry replaces the first, or both are summed" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="850" y="540" width="700" height="40" as="geometry"/></mxCell><mxCell id="ch4c33" value="&lt;b&gt;Words in the machine part names (French to English)&lt;/b&gt;&lt;br&gt;REMPLISSEUSE = filler | ETUYEUSE = cartoner (puts tubes in cartons) | ENCAISSEUSE = case packer | SPATULEUSE = spatula dispenser | VISSEUSE = capper (screwing) | ÉTIQUETEUSE / Étiqueteuse = labeller | OPERCULEUSE = lid sealer | SLEEVEUSE = sleeving machine | SCOTCHEUSE = tape sealer | Palettiseur = palletiser | Empileur = stacker | Embarquetteuse = tray packer | Coiffeuse = cap placer | Déviateur = diverter | Formeuse Barquette = tray former | Vide fût = barrel emptier | Bac = tank | Bol = bowl feeder | Trieuse Pondérale = checkweigher | Tapis Rétractable = retractable conveyor | Convoyeur Sortie = outfeed conveyor | Vérin = cylinder&lt;br&gt;Magasin = magazine (hopper) | Orientation = orientation | Scellage = sealing | Introduction / Prise / Fermeture / Éjection = infeed / pick-up / closing / ejection | Bourrage = jam | Point de colle = glue spot | évacuation = discharge | Étuis = cartons | Caisses = cases | Étiquettes = labels | Lecteur code barres = barcode reader | Bouchons = caps | Flacons = bottles | Pots = pots | Notices = leaflets | Sachets = sachets | Autre(s) = other | Non identifié = unidentified | Libre = spare&lt;br&gt;Names such as DOMINO, METTLER, GARVENS, CERMEX, NORDSON, SIEREM, CAM, KOSME, FANUC, SERAC, BECK, SOCO, IMAJE look like equipment makers and are kept as they are." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="1510" height="130" as="geometry"/></mxCell><mxCell id="ch4c34" value="&lt;b&gt;Machine parts per line (2026 files; 2025 uses the same list). French name as typed -&amp;gt; English machine category of the sheet Category (blank = no Category sheet in the file)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1500" height="24" as="geometry"/></mxCell><mxCell id="ch4c35" value="&lt;b&gt;CREAM / CUMULUS&lt;/b&gt;: 383 columns, 12 named parts, 20 spare&lt;br&gt;BOL FLACONS -&gt; Bottle dispenser&lt;br&gt;REMPLISSEUSE -&gt; Filling machine&lt;br&gt;VISSEUSE -&gt; Screwing machine&lt;br&gt;VISSEUSE BOL POMPES -&gt; Pump dispenser&lt;br&gt;DOMINO FLACONS -&gt; Bottle dater&lt;br&gt;ÉTIQUETEUSE -&gt; Bottle labeller&lt;br&gt;SPATULEUSE -&gt; Spatula dispenser&lt;br&gt;BECK - SLEEVEUSE -&gt; Sleever&lt;br&gt;BECK - FOUR -&gt; Oven&lt;br&gt;SCOTCHEUSE -&gt; Case packer&lt;br&gt;ÉTIQUETEUSE IMAJE -&gt; Case labeller&lt;br&gt;AUTRES (Non Identifié) -&gt; Other" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="794" width="500" height="220" as="geometry"/></mxCell><mxCell id="ch4c36" value="&lt;b&gt;CREAM / CUPIDON&lt;/b&gt;: 383 columns, 9 named parts, 23 spare&lt;br&gt;ETUYEUSE BARILLET -&gt; ?&lt;br&gt;ETUYEUSE -&gt; ?&lt;br&gt;ETUYEUSE - VERIN SORTIE -&gt; ?&lt;br&gt;DOMINO ÉTUIS -&gt; Skillet dater (from another line)&lt;br&gt;BALANCE SARTORIUS -&gt; ?&lt;br&gt;EMPILEUR FOUR BFB -&gt; ?&lt;br&gt;SCOTCHEUSE SOCO -&gt; ?&lt;br&gt;DOMINO - ÉTIQUETTES CAISSES -&gt; Case labeller (from another line)&lt;br&gt;AUTRES (Non Identifié) -&gt; Other (from another line)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="550" y="794" width="500" height="170" as="geometry"/></mxCell><mxCell id="ch4c37" value="&lt;b&gt;CREAM / DAISY&lt;/b&gt;: 383 columns, 15 named parts, 17 spare&lt;br&gt;TGM -&gt; ?&lt;br&gt;DOMINO TUBES -&gt; Tube dater (from another line)&lt;br&gt;METTLER TRIEUSE -&gt; ?&lt;br&gt;CIM ROBOT TUBES -&gt; ?&lt;br&gt;MÉCA PLASTIQUE -&gt; ?&lt;br&gt;APEX -&gt; ?&lt;br&gt;DOMINO BLISTER -&gt; ?&lt;br&gt;CERMEX -&gt; ?&lt;br&gt;VIMCO -&gt; ?&lt;br&gt;DOMINO - Étiquettes Caisses -&gt; Case labeller (from another line)&lt;br&gt;Palettiseur NEWTEC -&gt; ?&lt;br&gt;CAMÉRA ISI VISION -&gt; ?&lt;br&gt;BOL ÉPONGES -&gt; ?&lt;br&gt;ROBOT Dépose Éponges -&gt; ?&lt;br&gt;AUTRES (Non Identifié) -&gt; Other (from another line)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1060" y="794" width="500" height="260" as="geometry"/></mxCell><mxCell id="ch4c38" value="&lt;b&gt;CREAM / IWKA 1&lt;/b&gt;: 383 columns, 19 named parts, 13 spare&lt;br&gt;TZ -&gt; Tube dispenser&lt;br&gt;REMPLISSEUSE (Débordement Crème / Niveau cuve) -&gt; Filling machine&lt;br&gt;REMPLISSEUSE (Orientation Tubes) -&gt; Filling machine&lt;br&gt;REMPLISSEUSE (Scellage Tubes) -&gt; Filling machine&lt;br&gt;REMPLISSEUSE (Bouchon Coincés Dans Les Godets) -&gt; Filling machine&lt;br&gt;REMPLISSEUSE - Autre -&gt; Filling machine&lt;br&gt;DOMINO Tubes -&gt; Tube dater&lt;br&gt;DISTRIBUTEUR Spatules -&gt; Spatula dispenser&lt;br&gt;ETUYEUSE (Transfert Tubes) -&gt; Skiletting machine&lt;br&gt;ETUYEUSE (Dépose Étuis) -&gt; Skiletting machine&lt;br&gt;ETUYEUSE (Introduction Tubes / Spatules) -&gt; Skiletting machine&lt;br&gt;ETUYEUSE (Fermeture Étuis) -&gt; Skiletting machine&lt;br&gt;DOMINO Étuis -&gt; Skillet dater&lt;br&gt;GARVENS - Trieuse Pondérale -&gt; Weigher&lt;br&gt;CAMÉRA -&gt; Camera&lt;br&gt;ENCAISSEUSE Cermex -&gt; Case packer&lt;br&gt;DOMINO Étiquette Caisse -&gt; Case labeller&lt;br&gt;Palettiseur NEW TEC -&gt; Paletizer&lt;br&gt;Autre -&gt; Other" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1064" width="500" height="320" as="geometry"/></mxCell><mxCell id="ch4c39" value="&lt;b&gt;CREAM / IWKA 2&lt;/b&gt;: 383 columns, 24 named parts, 8 spare&lt;br&gt;REMPLISSEUSE - Magasin Tubes -&gt; Filling machine&lt;br&gt;REMPLISSEUSE - Orientation Tubes -&gt; Filling machine&lt;br&gt;REMPLISSEUSE - Domino Tubes -&gt; Filling machine&lt;br&gt;REMPLISSEUSE - Scellage Tubes -&gt; Filling machine&lt;br&gt;REMPLISSEUSE - Autre -&gt; Filling machine&lt;br&gt;SPATULEUSE - Magasin spatules -&gt; Spatula dispenser&lt;br&gt;SPATULEUSE - Clapet -&gt; Spatula dispenser&lt;br&gt;SPATULEUSE - Dépose spatule -&gt; Spatula dispenser&lt;br&gt;ETUYEUSE - Introduction Tubes -&gt; Skilleting machine&lt;br&gt;ETUYEUSE - Prise Étuis -&gt; Skilleting machine&lt;br&gt;ETUYEUSE - Fermeture Étuis -&gt; Skilleting machine&lt;br&gt;ETUYEUSE - Ejection Tubes -&gt; Skilleting machine&lt;br&gt;ETUYEUSE - Autres -&gt; Skilleting machine&lt;br&gt;DOMINO Étuis -&gt; Skillet dater&lt;br&gt;METTLER- Trieuse Pondérale -&gt; Weigher&lt;br&gt;Tapis Rétractable -&gt; Conveyor&lt;br&gt;ENCAISSEUSE - Prise étuis -&gt; Case packer&lt;br&gt;ENCAISSEUSE - Bourrage étuis -&gt; Case packer&lt;br&gt;ENCAISSEUSE - Point de colle caisses -&gt; Case packer&lt;br&gt;ENCAISSEUSE - évacuation caisses -&gt; Case packer&lt;br&gt;ENCAISSEUSE - Autres -&gt; Case packer&lt;br&gt;DOMINO - Étiquettes Caisses -&gt; Case labeller&lt;br&gt;DOMINO - Lecteur code barres -&gt; Case labeller&lt;br&gt;Autre -&gt; Other" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="550" y="1064" width="500" height="400" as="geometry"/></mxCell><mxCell id="ch4c40" value="&lt;b&gt;CREAM / IWKA 3&lt;/b&gt;: 353 columns, 19 named parts, 13 spare&lt;br&gt;TZ -&gt; Tube dispenser&lt;br&gt;REMPLISSEUSE (Débordement Crème / Niveau cuve) -&gt; Filling machine&lt;br&gt;REMPLISSEUSE (Orientation Tubes) -&gt; Filling machine&lt;br&gt;REMPLISSEUSE (Scellage Tubes) -&gt; Filling machine&lt;br&gt;REMPLISSEUSE (Bouchon Coincés Dans Les Godets) -&gt; Filling machine&lt;br&gt;REMPL