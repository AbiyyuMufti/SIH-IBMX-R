up" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="480" y="610" width="480" height="40" as="geometry"/></mxCell><mxCell id="ch6c55" value="no source" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="960" y="610" width="140" height="40" as="geometry"/></mxCell><mxCell id="ch6c56" value="Chartres lines not in Machine Names yet" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1100" y="610" width="450" height="40" as="geometry"/></mxCell><mxCell id="ch6c57" value="&lt;b&gt;Data Source&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="190" height="40" as="geometry"/></mxCell><mxCell id="ch6c58" value="-" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="230" y="650" width="250" height="40" as="geometry"/></mxCell><mxCell id="ch6c59" value="new value" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="480" y="650" width="480" height="40" as="geometry"/></mxCell><mxCell id="ch6c60" value="to confirm" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="960" y="650" width="140" height="40" as="geometry"/></mxCell><mxCell id="ch6c61" value="" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1100" y="650" width="450" height="40" as="geometry"/></mxCell><mxCell id="ch6c62" value="&lt;b&gt;Check built into the workbook: &lt;/b&gt;Vérification TO = TU + NR + the eight loss totals and equals TOR on every day shown (IWKA 2: 161 + 739 = 900). So the day is always fully accounted for, and the losses of Daily_Losses_EU add up to TOR - TU." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="1510" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="7 Base to Daily_Losses_EU" id="chartres7"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ch7c2" value="&lt;b&gt;Base -&amp;gt; Daily_Losses_EU (one row per day and loss column with minutes)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;Grain: every loss column of Base with a value above 0 becomes a row (IWKA 2 on 23 Oct: 17 rows, 739 minutes). Group / sub group / description come from the sheet Category (French name -&amp;gt; Level 1, 2, 3 in English), not from the macro export.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="60" as="geometry"/></mxCell><mxCell id="ch7c3" value="&lt;b&gt;FROM BASE, CHECKED ON THE FILES&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeCol