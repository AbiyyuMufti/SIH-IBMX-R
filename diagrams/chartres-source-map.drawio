 parent="1"><mxGeometry x="690" y="940" width="160" height="50" as="geometry"/></mxCell><mxCell id="ch2c130" value="yes" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="850" y="940" width="270" height="50" as="geometry"/></mxCell><mxCell id="ch2c131" value="yes" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1120" y="940" width="260" height="50" as="geometry"/></mxCell><mxCell id="ch2c132" value="SKIN CARE" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="110" height="70" as="geometry"/></mxCell><mxCell id="ch2c133" value="&lt;b&gt;ZEUS&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="150" y="990" width="100" height="70" as="geometry"/></mxCell><mxCell id="ch2c134" value="yes (13 of 18 have them)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="250" y="990" width="190" height="70" as="geometry"/></mxCell><mxCell id="ch2c135" value="2026-01-30, 8 product rows, 99 loss rows" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="440" y="990" width="250" height="70" as="geometry"/></mxCell><mxCell id="ch2c136" value="close event yes, but Module_PlanOPT is EMPTY: the call fails" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="690" y="990" width="160" height="70" as="geometry"/></mxCell><mxCell id="ch2c137" value="yes" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="850" y="990" width="270" height="70" as="geometry"/></mxCell><mxCell id="ch2c138" value="yes" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1120" y="990" width="260" height="70" as="geometry"/></mxCell><mxCell id="ch2c139" value="CUPIDON, DAISY: no export macros (CUPIDON has an empty Module1). SACHA 1, SACHA 2, SUGAR: Module1 holds Load_LineLosses and Load_PlanOPT, which fill a whole MONTH with formulas (month typed in sheet cell AB1 / AI1); the sheets they need are not in our copies. The January files were probably made this way (inferred). CLÉOPATRE: Module_PlanOPT writes MachineName &quot;APOLLON&quot; (copy mistake), Module_LineLosses writes &quot;CLEOPATRE&quot; without the accent." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="1070" width="1340" height="70" as="geometry"/></mxCell><mxCell id="ch2c140" value="&lt;b&gt;Coverage in time (whatever the macros wrote)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1170" width="1500" height="24" as="geometry"/></mxCell><mxCell id="ch2c141" value="2025: no macro output at all. Build from Base (about 5 Jan to 23 Dec 2025 for most lines)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="1200" width="360" height="60" as="geometry"/></mxCell><mxCell id="ch2c142" value="Jan 2026: ONE monthly file per line (5 to 30 Jan), 13 lines" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="400" y="1200" width="300" height="60" as="geometry"/></mxCell><mxCell id="ch2c143" value="Feb to Jul 2026: no macro output. Build from Base" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="700" y="1200" width="360" height="60" as="geometry"/></mxCell><mxCell id="ch2c144" value="Aug 1/3 to Oct 23, 2026 (SKIN CARE to Oct 6): daily files for 12 of the 18 lines, only for days the workbook was closed" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1060" y="1200" width="480" height="60" as="geometry"/></mxCell><mxCell id="ch2c145" value="&lt;b&gt;What the two macros do, and where they differ from the workbook rules (code read, then checked on the 10 files that hold a day)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1290" width="1500" height="24" as="geometry"/></mxCell><mxCell id="ch2c146" value="PlanOPT: for the chosen day it makes 21 rows per Base row of that date (20 product slots + 1 spare). Batch ID = Code, Total Time = Temps, Good Parts = Volume, Speed = looked up in the sheet Data by the code, Target = Capacity = Speed x Time, OEE = Good Parts / Capacity, Downtime Units = Capacity - Good Parts, TOR = the first Base column whose name contains &quot;TOR&quot; from column H, which is &quot;Vérification TOR&quot; (= TOP). Equal on every row of the 10 files." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="1320" width="1500" height="50" as="geometry"/></mxCell><mxCell id="ch2c147" value="PlanOPT reads Déchets (waste) but never writes it (Defect Parts empty), and never writes Planned OpT or OEE Time. Good Parts is the declared Volume, while the workbook OEE (sheet OEE) uses Volume - Déchets. ShiftName is the number 1 to 5, ShiftStartTime is the date only." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="1376" width="1500" height="50" as="geometry"/></mxCell><mxCell id="ch2c148" value="PlanOPT PartName = the value of ONE column of the sheet Data, chosen per file: column D in IWKA 2 (a formula code, not a name), B (the format) in CUMULUS, IWKA 1 and 3 and OLYMPE, M in HOME. AreaName and MachineName are typed in the code of each file. The export keeps only rows with a PartName." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="1432" width="1500" height="50" as="geometry"/></mxCell><mxCell id="ch2c149" value="LineLosses: ROOT CAUSE of the wrong groups. For each Category row it looks up Level 1 and Level 2 in the FIRST Category row with the same Level 3 English text, not in its own row. &quot;Filling machine&quot; or &quot;Other&quot; exist under Dysf, Panne, Réglages and Organisation, so every Panne and Réglages line gets Dysf's &quot;Minor stop&quot;, and every &quot;Autre&quot; line gets Organisation's Planned losses / Cleaning. 19 to 49 rows per file are wrong. The duration itself (looked up by the French name) is right." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="1488" width="1500" height="50" as="geometry"/></mxCell><mxCell id="ch2c150" value="LineLosses writes ALL Category rows for the day, with a blank duration when there is none (about 60 to 105 rows), and the export keeps every row with a description. Durations add up to the eight loss totals of Base in 6 of 10 files; the other 4 differ by 20 to 70 minutes (probably the not-counted time)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="1544" width="1500" height="50" as="geometry"/></mxCell><mxCell id="ch2c151" value="Export on close: ThisWorkbook.Workbook_BeforeClose runs Run_Reports (LineLosses, then PlanOPT) and Export_All_CSVs, which saves &amp;lt;workbook&gt;_&amp;lt;yyyymmdd&gt;_line_losses.xlsx and _plan_opt.xlsx next to the workbook. The date is the one in the first row; a second close on the same day overwrites the file." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="1600" width="1500" height="50" as="geometry"/></mxCell><mxCell id="ch2c152" value="&lt;b&gt;Recommendation: &lt;/b&gt;build every day from Base with the Category sheet, using its own row for Level 1, 2 and 3 (one rule for 2025 and 2026 and for every line), and use the daily export files of Aug to Oct 2026 and the January file only as a test: our rows for the same line and day must equal the macro rows, except where the macro is wrong (above). We do not run the macros." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="1666" width="1500" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2b How it works (VBA)" id="chartres20"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ch20c2" value="&lt;b&gt;How one OEE workbook works (read from the VBA, nothing was run)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;Entry form BSAISIE (3,300 to 3,650 lines of code) writes the sheet Base. The macros at close write PlanOPT and LineLosses and export them. Our plan reuses the same rules on Base.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="60" as="geometry"/></mxCell><mxCell id="ch20c3" value="&lt;b&gt;FROM BASE, CHECKED ON THE FILES&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="230" height="30" as="geometry"/></mxCell><mxCell id="ch20c4" value="&lt;b&gt;FIXED VALUE OR LOOKUP (CONFIG)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1"><mxGeometry x="280" y="90" width="230" height="30" as="geometry"/></mxCell><mxCell id="ch20c5" value="&lt;b&gt;WATCH / DIFFERENCE&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="230" height="30" as="geometry"/></mxCell><mxCell id="ch20c6" value="&lt;b&gt;NO SOURCE IN THE CHARTRES FILES&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="1"><mxGeometry x="760" y="90" width="230" height="30" as="geometry"/></mxCell><mxCell id="ch20c7" value="&lt;b&gt;A. Entering a day (sub Lance_Saisie opens the form BSAISIE)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="1500" height="24" as="geometry"/></mxCell><mxCell id="ch20c8" value="&lt;b&gt;1. The operator types the day&lt;/b&gt;&lt;br&gt;Date, week, safety (Secu1 to 3), TOP (Temp0), TU (Temp2), NR (TempsNR1), not-counted minutes (Temp15 to 18), losses by cause (Orga, Change, Rupt, Qual, Dysf, Panne, Reg, Maint: 24 named slots for each machine block), labour (MOD1 to 6), and per shift up to 4 products: code, time, volume, waste." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="300" height="140" as="geometry"/></mxCell><mxCell id="ch20c9" value="&lt;b&gt;2. The form fills in the rest&lt;/b&gt;&lt;br&gt;TOR (Temp1) = TOP - the four not-counted items. For each product code a VLOOKUP in the sheet Data gives name, formula, format, case and speed. The losses total (Pertes) must equal TOR - TU: the box turns green when the difference is 0." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="390" y="170" width="300" height="130" as="geometry"/></mxCell><mxCell id="ch20c10" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="ch20c8" target="ch20c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ch20c11" value="&lt;b&gt;3. Valider writes the day&lt;/b&gt;&lt;br&gt;It inserts a NEW ROW 3 in Base (newest on top), writes the typed values, the 14 total / check formulas, the OEE copied from the sheet OEE (C33), the date, the ISO week and the saving time." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="740" y="170" width="300" height="110" as="geometry"/></mxCell><mxCell id="ch20c12" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="ch20c9" target="ch20c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ch20c13" value="&lt;b&gt;4. Checks, else the row is deleted&lt;/b&gt;&lt;br&gt;(1) TU + NR + 8 loss totals = TOR; (2) week = ISO week of the date; (3) TOR + not counted = TOP; (4) sum of Temps of the products = TOR; (5) every code found in Data (&quot;Non trouvé&quot; refuses); (6) TU = Round(OEE x TOR). Then the Vérification form: Cancel deletes the row." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1090" y="170" width="300" height="130" as="geometry"/></mxCell><mxCell id="ch20c14" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="ch20c11" target="ch20c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ch20c15" value="&lt;b&gt;How well the rows pass today (all 7,181 day rows of the 36 files)&lt;/b&gt;&lt;br&gt;(3) TOR = TOP - not counted: fails on 5 rows | (1) TU + NR + losses = TOR: 81 rows | (4) sum of Temps = TOR: 269 rows | (6) TU = Round(OEE x TOR): 804 rows, mostly 2025. In the 2026 files of the 13 macro lines the failures are a few rows per file. Rows that fail were probably edited after saving, or saved by an older version of the form (the form code differs in every file: 36 versions)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="1340" height="70" as="geometry"/></mxCell><mxCell id="ch20c16" value="&lt;b&gt;B. Closing the workbook (ThisWorkbook.Workbook_BeforeClose, in 11 of the 13 macro files)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="1500" height="24" as="geometry"/></mxCell><mxCell id="ch20c17" value="&lt;b&gt;1. Day chosen&lt;/b&gt;&lt;br&gt;Sheet &quot;OEE global report&quot;, cell F10 (F9 shows TODAY()). Only that one day is processed." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="300" height="110" as="geometry"/></mxCell><mxCell id="ch20c18" value="&lt;b&gt;2. Run_Reports&lt;/b&gt;&lt;br&gt;LineLosses: one row per Category line, duration from Base by French name. PlanOPT: 21 rows per product slot template, values from Base and from Data. Details on page 2." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="390" y="490" width="300" height="110" as="geometry"/></mxCell><mxCell id="ch20c19" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="ch20c17" target="ch20c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ch20c20" value="&lt;b&gt;3. Export_All_CSVs&lt;/b&gt;&lt;br&gt;Copies the rows with a value in the filter column (LineLosses: description; PlanOPT: PartName) to a new sheet, saves it as xlsx in the folders LineLosses and PlanOPT, named &amp;lt;workbook&gt;_&amp;lt;yyyymmdd&gt;_..., closes it." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="740" y="490" width="300" height="110" as="geometry"/></mxCell><mxCell id="ch20c21" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="ch20c18" target="ch20c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ch20c22" value="&lt;b&gt;4. Result&lt;/b&gt;&lt;br&gt;One pair of files per closing day, per workbook. Days the workbook was not closed with that date in F10 have no file. 2025: nothing." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1090" y="490" width="300" height="110" as="geometry"/></mxCell><mxCell id="ch20c23" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="ch20c20" target="ch20c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ch20c24" value="&lt;b&gt;What we reuse for the rebuild from Base&lt;/b&gt;&lt;br&gt;The six checks above as our own validation of each day (flag the days that fail, do not drop them silently); the Data lookup (code -&gt; name, speed); the sheet Category with its own Level 1/2/3 per French name; the OEE definition: sum of (Volume - Déchets) / sum of (Speed x Time); TOR and TU as defined by the form. Not reused: the macro mapping of Level 1/2, the PartName column choice, Good Parts without waste." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="1340" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 Base columns" id="chartres3"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ch3c2" value="&lt;b&gt;Sheet &amp;quot;Base&amp;quot;: the important columns (French, English, abbreviations)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;One row = one day of one line, newest day on top. Letters are those of the CREAM template (IWKA 2); other lines shift after the machine blocks (page 4). English = the translation or the wording of the sheet &amp;quot;Category&amp;quot; of the same workbook. Meanings of TOP, TOR, TU are now from the entry form code. Of the 383 columns, 323 are written by the form and 60 are spare &amp;quot;Libre&amp;quot; columns it never writes.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="60" as="geometry"/></mxCell><mxCell id="ch3c3" value="&lt;b&gt;FROM BASE, CHECKED ON THE FILES&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="230" height="30" as="geometry"/></mxCell><mxCell id="ch3c4" value="&lt;b&gt;RULE TO CONFIRM&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="1"><mxGeometry x="280" y="90" width="230" height="30" as="geometry"/></mxCell><mxCell id="ch3c5" value="&lt;b&gt;WATCH / DIFFERENCE&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="230" height="30" as="geometry"/></mxCell><mxCell id="ch3c6" value="&lt;b&gt;Columns&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="110" height="40" as="geometry"/></mxCell><mxCell id="ch3c7" value="&lt;b&gt;French (as in the file)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="150" y="140" width="430" height="40" as="geometry"/></mxCell><mxCell id="ch3c8" value="&lt;b&gt;English&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="140" width="430" height="40" as="geometry"/></mxCell><mxCell id="ch3c9" value="&lt;b&gt;Abbreviation / note&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1010" y="140" width="330" height="40" as="geometry"/></mxCell><mxCell id="ch3c10" value="&lt;b&gt;Feeds&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1340" y="140" width="230" height="40" as="geometry"/></mxCell><mxCell id="ch3c11" value="&lt;b&gt;A to D&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="110" height="70" as="geometry"/></mxCell><mxCell id="ch3c12" value="ANNEE, MOIS, SEMAINE, JOUR" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="150" y="180" width="430" height="70" as="geometry"/></mxCell><mxCell id="ch3c13" value="Year, Month, Week, Day" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="180" width="430" height="70" as="geometry"/></mxCell><mxCell id="ch3c14" value="The day of the row (also column MV &quot;Date&quot;, an Excel serial number, and MW &quot;Vérification Semaine&quot; = week check)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1010" y="180" width="330" height="70" as="geometry"/></mxCell><mxCell id="ch3c15" value="Date, all 3 tables" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1340" y="180" width="230" height="70" as="geometry"/></mxCell><mxCell id="ch3c16" value="&lt;b&gt;E to H&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="110" height="160" as="geometry"/></mxCell><mxCell id="ch3c17" value="TOP, TOR, TU, NR" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="150" y="250" width="430" height="160" as="geometry"/></mxCell><mxCell id="ch3c18" value="minutes of the day: TOP, TOR, TU, NR" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="250" width="430" height="160" as="geometry"/></mxCell><mxCell id="ch3c19" value="TOP = Temps d’Ouverture Planifié (planned opening time), typed. TOR = Temps d’Ouverture Réel = TOP minus the four not-counted items (LR to LW), computed by the form. TU = Temps Utile (useful time), typed, and the form refuses the day unless TU = Round(OEE x TOR). NR = typed, counted with the losses (name not spelled out in the code, probably Non Renseigné). Rule enforced: TU + NR + the eight loss totals = TOR" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1010" y="250" width="330" height="160" as="geometry"/></mxCell><mxCell id="ch3c20" value="Time_Utilisation_EU, Plan_OPT_EU" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1340" y="250" width="230" height="160" as="geometry"/></mxCell><mxCell id="ch3c21" value="&lt;b&gt;I to Q&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="110" height="70" as="geometry"/></mxCell><mxCell id="ch3c22" value="Démarrage Ligne, Arrêt Ligne, Pauses, Nettoyage, Désinfection, Perte Cadence, Organisation Autre, Orga Libre 1, 2" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="150" y="410" width="430" height="70" as="geometry"/></mxCell><mxCell id="ch3c23" value="Line start-up, Line shut-down, Breaks, Cleaning, Sanitization, Reduced speed, Other, spare 1, 2" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="410" width="430" height="70" as="geometry"/></mxCell><mxCell id="ch3c24" value="Minutes. Group &quot;Organisation&quot;. Planned losses, except Perte Cadence (unplanned). &quot;Libre&quot; = free, spare slot a line can name" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1010" y="410" width="330" height="70" as="geometry"/></mxCell><mxCell id="ch3c25" value="Daily_Losses_EU" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1340" y="410" width="230" height="70" as="geometry"/></mxCell><mxCell id="ch3c26" value="&lt;b&gt;R to AD&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="110" height="80" as="geometry"/></mxCell><mxCell id="ch3c27" value="Changement de Format, Changement de Formule, Changement Composant / Lot / OF, Changement de consommable, Changement Libre 1 to 6; Nbre de changement ..." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="150" y="480" width="430" height="80" as="geometry"/></mxCell><mxCell id="ch3c28" value="Format changeover, Formula change, Component / batch / work order change, Consumable refill, spare 1 to 6; Number of changes" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="480" width="430" height="80" as="geometry"/></mxCell><mxCell id="ch3c29" value="Minutes, except the three &quot;Nbre ...&quot; columns (S, U, W) which are COUNTS and are not in Total Changement (R + T + V + X). OF = Ordre de Fabrication = work order. Planned losses" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1010" y="480" width="330" height="80" as="geometry"/></mxCell><mxCell id="ch3c30" value="Daily_Losses_EU (not the counts)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1340" y="480" width="230" height="80" as="geometry"/></mxCell><mxCell id="ch3c31" value="&lt;b&gt;AE to AM&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="110" height="70" as="geometry"/></mxCell><mxCell id="ch3c32" value="Rupture Formule, Composants, Personnel, Utilité, Technicien; Manque Documentation; Évacuation - Alarme Incendie; Rupture OF / Planning; Rupture Libre 2" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="150" y="560" width="430" height="70" as="geometry"/></mxCell><mxCell id="ch3c33" value="Lack of formula, materials, crew, utilities, technician; lack of documents; fire alarm; lack of work order / planning" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="560" width="430" height="70" as="geometry"/></mxCell><mxCell id="ch3c34" value="Minutes. Unplanned losses, group &quot;Lack of resources&quot;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1010" y="560" width="330" height="70" as="geometry"/></mxCell><mxCell id="ch3c35" value="Daily_Losses_EU" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1340" y="560" width="230" height="70" as="geometry"/></mxCell><mxCell id="ch3c36" value="&lt;b&gt;AN to AT&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="110" height="50" as="geometry"/></mxCell><mxCell id="ch3c37" value="Qualité Composants, Qualité Formule, Erreur / Retraitement / Recontrôle, Réglages Camera, Qualité Libre 1 to 3" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="150" y="630" width="430" height="50" as="geometry"/></mxCell><mxCell id="ch3c38" value="Quality issue: materials, formula, rework, camera adjustments, spare" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="630" width="430" height="5