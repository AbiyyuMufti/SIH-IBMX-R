="empty plan folders" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="850" y="1056" width="300" height="50" as="geometry"/></mxCell><mxCell id="ch1c87" value="DI, OT, L3 Board, RPS targets, glidepath reviews, Suivi IWKA 2" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1150" y="1056" width="300" height="50" as="geometry"/></mxCell><mxCell id="ch1c88" value="Not profiled (outside the pattern): the year-level &quot;DOR &amp;lt;group&gt; ... .xlsm&quot; files. They may be the group roll-up of the lines. The 2024 entry was most likely in those DOR files (dated backups), so 2024 has no OEE &amp;lt;line&gt;.xlsm at all." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="1126" width="1500" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 Macros and 2026" id="chartres2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ch2c2" value="&lt;b&gt;Does the PlanOPT / LineLosses conversion cover all of 2026? No.&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;18 OEE workbooks for 2026. The macros (Module_PlanOPT, Module_LineLosses) exist in 13 and run when someone CLOSES the workbook, for ONE day: the date in the sheet &amp;quot;OEE global report&amp;quot;, cell F10. So the sheets keep only the last day and an export file exists only for a day on which the workbook was closed with that date. You prefer Base directly: this page shows what the macros give and where they go wrong (read from the VBA, not run).&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="60" as="geometry"/></mxCell><mxCell id="ch2c3" value="&lt;b&gt;FROM BASE, CHECKED ON THE FILES&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="230" height="30" as="geometry"/></mxCell><mxCell id="ch2c4" value="&lt;b&gt;WATCH / DIFFERENCE&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1"><mxGeometry x="280" y="90" width="230" height="30" as="geometry"/></mxCell><mxCell id="ch2c5" value="&lt;b&gt;NO SOURCE IN THE CHARTRES FILES&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="230" height="30" as="geometry"/></mxCell><mxCell id="ch2c6" value="&lt;b&gt;Group&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="110" height="50" as="geometry"/></mxCell><mxCell id="ch2c7" value="&lt;b&gt;Line&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="150" y="140" width="100" height="50" as="geometry"/></mxCell><mxCell id="ch2c8" value="&lt;b&gt;Macros + PlanOPT / LineLosses sheets&lt;/b&gt;" style="rounded=0;whiteSpace=wrap