</mxCell><mxCell id="ch6c7" value="&lt;b&gt;Base row of the day&lt;/b&gt;&lt;br&gt;TOP, TOR, TU, NR (E to H)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="330" height="90" as="geometry"/></mxCell><mxCell id="ch6c8" value="&lt;b&gt;Step 1: one row per day&lt;/b&gt;&lt;br&gt;no unpivot, the columns are read as they are" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="430" y="140" width="330" height="90" as="geometry"/></mxCell><mxCell id="ch6c9" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="ch6c7" target="ch6c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ch6c10" value="&lt;b&gt;Time_Utilisation_EU row&lt;/b&gt;&lt;br&gt;one per line and day" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="820" y="140" width="330" height="90" as="geometry"/></mxCell><mxCell id="ch6c11" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="ch6c8" target="ch6c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ch6c12" value="&lt;b&gt;Target column&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="190" height="40" as="geometry"/></mxCell><mxCell id="ch6c13" value="&lt;b&gt;Example (IWKA 2, 23 Oct 2026)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=