xCell id="ch5c51" value="macro: Target = Capacity; the macro takes the speed from Data, the form copies the same speed into Base (Vitesse)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1100" y="600" width="450" height="50" as="geometry"/></mxCell><mxCell id="ch5c52" value="&lt;b&gt;Total Time&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="190" height="40" as="geometry"/></mxCell><mxCell id="ch5c53" value="90" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="230" y="650" width="250" height="40" as="geometry"/></mxCell><mxCell id="ch5c54" value="Temps PF1 Semaine Matin (minutes run)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="480" y="650" width="480" height="40" as="geometry"/></mxCell><mxCell id="ch5c55" value="checked" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="960" y="650" width="140" height="40" as="geometry"/></mxCell><mxCell id="ch5c56" value="macro rule, equal on all rows" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1100" y="650" width="450" height="40" as="geometry"/></mxCell><mxCell id="ch5c57" value="&lt;b&gt;Planned OpT&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align