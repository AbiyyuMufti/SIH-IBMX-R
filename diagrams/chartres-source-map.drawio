<mxfile host="build-drawio-chartres.js"><diagram name="1 Folders" id="chartres1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ch1c2" value="&lt;b&gt;Chartres: what is in the downloaded folders (downloads/Chartres)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;Four groups, each with 2024, 2025 and 2026. The file we need is &amp;lt;group&amp;gt;/&amp;lt;year&amp;gt;/SAISIE OEE/OEE &amp;lt;line&amp;gt; - &amp;lt;year&amp;gt;.xlsm (one workbook per production line and year). Counts are files in the folder, subfolders included. Role of a folder = read from its name and content (French names translated), to confirm with the site.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="60" as="geometry"/></mxCell><mxCell id="ch1c3" value="&lt;b&gt;FROM BASE, CHECKED ON THE FILES&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="230" height="30" as="geometry"/></mxCell><mxCell id="ch1c4" value="&lt;b&gt;FIXED VALUE OR LOOKUP (CONFIG)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1"><mxGeometry x="280" y="90" width="230" height="30" as="geometry"/></mxCell><mxCell id="ch1c5" value="&lt;b&gt;WATCH / DIFFERENCE&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="230" height="30" as="geometry"/></mxCell><mxCell id="ch1c6" value="&lt;b&gt;NOT USED (COPIES, BACKUPS)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;fontSize=9;" vertex="1" parent="1"><mxGeometry x="760" y="90" width="230" height="30" as="geometry"/></mxCell><mxCell id="ch1c7" value="&lt;b&gt;NO SOURCE IN THE CHARTRES FILES&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1000" y="90" width="230" height="30" as="geometry"/></mxCell><mxCell id="ch1c8" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;green = OEE entry workbook (our source) | blue = daily/monthly exports written by the macros (PlanOPT, LineLosses) | yellow = other workbooks, not profiled | grey = copies and backups | red = blocker&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="1500" height="20" as="geometry"/></mxCell><mxCell id="ch1c9" value="&lt;b&gt;CREAM Chartres&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="560" height="30" as="geometry"/></mxCell><mxCell id="ch1c10" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;6 lines: CUMULUS, CUPIDON, DAISY, IWKA 1, IWKA 2, IWKA 3&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="560" height="24" as="geometry"/></mxCell><mxCell id="ch1c11" value="2024/ (26 files): &quot;DOR Personal Care.xlsm&