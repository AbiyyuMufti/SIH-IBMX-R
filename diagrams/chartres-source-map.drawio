/></mxCell><mxCell id="ch6c20" value="checked" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="960" y="290" width="140" height="40" as="geometry"/></mxCell><mxCell id="ch6c21" value="" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1100" y="290" width="450" height="40" as="geometry"/></mxCell><mxCell id="ch6c22" value="&lt;b&gt;MachineName&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="190" height="40" as="geometry"/></mxCell><mxCell id="ch6c23" value="IWKA 2" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="230" y="330" width="250" height="40" as="geometry"/></mxCell><mxCell id="ch6c24" value="file name" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="480" y="330" width="480" height="40" as="geometry"/></mxCell><mxCell id="ch6c25" value="fixed / lookup" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="960" y="330" width="140" height="40" as="geometry"/></mxCell><mxCell id="ch6c26" value="" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1100" y="330" width="450" height="40" as="geometry"/></mxCell><mxCell id="ch6c27" value="&lt;b&gt;OEE Time Total&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="190" height="50" as="geometry"/></mxCell><mxCell id="ch6c28" value="161" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="230" y="370" width="250" height="50" as="geometry"/></mxCell><mxCell id="ch6c29" value="TU (Temps Utile)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="480" y="370" width="480" height="50" as="geometry"/></mxCell><mxCell id="ch6c30" value="checked" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="960" y="370" width="140" height="50" as="geometry"/></mxCell><mxCell id="ch6c31" value="typed in the form and checked: TU = Round(OEE x TOR), OEE = sum of (Volume - Déchets) / sum of (Vitesse x Temps)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1100" y="370" width="450" height="50" as="geometry"/></mxCell><mxCell id="ch6c32" value="&lt;b&gt;Total Time Total&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="190" height="70" as="geometry"/></mxCell><mxCell id="ch6c33" value="900" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="230" y="420" width="250" height="70" as="geometry"/></mxCell><mxCell id="ch6c34" value="TOR (= sum of Temps of the slots, enforced) or TOP" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="480" y="420" width="480" height="70" as="geometry"/></mxCell><mxCell id="ch6c35" value="to confirm" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="960" y="420" width="140" height="70" as="geometry"/></mxCell><mxCell id="ch6c36" value="Plan_OPT_EU Total Time adds up to TOR, so for the two tables to agree this is TOR; TOP (planned opening time) has no column unless it becomes Planned OPT or All Time. Same value in IWKA 2" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1100" y="420" width="450" height="70" as="geometry"/></mxCell><mxCell id="ch6c37" value="&lt;b&gt;Planned OPT Total&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="190" height="70" as="geometry"/></mxCell><mxCell id="ch6c38" value="900" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="230" y="490" width="250" height="70" as="geometry"/></mxCell><mxCell id="ch6c39" value="TOR or TOP" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="480" y="490" width="480" height="70" as="geometry"/></mxCell><mxCell id="ch6c40" value="to confirm" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="960" y="490" width="140" height="70" as="geometry"/></mxCell><mxCell id="ch6c41" value="order of the minutes: TU &amp;lt;= TOR &amp;lt;= TOP &amp;lt;= 1440. TOP and TOR differ when TownHall, trials, training or validation minutes exist (for example 1410 vs 1340). Needs the Reckitt definition of Planned OpT" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1100" y="490" width="450" height="70" as="geometry"/></mxCell><mxCell id="ch6c42" value="&lt;b&gt;All Time&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="190" height="40" as="geometry"/></mxCell><mxCell id="ch6c43" value="1440" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="230" y="560" width="250" height="40" as="geometry"/></mxCell><mxCell id="ch6c44" value="fixed 1440 per day" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="480" y="560" width="480" height="40" as="geometry"/></mxCell><mxCell id="ch6c45" value="fixed / lookup" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="960" y="560" width="140" height="40" as="geometry"/></mxCell><mxCell id="ch6c46" value="as in the other sites" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1100" y="560" width="450" height="40" as="geometry"/></mxCell><mxCell id="ch6c47" value="&lt;b&gt;SiteName, Unique Machine Name&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="190" height="50" as="geometry"/></mxCell><mxCell id="ch6c48" value="Chartres, IWKA 2-Chartres" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="230" y="600" width="250" height="50" as="geometry"/></mxCell><mxCell id="ch6c49" value="as Plan_OPT_EU" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="480" y="600" width="480" height="50" as="geometry"/></mxCell><mxCell id="ch6c50" value="fixed / lookup" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="960" y="600" width="140" height="50" as="geometry"/></mxCell><mxCell id="ch6c51" value="" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1100" y="600" width="450" height="50" as="geometry"/></mxCell><mxCell id="ch6c52" value="&lt;b&gt;Dept, Area, Product Type&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="190" height="40" as="geometry"/></mxCell><mxCell id="ch6c53" value="-" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="230" y="650" width="250" height="40" as="geometry"/></mxCell><mxCell id="ch6c54" value="Machine Names lookup" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="480" y="650" width="480" height="40" as="geometry"/></mxCell><mxCell id="ch6c55" value="no source" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="960" y="650" width="140" height="40" as="geometry"/></mxCell><mxCell id="ch6c56" value="Chartres lines not in Machine Names yet" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1100" y="650" width="450" height="40" as="geometry"/></mxCell><mxCell id="ch6c57" value="&lt;b&gt;Data Source&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="190" height="40" as="geometry"/></mxCell><mxCell id="ch6c58" value="-" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="230" y="690" width="250" height="40" as="geometry"/></mxCell><mxCell id="ch6c59" value="new value" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="480" y="690" width="480" height="40" as="geometry"/></mxCell><mxCell id="ch6c60" value="to confirm" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="960" y="690" width="140" height="40" as="geometry"/></mxCell><mxCell id="ch6c61" value="" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1100" y="690" width="450" height="40" as="geometry"/></mxCell><mxCell id="ch6c62" value="&lt;b&gt;Rules of the form: &lt;/b&gt;TOR = TOP - not counted; TU + NR + the eight loss totals = TOR; the sum of Temps of the slots = TOR; TU = Round(OEE x TOR). Checked on IWKA 2 for 23 Oct: 161 + 739 = 900. So the losses of Daily_Losses_EU add up to TOR - TU for every day that passes the checks (page 2b)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="1510" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="7 Base to Daily_Losses_EU" id="chartres7"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ch7c2" value="&lt;b&gt;Base -&amp;gt; Daily_Losses_EU (one row per day and loss column with minutes)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;Grain: every loss column of Base with a value above 0 becomes a row (IWKA 2 on 23 Oct: 17 rows, 739 minutes). Group / sub group / description come from the sheet Category (French name -&amp;gt; Level 1, 2, 3 in English), not from the macro export.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="60" as="geometry"/></mxCell><mxCell id="ch7c3" value="&lt;b&gt;FROM BASE, CHECKED ON THE FILES&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="230" height="30" as="geometry"/></mxCell><mxCell id="ch7c4" value="&lt;b&gt;FIXED VALUE OR LOOKUP (CONFIG)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1"><mxGeometry x="280" y="90" width="230" height="30" as="geometry"/></mxCell><mxCell id="ch7c5" value="&lt;b&gt;RULE TO CONFIRM&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="230" height="30" as="geometry"/></mxCell><mxCell id="ch7c6" value="&lt;b&gt;NO SOURCE IN THE CHARTRES FILES&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="1"><mxGeometry x="760" y="90" width="230" height="30" as="geometry"/></mxCell><mxCell id="ch7c7" value="&lt;b&gt;WATCH / DIFFERENCE&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1000" y="90" width="230" height="30" as="geometry"/></mxCell><mxCell id="ch7c8" value="&lt;b&gt;Base row of the day&lt;/b&gt;&lt;br&gt;141 loss columns (I to ES) in minutes" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="330" height="90" as="geometry"/></mxCell><mxCell id="ch7c9" value="&lt;b&gt;Step 1: unpivot&lt;/b&gt;&lt;br&gt;one row per column with minutes &gt; 0, &quot;Nbre&quot; count columns left out" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="430" y="140" width="330" height="90" as="geometry"/></mxCell><mxCell id="ch7c10" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="ch7c8" target="ch7c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ch7c11" value="&lt;b&gt;Step 2: Category lookup&lt;/b&gt;&lt;br&gt;French name -&gt; Level 1 / 2 / 3 EN" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="820" y="140" width="330" height="90" as="geometry"/></mxCell><mxCell id="ch7c12" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="ch7c9" target="ch7c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ch7c13" value="&lt;b&gt;Daily_Losses_EU row&lt;/b&gt;&lt;br&gt;per day and loss" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1210" y="140" width