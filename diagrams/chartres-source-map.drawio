gLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1100" y="590" width="450" height="40" as="geometry"/></mxCell><mxCell id="ch7c60" value="&lt;b&gt;PartName, Product Key, Batch ID&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="190" height="50" as="geometry"/></mxCell><mxCell id="ch7c61" value="-" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="230" y="630" width="250" height="50" as="geometry"/></mxCell><mxCell id="ch7c62" value="NONE: losses are not tied to a product slot" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="480" y="630" width="480" height="50" as="geometry"/></mxCell><mxCell id="ch7c63" value="no source" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="960" y="630" width="140" height="50" as="geometry"/></mxCell><mxCell id="ch7c64" value="empty, or the product with most minutes of the day (decision)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1100" y="630" width="450" height="50" as="geometry"/></mxCell><mxCell id="ch7c65" value="&lt;b&gt;Time&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="190" height="40" as="geometry"/></mxCell><mxCell id="ch7c66" value="-" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="230" y="680" width="250" height="40" as="geometry"/></mxCell><mxCell id="ch7c67" value="NONE: no start time of a stop" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="480" y="680" width="480" height="40" as="geometry"/></mxCell><mxCell id="ch7c68" value="no source" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="960" y="680" width="140" height="40" as="geometry"/></mxCell><mxCell id="ch7c69" value="the EU extract has the shift start (06:00); empty or shift start" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1100" y="680" width="450" height="40" as="geometry"/></mxCell><mxCell id="ch7c70" value="&lt;b&gt;Comment&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="190" height="40" as="geometry"/></mxCell><mxCell id="ch7c71" value="-" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="230" y="720" width="250" height="40" as="geometry"/></mxCell><mxCell id="ch7c72" value="NONE" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="480" y="720" width="480" height="40" as="geometry"/></mxCell><mxCell id="ch7c73" value="no source" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="960" y="720" width="140" height="40" as="geometry"/></mxCell><mxCell id="ch7c74" value="Base has no free text" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1100" y="720" width="450" height="40" as="geometry"/></mxCell><mxCell id="ch7c75" value="&lt;b&gt;Loss Units&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="190" height="50" as="geometry"/></mxCell><mxCell id="ch7c76" value="-" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="230" y="760" width="250" height="50" as="geometry"/></mxCell><mxCell id="ch7c77" value="Vitesse x Duration (design speed x minutes, as in the other sites)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="480" y="760" width="480" height="50" as="geometry"/></mxCell><mxCell id="ch7c78" value="to confirm" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="960" y="760" width="140" height="50" as="geometry"/></mxCell><mxCell id="ch7c79" value="needs a speed: the day has up to 20 speeds, take the product of the day with most minutes" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1100" y="760" width="450" height="50" as="geometry"/></mxCell><mxCell id="ch7c80" value="&lt;b&gt;Volume Total&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="190" height="40" as="geometry"/></mxCell><mxCell id="ch7c81" value="-" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="230" y="810" width="250" height="40" as="geometry"/></mxCell><mxCell id="ch7c82" value="sum of Capacity of the machine and day (Plan_OPT_EU)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="480" y="810" width="480" height="40" as="geometry"/></mxCell><mxCell id="ch7c83" value="to confirm" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="960" y="810" width="140" height="40" as="geometry"/></mxCell><mxCell id="ch7c84" value="built from the Plan_OPT_EU rows" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1100" y="810" width="450" height="40" as="geometry"/></mxCell><mxCell id="ch7c85" value="&lt;b&gt;Volume Key, Loss Target Key, Value&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="190" height="50" as="geometry"/></mxCell><mxCell id="ch7c86" value="-" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="230" y="850" width="250" height="50" as="geometry"/></mxCell><mxCell id="ch7c87" value="Volume Key = dd/MM/yyyy machine group sub desc; Loss Target Key = unique name + sub group + month start; Value = target of Glidepaths" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="480" y="850" width="480" height="50" as="geometry"/></mxCell><mxCell id="ch7c88" value="no source" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="960" y="850" width="140" height="50" as="geometry"/></mxCell><mxCell id="ch7c89" value="keys can be built; Value needs Chartres targets, which are not in the files" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1100" y="850" width="450" height="50" as="geometry"/></mxCell><mxCell id="ch7c90" value="&lt;b&gt;SiteName, Unique Machine Name, Dept, Area, Product Type, Data Source&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="190" height="70" as="geometry"/></mxCell><mxCell id="ch7c91" value="-" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="230" y="900" width="250" height="70" as="geometry"/></mxCell><mxCell id="ch7c92" value="as Plan_OPT_EU" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="480" y="900" width="480" height="70" as="geometry"/></mxCell><mxCell id="ch7c93" value="fixed / lookup" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="960" y="900" width="140" height="70" as="geometry"/></mxCell><mxCell id="ch7c94" value="Dept, Area, Product Type need Machine Names for Chartres" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1100" y="900" width="450" height="70" as="geometry"/></mxCell><mxCell id="ch7c95" value="&lt;b&gt;Rows that need a decision: &lt;/b&gt;NR (no accounted time) -&gt; Undefined / Unplanned losses; TownHall, Formation -&gt; &quot;Production not scheduled&quot;; Essais Planifiés, Validation -&gt; &quot;NPD/CapEX &amp; Trials&quot;. Other sites keep these groups out of the loss % or not: to check against how Hull and Nottingham treat them." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="1510" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="8 Questions" id="chartres8"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ch8c2" value="&lt;b&gt;Questions: 3 answered on 2026-10-26, the rest still open&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;Nothing is built yet. Green = answered by the site. Order of the open ones = what blocks the mapping first.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="60" as="geometry"/></mxCell><mxCell id="ch8c3" value="&lt;b&gt;1.&lt;/b&gt; ANSWERED. DOR L3 is management level: no OEE entry, its files compile the lines. It is out of scope (loading it would double count)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1400" height="40" as="geometry"/></mxCell><mxCell id="ch8c4" value="&lt;b&gt;2.&lt;/b&gt; ANSWERED. CUPIDON and DAISY were dropped this year, so no 2026 data. Their 2025 files stay as they are." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="148" width="1400" height="40" as="geometry"/></mxCell><mxCell id="ch8c5" value="&lt;b&gt;3.&lt;/b&gt; ANSWERED. Glidepaths (targets), the path format and the reference file for Chartres exist and arrive in a few days. They fill Dept, Area, Product Type, report name and the targets of the three tables." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="196" width="1400" height="40" as="geometry"/></mxCell><mxCell id="ch8c6" value="&lt;b&gt;4.&lt;/b&gt; Source: Base directly with the Category sheet, the macro exports only as a test of our rows. The code was read: the macros do not do what we need (one day per close, wrong Level 1/2, no Planned OpT / OEE Time). Our proposal, no answer needed unless you disagree." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="244" width="1400" height="50" as="geometry"/></mxCell><mxCell id="ch8c7" value="&lt;b&gt;5.&lt;/b&gt; Time_Utilisation_EU: which of TOP (planned opening time) and TOR (real opening time) is Total Time and which is Planned OPT? The Plan_OPT_EU slot times add up to TOR. Proposal: Total Time = TOR." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="302" width="1400" height="40" as="geometry"/></mxCell><mxCell id="ch8c8" value="&lt;b&gt;6.&lt;/b&gt; Good Parts: the macro writes Volume, the workbook OEE uses Volume - Déchets. Proposal: net of waste. NON TISSE also has waste per machine (Total Déchets sums those)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="1400" height="40" as="geometry"/></mxCell><mxCell id="ch8c9" value="&lt;b&gt;7.&lt;/b&gt; Days that fail the form rules today (about 1,100 of 7,181: mostly TU vs OEE and the sum of times, mostly 2025): load them and flag, or leave them out? Dates entered twice (CUMULUS 2025: 7, ZEUS 2025: 2): replace or add? Proposal: load and flag." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="398" width="1400" height="50" as="geometry"/></mxCell><mxCell id="ch8c10" value="&lt;b&gt;8.&lt;/b&gt; Losses are per day, not per shift or product: leave ShiftName, PartName and Time empty, or spread them? Spread by what? Proposal: empty." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="456" width="1400" height="40" as="geometry"/></mxCell><mxCell id="ch8c11" value="&lt;b&gt;9.&lt;/b&gt; Shift names: the 5 types (weekday morning / afternoon / night, weekend morning / night) to Day / Night or to their own names?" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="504" width="1400" height="40" as="geometry"/></mxCell><mxCell id="ch8c12" value="&lt;b&gt;10.&lt;/b&gt; Time not counted (TownHall, trials, training, validation): in the losses table or out? Proposal: out." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="552" width="1400" height="40" as="geometry"/></mxCell><mxCell id="ch8c13" value="&lt;b&gt;11.&lt;/b&gt; The macro LineLosses has a lookup bug (Level 1/2 from the first row with the same Level 3 text), so Breakdown and Adjustment appear as Minor stop in every export. CLÉOPATRE exports are labelled APOLLON. ZEUS Module_PlanOPT is empty. CUMULUS and HOME 2 do not export on close. Tell the site? Our rows use the Category row itself." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="1400" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>