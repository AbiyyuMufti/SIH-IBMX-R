r=#d6b656;" vertex="1" parent="1"><mxGeometry x="88" y="474" width="512" height="40" as="geometry"/></mxCell><mxCell id="ch1c17" value="Archives/ (2 older IWKA copies), Fichiers de travail/ = working files (1 test copy), SAISIE 2025/ (2 dated DOR copies)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="88" y="518" width="512" height="50" as="geometry"/></mxCell><mxCell id="ch1c18" value="2026/: &quot;DOR Personal Care - Version 2026.xlsm&quot;; 90 Days Action Plan/ (1 xlsx, action plan); OEE WEEKLY REVIEW/ (empty)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="572" width="560" height="50" as="geometry"/></mxCell><mxCell id="ch1c19" value="SAISIE OEE/ (332): 6 x OEE &amp;lt;line&gt; - 2026.xlsm" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="64" y="626" width="536" height="40" as="geometry"/></mxCell><mxCell id="ch1c20" value="PlanOpt/ (161) and LineLosses/ (165): one export file per line and day, 2026-08-01 to 2026-10-23, 4 lines (CUMULUS, IWKA 1, 2, 3)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="88" y="670" width="512" height="50" as="geometry"/></mxCell><mxCell id="ch1c21" value="&lt;b&gt;DOR L3&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="620" y="170" width="560" height="30" as="geometry"/></mxCell><mxCell id="ch1c22" value="&lt;font styl