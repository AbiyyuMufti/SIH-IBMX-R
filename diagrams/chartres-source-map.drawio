<mxCell id="ch7c75" value="&lt;b&gt;Loss Units&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="190" height="50" as="geometry"/></mxCell><mxCell id="ch7c76" value="-" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="230" y="750" width="250" height="50" as="geometry"/></mxCell><mxCell id="ch7c77" value="Vitesse x Duration (design speed x minutes, as in the other sites)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="480" y="750" width="480" height="50" as="geometry"/></mxCell><mxCell id="ch7c78" value="to confirm" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="960" y="750" width="140" height="50" as="geometry"/></mxCell><mxCell id="ch7c79" value="needs a speed: the day has up to 20 speeds, take the product of the day with most minutes" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1100" y="750" width="450" height="50" as="geometry"/></mxCell><mxCell id="ch7c80" value="&lt;b&gt;Volume Total&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="190" height="40" as="geometry"/></mxCell><mxCell id="ch7c81" value="-" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="230" y="800" width="250" height="40" as="geometry"/></mxCell><mxCell id="ch7c82" value="sum of Capacity of the machine and day (Plan_OPT_EU)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="480" y="800" width="480" height="40" as="geometry"/></mxCell><mxCell id="ch7c83" value="to confirm" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="960" y="800" width="140" height="40" as="geometry"/></mxCell><mxCell id="ch7c84" value="built from the Plan_OPT_EU rows" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1100" y="800" width="450" height="40" as="geometry"/></mxCell><mxCell id="ch7c85" value="&lt;b&gt;Volume Key, Loss Target Key, Value&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="190" height="50" as="geometry"/></mxCell><mxCell id="ch7c86" value="-" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="230" y="840" width="250" height="50" as="geometry"/></mxCell><mxCell id="ch7c87" value="Volume Key = dd/MM/yyyy machine group sub desc; Loss Target Key = unique name + sub group + month start; Value = target of Glidepaths" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="480" y="840" width="480" height="50" as="geometry"/></mxCell><mxCell id="ch7c88" value="no source" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="960" y="840" width="140" height="50" as="geometry"/></mxCell><mxCell id="ch7c89" value="keys can be built; Value needs Chartres targets, which are not in the files" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1100" y="840" width="450" height="50" as="geometry"/></mxCell><mxCell id="ch7c90" value="&lt;b&gt;SiteName, Unique Machine Name, Dept, Area, Product Type, Data Source&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="190" height="70" as="geometry"/></mxCell><mxCell id="ch7c91" value="-" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="230" y="890" width="250" height="70" as="geometry"/></mxCell><mxCell id="ch7c92" value="as Plan_OPT_EU" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="480" y="890" width="480" height="70" as="geometry"/></mxCell><mxCell id="ch7c93" value="fixed / lookup" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="960" y="890" width="140" height="70" as="geometry"/></mxCell><mxCell id="ch7c94" value="Dept, Area, Product Type need Machine Names for Chartres" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1100" y="890" width="450" height="70" as="geometry"/></mxCell><mxCell id="ch7c95" value="&lt;b&gt;Rows that need a decision: &lt;/b&gt;NR (no accounted time) -&gt; Undefined / Unplanned losses; TownHall, Formation -&gt; &quot;Production not scheduled&quot;; Essais Planifiés, Validation -&gt; &quot;NPD/CapEX &amp; Trials&quot;. Other sites keep these groups out of the loss % or not: to check against how Hull and Nottingham treat them." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="980" width="1510" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="8 Questions" id="chartres8"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ch8c2" value="&lt;b&gt;Open questions and decisions before building anything&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;Nothing is built yet. Order = what blocks the mapping first.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="60" as="geometry"/></mxCell><mxCell id="ch8c3" value="&lt;b&gt;1.&lt;/b&gt; DOR L3: which file is the OEE source? No OEE*.xlsm exists for this group (Laura)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1400" height="40" as="geometry"/></mxCell><mxCell id="ch8c4" value="&lt;b&gt;2.&lt;/b&gt; Source: Base directly with the Category sheet (your preference) and the macro exports only as a test of our rows (Aug to Oct 2026 daily, January monthly). Agreed?" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="148" width="1400" height="40" as="geometry"/></mxCell><mxCell id="ch8c5" value="&lt;b&gt;3.&lt;/b&gt; The macro export maps Panne and Réglages to &amp;quot;Minor stop&amp;quot; and every &amp;quot;Autre&amp;quot; to Planned / Cleaning. The Category sheet says Breakdown, Adjustment, Unplanned. Which is the intended result for the report?" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="196" width="1400" height="40" as="geometry"/></mxCell><mxCell id="ch8c6" value="&lt;b&gt;4.&lt;/b&gt; Good Parts: Volume as the macro does, or Volume - Déchets as the OEE sheet does? NON TISSE has waste per machine as well." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="244" width="1400" height="40" as="geometry"/></mxCell><mxCell id="ch8c7" value="&lt;b&gt;5.&lt;/b&gt; Meaning of TOP, TOR, TU, NR, and which of them are Total Time, Planned OpT and OEE Time (Time_Utilisation_EU and Plan_OPT_EU)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="292" width="1400" height="40" as="geometry"/></mxCell><mxCell id="ch8c8" value="&lt;b&gt;6.&lt;/b&gt; Losses are per day, not per shift or product: leave ShiftName, PartName and Time empty, or spread them? Spread by what?" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="1400" height="40" as="geometry"/></mxCell><mxCell id="ch8c9" value="&lt;b&gt;7.&lt;/b&gt; Shift names: the 5 types (weekday morning / afternoon / night, weekend morning / night) to Day / Night or to their own names?" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="388" width="1400" height="40" as="geometry"/></mxCell><mxCell id="ch8c10" value="&lt;b&gt;8.&lt;/b&gt; Chartres lines in Machine Names (Dept, Area, Product Type, report name) and Chartres targets (UPDT, PDT, OEE Target, Value)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="436" width="1400" height="40" as="geometry"/></mxCell><mxCell id="ch8c11" value="&lt;b&gt;9.&lt;/b&gt; Dates entered twice (CUMULUS 2025: 7, ZEUS 2025: 2): replace or add? Empty files (CUPIDON, DAISY 2026): ignore." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="484" width="1400" height="40" as="geometry"/></mxCell><mxCell id="ch8c12" value="&lt;b&gt;10.&lt;/b&gt; Time not counted (TownHall, trials, training, validation): in the losses table or out?" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="532" width="1400" height="40" as="geometry"/></mxCell><mxCell id="ch8c13" value="&lt;b&gt;11.&lt;/b&gt; Optional: read the macro source code (static, not run) to settle the questions above. It needs an extraction tool for the VBA project; I will not do it without your go." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="1400" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>