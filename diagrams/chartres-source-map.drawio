t=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="160" y="850" width="100" height="40" as="geometry"/></mxCell><mxCell id="ch2c104" value="yes (13 of 18 have them)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="260" y="850" width="200" height="40" as="geometry"/></mxCell><mxCell id="ch2c105" value="2026-10-23, 2 product rows, 78 loss rows" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="460" y="850" width="260" height="40" as="geometry"/></mxCell><mxCell id="ch2c106" value="yes" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="720" y="850" width="330" height="40" as="geometry"/></mxCell><mxCell id="ch2c107" value="yes" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1050" y="850" width="330" height="40" as="geometry"/></mxCell><mxCell id="ch2c108" value="SKIN CARE" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="120" height="40" as="geometry"/></mxCell><mxCell id="ch2c109" value="&lt;b&gt;OLYMPE&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="160" y="890" width="100" height="40" as="geometry"/></mxCell><mxCell id="ch2c110" value="yes (13 of 18 have them)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="260" y="890" width="200" height="40" as="geometry"/></mxCell><mxCell id="ch2c111" value="2026-10-23, 1 product rows, 60 loss rows" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="460" y="890" width="260" height="40" as="geometry"/></mxCell><mxCell id="ch2c112" value="yes" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="720" y="890" width="330" height="40" as="geometry"/></mxCell><mxCell id="ch2c113" value="yes" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1050" y="890" width="330" height="40" as="geometry"/></mxCell><mxCell id="ch2c114" value="SKIN CARE" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="120" height="40" as="geometry"/></mxCell><mxCell id="ch2c115" value="&lt;b&gt;ZEUS&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="160" y="930" width="100" height="40" as="geometry"/></mxCell><mxCell id="ch2c116" value="yes (13 of 18 have them)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="260" y="930" width="200" height="40" as="geometry"/></mxCell><mxCell id="ch2c117" value="2026-01-30, 8 product rows, 99 loss rows" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="460" y="930" width="260" height="40" as="geometry"/></mxCell><mxCell id="ch2c118" value="yes" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="720" y="930" width="330" height="40" as="geometry"/></mxCell><mxCell id="ch2c119" value="yes" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1050" y="930" width="330" height="40" as="geometry"/></mxCell><mxCell id="ch2c120" value="&lt;b&gt;Coverage in time (whatever the macros wrote)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="1500" height="24" as="geometry"/></mxCell><mxCell id="ch2c121" value="2025: no macro output at all. Build from Base (about 5 Jan to 23 Dec 2025 for most lines)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="360" height="60" as="geometry"/></mxCell><mxCell id="ch2c122" value="Jan 2026: ONE monthly file per line (5 to 30 Jan), 13 lines" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="400" y="1030" width="300" height="60" as="geometry"/></mxCell><mxCell id="ch2c123" value="Feb to Jul 2026: no macro output. Build from Base" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="700" y="1030" width="360" height="60" as="geometry"/></mxCell><mxCell id="ch2c124" value="Aug 1/3 to Oct 23, 2026 (SKIN CARE to Oct 6): daily files for 12 of the 18 lines" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1060" y="1030" width="480" height="60" as="geometry"/></mxCell><mxCell id="ch2c125" value="&lt;b&gt;The macro output is not the same as the workbook's own rules (checked on the 10 files that hold a day)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="1500" height="24" as="geometry"/></mxCell><mxCell id="ch2c126" value="Good Parts = Volume of the product slot, Target = Capacity = Vitesse x Temps, Total Time = Temps, Downtime Units = Target - Good Parts. Equal on every product row of the 10 files." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="1150" width="1500" height="40" as="geometry"/></mxCell><mxCell id="ch2c127" value="Good Parts uses the declared Volume and ignores Déchets (waste). The sheet &quot;OEE&quot; of the same workbook computes Volume Réel = Volume Annoncé - Déchets. Defect Parts is left empty." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="1196" width="1500" height="40" as="geometry"/></mxCell><mxCell id="ch2c128" value="Planned OpT and OEE Time are always empty (except ZEUS, which has values in some rows). Plan_OPT_EU needs both, so they must be calculated anyway." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="1242" width="1500" height="40" as="geometry"/></mxCell><mxCell id="ch2c129" value="ShiftName is a number 1 to 5 (the 5 shift types), not a name. PartName is a lookup that gives a different kind of value per line (a name, a size such as &quot;100ml&quot;, or one code repeated on all products of a day in IWKA 2)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="1288" width="1500" height="40" as="geometry"/></mxCell><mxCell id="ch2c130" value="LineLosses disagrees with the Category sheet of the same file: every Panne (breakdown) and Réglages (adjustment) line is written as &quot;Minor stop&quot;, and every &quot;... Autre&quot; line of the Dysf / Panne / Réglages blocks as Planned losses / Cleaning / Other. 19 to 49 rows per file differ (all 10 files). Category says Breakdown, Adjustment and Unplanned." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="1334" width="1500" height="50" as="geometry"/></mxCell><mxCell id="ch2c131" value="Loss durations in LineLosses add up to the eight loss totals of Base (Organisation to Maintenance) + the &quot;Temps non compté&quot; columns, in 6 of 10 files; the other 4 are off by 20 to 70 minutes (probably the not-counted time of TownHall, training, trials; not verified)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="1390" width="1500" height="50" as="geometry"/></mxCell><mxCell id="ch2c132" value="&lt;b&gt;Recommendation: &lt;/b&gt;build every day from Base with the Category sheet (one rule for 2025 and 2026 and for every line), and use the daily export files of Aug to Oct 2026 and the January file only as a test: our rows for the same line and day must equal the macro rows, except where the table above shows the macro differs from the workbook rules. Running the macros ourselves is not needed and we do not run macros." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="1456" width="1500" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 Base columns" id="chartres3"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ch3c2" value="&lt;b&gt;Sheet &amp;quot;Base&amp;quot;: the important columns (French, English, abbreviations)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;One row = one day of one line, newest day on top. Letters are those of the CREAM template (IWKA 2); other lines shift after the machine blocks (page 4). English = the translation or the wording of the sheet &amp;quot;Category&amp;quot; of the same workbook. &amp;quot;(inferred)&amp;quot; = meaning worked out from formulas and numbers, to confirm with the site.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="60" as="geometry"/></mxCell><mxCell id="ch3c3" value="&lt;b&gt;FROM BASE, CHECKED ON THE FILES&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="230" height="30" as="geometry"/></mxCell><mxCell id="ch3c4" value="&lt;b&gt;RULE TO CONFIRM&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="1"><mxGeometry x="280" y="90" width="230" height="30" as="geometry"/></mxCell><mxCell id="ch3c5" value="&lt;b&gt;WATCH / DIFFERENCE&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="230" height="30" as="geometry"/></mxCell><mxCell id="ch3c6" value="&lt;b&gt;Columns&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="110" height="40" as="geometry"/></mxCell><mxCell id="ch3c7" value="&lt;b&gt;French (as in the file)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="150" y="140" width="430" height="40" as="geometry"/></mxCell><mxCell id="ch3c8" value="&lt;b&gt;English&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="140" width="430" height="40" as="geometry"/></mxCell><mxCell id="ch3c9" value="&lt;b&gt;Abbreviation / note&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1010" y="140" width="330" height="40" as="geometry"/></mxCell><mxCell id="ch3c10" value="&lt;b&gt;Feeds&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1340" y="140" width="230" height="40" as="geometry"/></mxCell><mxCell id="ch3c11" value="&lt;b&gt;A to D&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="110" height="70" as="geometry"/></mxCell><mxCell id="ch3c12" value="ANNEE, MOIS, SEMAINE, JOUR" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="150" y="180" width="430" height="70" as="geometry"/></mxCell><mxCell id="ch3c13" value="Year, Month, Week, Day" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="180" width="430" height="70" as="geometry"/></mxCell><mxCell id="ch3c14" value="The day of the row (also column MV &quot;Date&quot;, an Excel serial number, and MW &quot;Vérification Semaine&quot; = week check)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1010" y="180" width="330" height="70" as="geometry"/></mxCell><mxCell id="ch3c15" value="Date, all 3 tables" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1340" y="180" width="230" height="70" as="geometry"/></mxCell><mxCell id="ch3c16" value="&lt;b&gt;E to H&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="110" height="130" as="geometry"/></mxCell><mxCell id="ch3c17" value="TOP, TOR, TU, NR" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="150" y="250" width="430" height="130" as="geometry"/></mxCell><mxCell id="ch3c18" value="minutes of the day: TOP, TOR, TU, NR" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="250" width="430" height="130" as="geometry"/></mxCell><mxCell id="ch3c19" value="TOP = scheduled opening time (inferred). TOR = TOP minus the time not counted in LR to LW (checked: TOP = TOR + LR..LW). TU = &quot;Temps Utile&quot;, useful time = OEE time (checked: about the sum of Volume / Vitesse over the day, 9 of 10 files). NR = &quot;Non Renseigné&quot;, time not accounted for (becomes the loss &quot;Undefined&quot;)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1010" y="250" width="330" height="130" as="geometry"/></mxCell><mxCell id="ch3c20" value="Time_Utilisation_EU, Plan_OPT_EU" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1340" y="250" width="230" height="130" as="geometry"/></mxCell><mxCell id="ch3c21" value="&lt;b&gt;I to Q&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="110" height="70" as="geometry"/></mxCell><mxCell id="ch3c22" value="Démarrage Ligne, Arrêt Ligne, Pauses, Nettoyage, Désinfection, Perte Cadence, Organisation Autre, Orga Libre 1, 2" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="150" y="380" width="430" height="70" as="geometry"/></mxCell><mxCell id="ch3c23" value="Line start-up, Line shut-down, Breaks, Cleaning, Sanitization, Reduced speed, Other, spare 1, 2" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="380" width="430" height="70" as="geometry"/></mxCell><mxCell id="ch3c24" value="Minutes. Group &quot;Organisation&quot;. Planned losses, except Perte Cadence (unplanned). &quot;Libre&quot; = free, spare slot a line can name" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1010" y="380" width="330" height="70" as="geometry"/></mxCell><mxCell id="ch3c25" value="Daily_Losses_EU" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1340" y="380" width="230" height="70" as="geometry"/></mxCell><mxCell id="ch3c26" value="&lt;b&gt;R to AD&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="110" height="80" as="geometry"/></mxCell><mxCell id="ch3c27" value="Changement de Format, Changement de Formule, Changement Composant / Lot / OF, Changement de consommable, Changement Libre 1 to 6; Nbre de changement ..." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="150" y="450" width="430" height="80" as="geometry"/></mxCell><mxCell id="ch3c28" value="Format changeover, Formula change, Component / batch / work order change, Consumable refill, spare 1 to 6; Number of changes" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="450" width="430" height="80" as="geometry"/></mxCell><mxCell id="ch3c29" value="Minutes, except the three &quot;Nbre ...&quot; columns (S, U, W) which are COUNTS and are not in Total Changement (R + T + V + X). OF = Ordre de Fabrication = work order. Planned losses" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1010" y="450" width="330" height="80" as="geometry"/></mxCell><mxCell id="ch3c30" value="Daily_Losses_EU (not the counts)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1340" y="450" width="230" height="80" as="geometry"/></mxCell><mxCell id="ch3c31" value="&lt;b&gt;AE to AM&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="110" height="70" as="geometry"/></mxCell><mxCell id="ch3c32" value="Rupture Formule, Composants, Personnel, Utilité, Technicien; Manque Documentation; Évacuation - Alarme Incendie; Rupture OF / Planning; Rupture Libre 2" style