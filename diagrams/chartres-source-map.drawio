<mxfile host="build-drawio-chartres.js"><diagram name="1 Folders" id="chartres1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ch1c2" value="&lt;b&gt;Chartres: what is in the downloaded folders (downloads/Chartres)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;Four groups, each with 2024, 2025 and 2026. The file we need is &amp;lt;group&amp;gt;/&amp;lt;year&amp;gt;/SAISIE OEE/OEE &amp;lt;line&amp;gt; - &amp;lt;year&amp;gt;.xlsm (one workbook per production line and year). Counts are files in the folder, subfolders included. Role of a folder = read from its name and content (French names translated), to confirm with the site.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="60" as="geometry"/></mxCell><mxCell id="ch1c3" value="&lt;b&gt;FROM BASE, CHECKED ON THE FILES&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="230" height="30" as="geometry"/></mxCell><mxCell id="ch1c4" value="&lt;b&gt;FIXED VALUE OR LOOKUP (CONFIG)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1"><mxGeometry x="280" y="90" width="230" height="30" as="geometry"/></mxCell><mxCell id="ch1c5" value="&lt;b&gt;WATCH / DIFFERENCE&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="230" height="30" as="geometry"/></mxCell><mxCell id="ch1c6" value="&lt;b&gt;NOT USED (COPIES, BACKUPS)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;fontSize=9;" vertex="1" parent="1"><mxGeometry x="760" y="90" width="230" height="30" as="geometry"/></mxCell><mxCell id="ch1c7" value="&lt;b&gt;NO SOURCE IN THE CHARTRES FILES&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1000" y="90" width="230" height="30" as="geometry"/></mxCell><mxCell id="ch1c8" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;green = OEE entry workbook (our source) | blue = daily/monthly exports written by the macros (PlanOPT, LineLosses) | yellow = other workbooks, not profiled | grey = copies and backups | red = missing&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="1500" height="20" as="geometry"/></mxCell><mxCell id="ch1c9" value="&lt;b&gt;CREAM Chartres&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="560" height="30" as="geometry"/></mxCell><mxCell id="ch1c10" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;6 lines: CUMULUS, IWKA 1, IWKA 2, IWKA 3, and CUPIDON, DAISY (dropped this year)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="560" height="24" as="geometry"/></mxCell><mxCell id="ch1c11" value="2024/ (26 files): &quot;DOR Personal Care.xlsm&quot; and a dated copy = the older group workbook; &quot;OEE DAISY - TEST.xlsm&quot; = a test; test lien.xlsx" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="234" width="560" height="50" as="geometry"/></mxCell><mxCell id="ch1c12" value="Backup/ (22): dated copies of the DOR file (Nov to Dec 2024), v00, TEST BLUE PRINT" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="64" y="288" width="536" height="40" as="geometry"/></mxCell><mxCell id="ch1c13" value="2025/ (18): &quot;DOR Personal Care - Version 2025.xlsm&quot; (group workbook), CREAM_Export_20250913.pdf" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="332" width="560" height="50" as="geometry"/></mxCell><mxCell id="ch1c14" value="Backup/ (4): copies of the 2025 DOR file" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="64" y="386" width="536" height="40" as="geometry"/></mxCell><mxCell id="ch1c15" value="SAISIE OEE/ (12) = &quot;data entry OEE&quot;: 6 x OEE &amp;lt;line&gt; - 2025.xlsm" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="64" y="430" width="536" height="40" as="geometry"/></mxCell><mxCell id="ch1c16" value="TRSCOS2.xls (old .xls format, not profiled)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="88" y="474" width="512" height="40" as="geometry"/></mxCell><mxCell id="ch1c17" value="Archives/ (2 older IWKA copies), Fichiers de travail/ = working files (1 test copy), SAISIE 2025/ (2 dated DOR copies)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="88" y="518" width="512" height="50" as="geometry"/></mxCell><mxCell id="ch1c18" value="2026/: &quot;DOR Personal Care - Version 2026.xlsm&quot;; 90 Days Action Plan/ (1 xlsx, action plan); OEE WEEKLY REVIEW/ (empty)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="572" width="560" height="50" as="geometry"/></mxCell><mxCell id="ch1c19" value="SAISIE OEE/ (332): 6 x OEE &amp;lt;line&gt; - 2026.xlsm" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="64" y="626" width="536" height="40" as="geometry"/></mxCell><mxCell id="ch1c20" value="PlanOpt/ (161) and LineLosses/ (165): one export file per line and day, 2026-08-01 to 2026-10-23, 4 lines (CUMULUS, IWKA 1, 2, 3)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="88" y="670" width="512" height="50" as="geometry"/></mxCell><mxCell id="ch1c21" value="&lt;b&gt;DOR L3&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#dddddd;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="620" y="170" width="560" height="30" as="geometry"/></mxCell><mxCell id="ch1c22" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;lines not named; no SAISIE OEE folder&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="620" y="200" width="560" height="24" as="geometry"/></mxCell><mxCell id="ch1c23" value="MANAGEMENT LEVEL (site answer, 2026-10-26): no OEE entry here, no SAISIE OEE folder. The files compile the lines, so DOR L3 is not a source (it would double count)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="620" y="234" width="560" height="50" as="geometry"/></mxCell><mxCell id="ch1c24" value="2024/ (37): L3 DOR.xlsm (25 MB); Backup/ (L3 DOR2.xlsm, DOR L3/ 2 files, Présence Absence/ = attendance, empty); Fichiers de travail - Ne pas utiliser/ = working files, do not use (empty)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="620" y="288" width="560" height="70" as="geometry"/></mxCell><mxCell id="ch1c25" value="DI/ and OT/ (2 each): Export.xlsx + archived exports. Probably maintenance requests and work orders (inferred from the French abbreviations)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="644" y="362" width="536" height="50" as="geometry"/></mxCell><mxCell id="ch1c26" value="Suivi IWKA 2/ = IWKA 2 follow-up (29): Daily 19, Weekly 4, BiWeekly 1, Monthly 2, Fichier de données 3" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="644" y="416" width="536" height="50" as="geometry"/></mxCell><mxCell id="ch1c27" value="2025/ (115): L3 DOR Version 2025.xlsm (29 MB), BREAKFAST CHARTRES 2025.xlsm (46 MB), Six to Fix Zulia IWK1.xlsx, Suivi creme Zulia-Jordan sur IWKA.xlsx" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="620" y="470" width="560" height="50" as="geometry"/></mxCell><mxCell id="ch1c28" value="FICHIER DE TRAVAIL - NE PAS UTILISER/ (95): a copy of the Breakfast file + RAPPORTS/ (94 reports)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="644" y="524" width="536" height="50" as="geometry"/></mxCell><mxCell id="ch1c29" value="L3 Board/ (L3 board - Daily Management - Chartres.xlsm, LIMS EXPORT/); OEE GLIDEPATH REVIEW/ (5 .pptm weekly reviews, weeks 38 to 42); DI/, OT/; RPS HOURLY TARGET/ (4 xlsx); RPS Reporting/ (1 xlsx)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="644" y="578" width="536" height="70" as="geometry"/></mxCell><mxCell id="ch1c30" value="2026/ (21): BREAKFAST CHARTRES 2026.xlsm (Breakfast Report/ with RAPPORTS/ 11 and Backup/), L3 board 2026, Working Files/DATA CHARTRES 2026.xlsm (24 MB), RPS - MOS Hourly Target 2026/, 5 xlsx (Automatic Report source with AI, OEE démontré, OEE Simulator, Suivi Présence, Volume repartition)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="620" y="652" width="560" height="80" as="geometry"/></mxCell><mxCell id="ch1c31" value="&lt;b&gt;NON TISSE&lt;