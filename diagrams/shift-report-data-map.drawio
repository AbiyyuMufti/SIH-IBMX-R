<mxfile host="build-drawio-shift-report.js" type="device"><diagram name="Overview" id="page0"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s0c2" value="&lt;b&gt;Shift (management) report: where the data comes from&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;Top: which Insights Hub calls fill which of 3 proposed tables (not built). Bottom: which table each report block reads. Colour of a box = availability.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;Every table holds all lines of a site, one file per site and day (rpt_*/site=Hull/..._YYYY-MM-DD.parquet). Tableau filters by line.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="70" as="geometry"/></mxCell><mxCell id="s0c3" value="&lt;b&gt;HAVE NOW&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1220" y="20" width="200" height="30" as="geometry"/></mxCell><mxCell id="s0c4" value="&lt;b&gt;IN THE API, NEW FLOW&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1220" y="60" width="200" height="30" as="geometry"/></mxCell><mxCell id="s0c5" value="&lt;b&gt;TEST FIRST&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1220" y="100" width="200" height="30" as="geometry"/></mxCell><