        </mxCell>
        <mxCell id="m3lb" value="&lt;b&gt;Provideam data&lt;/b&gt;&lt;br&gt;manual copy is not enough" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="40" y="350" width="180" height="200" as="geometry" />
        </mxCell>
        <mxCell id="m3b1" value="&lt;b&gt;Today&lt;/b&gt;: the CSV files are copied by hand from SharePoint to the data lake" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="260" y="370" width="230" height="160" as="geometry" />
        </mxCell>
        <mxCell id="m3b2" value="&lt;b&gt;Not enough&lt;/b&gt;: depends on a person, no daily run, late Provideam edits (sent every hour until 17:00) are missed, only what is in SharePoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="540" y="370" width="230" height="160" as="geometry" />
        </mxCell>
        <mxCell id="m3b3" value="&lt;b&gt;Needed (ask Reckitt)&lt;/b&gt;: receive the same Provideam report emails as the person who makes the report, for every site and report type. This also confirms the full list of raw files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacing=8;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="820" y="370" width="230" height="160" as="geometry" />
        </mxCell>
        <mxCell id="m3b4" value="&lt;b&gt;Land each CSV&lt;/b&gt; in eu_report/pbi_report/source/ from the email trigger. Blocked until a Power Automate Premium license is available." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1100" y="370" width="230" height="160" as="geometry" />
        </mxCell>
