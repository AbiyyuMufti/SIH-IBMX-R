        </mxCell>
        <mxCell id="m3b1" value="&lt;b&gt;Today&lt;/b&gt;: the CSV files are copied by hand from SharePoint to the data lake" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
