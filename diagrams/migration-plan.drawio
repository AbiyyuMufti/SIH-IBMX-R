        </mxCell>
        <mxCell id="m3b2" value="&lt;b&gt;Not enough&lt;/b&gt;: depends on a person, no daily run, late Provideam edits (sent every hour until 17:00) are missed, only what is in SharePoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="540" y="370" width="230" height="160" as="geometry" />
        </mxCell>
        <mxCell id="m3b3" value="&lt;b&gt;Needed (ask Reckitt)&lt;/b&gt;: receive the same Provideam report emails as the person who makes the report, for every site and report type. This also confirms the full list of raw files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacing=8;strokeWidth=2;" parent="1" vertex="1">
