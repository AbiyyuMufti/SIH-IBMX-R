        </mxCell>
        <mxCell id="m3lb" value="&lt;b&gt;Provideam data&lt;/b&gt;&lt;br&gt;manual copy is not enough" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" parent="1" vertex="1">
