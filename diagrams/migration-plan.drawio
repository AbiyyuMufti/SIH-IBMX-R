          <mxGeometry x="540" y="130" width="230" height="160" as="geometry" />
        </mxCell>
        <mxCell id="m3a3" value="&lt;b&gt;Insights Hub OEE setup&lt;/b&gt; per line: complete enough that the SIH rows match Provideam. Heavy days fail today on a Siemens setup error (over 5,000 stops)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="820" y="130" width="230" height="160" as="geometry" />
