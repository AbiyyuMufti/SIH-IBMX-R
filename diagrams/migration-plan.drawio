<mxfile host="drawio" version="26.0.16" pages="2">
  <diagram name="1 Migration plan and switch" id="mig1">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="m1title" value="&lt;b&gt;Migration to Siemens Insights Hub (SIH): reports move first, data sources follow line by line&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;" parent="1" vertex="1">
          <mxGeometry x="40" y="20" width="1700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m1sub" value="The reports keep the data they need today. They first move to read the SIH data lake (still fed with Provideam data), then each site or line switches its source from Provideam to Insights Hub in the Config tab, without a change in the report. Two report types: EU Reporting (its site-level reports use the same tables, treated the same here) and the Shift / Management Report. Top: overview. Below: how the switch works and where each flow writes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="40" y="55" width="1700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="m1lg1" value="Done" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="40" y="100" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m1lg2" value="Work in progress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="210" y="100" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m1lg3" value="Not enough / needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="380" y="100" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m1lg4" value="Old path, to retire" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="550" y="100" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m1lg5" value="To be, later" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="720" y="100" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m1h1" value="&lt;b&gt;1. BEFORE&lt;/b&gt;&lt;br&gt;Provideam feeds the reports through SharePoint" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="200" y="160" width="400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="m1h2" value="&lt;b&gt;2. NOW (transition)&lt;/b&gt;&lt;br&gt;Reports read the SIH data lake, source chosen per site or line" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="700" y="160" width="440" height="50" as="geometry" />
        </mxCell>
        <mxCell id="m1h3" value="&lt;b&gt;3. TARGET&lt;/b&gt;&lt;br&gt;Insights Hub only" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1240" y="160" width="400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="m1r1" value="&lt;b&gt;Data source&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="40" y="230" width="140" height="150" as="geometry" />
        </mxCell>
        <mxCell id="m1r2" value="&lt;b&gt;Data path&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="40" y="420" width="140" height="150" as="geometry" />
        </mxCell>
        <mxCell id="m1r3" value="&lt;b&gt;Reports&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="40" y="610" width="140" height="150" as="geometry" />
        </mxCell>
        <mxCell id="m1a1" value="&lt;b&gt;Provideam&lt;/b&gt; (site production system)&lt;br&gt;Scheduled Day reports sent as CSV emails. Plan OPT seen; OEE Loss, Mode Log, Run Rates and the 06:10 then hourly to 17:00 schedule come from the Hull maintenance guide and the Power BI folders, &lt;b&gt;not from the raw emails&lt;/b&gt;. Full list of emails: not known yet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="200" y="230" width="400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="m1a2" value="&lt;b&gt;Email → SharePoint&lt;/b&gt;&lt;br&gt;Outlook rules and Power Automate put one CSV per day in the site SharePoint folders.&lt;br&gt;Plus Excel files kept by hand: Machine Names, Shift Pattern Naming, Glidepaths, Equipment Coding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="200" y="420" width="400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="m1a3" value="&lt;b&gt;EU Reporting&lt;/b&gt; (and site-level reports) built from the SharePoint files&lt;br&gt;&lt;b&gt;Shift / Management Report&lt;/b&gt;: current site process" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="200" y="610" width="400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="m1b1" value="&lt;b&gt;Provideam&lt;/b&gt; CSV files into the data lake. Now: copied by hand from SharePoint (backfill 2024-12 to 2026-10 done). To be: from the report emails, received directly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="700" y="230" width="210" height="150" as="geometry" />
        </mxCell>
        <mxCell id="m1b1b" value="&lt;b&gt;Insights Hub OEE API&lt;/b&gt;, called by VFC flows, one tab per site (Hull built and run). Line configuration is work in progress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="930" y="230" width="210" height="150" as="geometry" />
        </mxCell>
        <mxCell id="m1b2" value="&lt;b&gt;SIH data lake&lt;/b&gt; (root eu_report)&lt;br&gt;Config tab: reportSource per site or line = provideam | sih.&lt;br&gt;report/ = the source in use (what the reports read)&lt;br&gt;candidate/&amp;lt;source&amp;gt;/ = the other source, to compare&lt;br&gt;Details: below" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="700" y="420" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="m1b3" value="&lt;b&gt;Reports read the lake&lt;/b&gt; (the reports move to SIH first)&lt;br&gt;&lt;b&gt;EU Reporting&lt;/b&gt; (+ site level): Plan_OPT_EU, Time_Utilisation_EU, Daily_Losses_EU&lt;br&gt;&lt;b&gt;Shift / Management Report&lt;/b&gt;: rpt_window, rpt_hour, rpt_event (from SIH only, Hull B2 line and machines)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="700" y="610" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="m1c1" value="&lt;b&gt;Insights Hub OEE&lt;/b&gt;, configured for every line of every site" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1240" y="230" width="400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="m1c2" value="&lt;b&gt;SIH data lake&lt;/b&gt;, every line on reportSource = sih.&lt;br&gt;The Provideam path (emails, SharePoint, copy, PBI report build) is switched off" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1240" y="420" width="400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="m1c3" value="&lt;b&gt;Same reports, same tables&lt;/b&gt;&lt;br&gt;No change in the reports when a line switches" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1240" y="610" width="400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="m1e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="m1a1" target="m1a2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m1e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="m1a2" target="m1a3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m1e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="m1b1" target="m1b2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m1e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="m1b1b" target="m1b2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m1e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="m1b2" target="m1b3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m1e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" parent="1" source="m1c1" target="m1c2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m1e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" parent="1" source="m1c2" target="m1c3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m1e8" value="A. reports&lt;br&gt;move first" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=3;strokeColor=#9673a6;fontSize=10;labelBackgroundColor=#ffffff;" parent="1" source="m1h1" target="m1h2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m1e9" value="B. switch&lt;br&gt;line by line" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=3;strokeColor=#9673a6;fontSize=10;labelBackgroundColor=#ffffff;" parent="1" source="m1h2" target="m1h3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m1n1" value="&lt;b&gt;For step B, Provideam data needs more than a manual copy&lt;/b&gt;&lt;br&gt;Receive the same Provideam report emails as the person who makes the report, so every file and every late edit lands in the data lake without a hand copy (to-be path below, sheet 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="200" y="800" width="620" height="80" as="geometry" />
        </mxCell>
        <mxCell id="m1n2" value="&lt;b&gt;For step B, SIH data needs the configuration finished&lt;/b&gt;&lt;br&gt;Lines and report names in Config, one SIH tab per site, Insights Hub OEE setup that gives rows matching Provideam (sheet 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="860" y="800" width="620" height="80" as="geometry" />
        </mxCell>
        <mxCell id="m2title" value="&lt;b&gt;How the switch works: one Config, two sources, one report folder (branch general-report-configurations)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;" parent="1" vertex="1">
          <mxGeometry x="40" y="930" width="1700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m2sub" value="Both flows build the same three tables. Each flow sends the rows of a line to report/ when the line's source in Config is its own source, else to candidate/&amp;lt;source&amp;gt;/. The file name ends with the source (_provideam, _sih), so the two flows never overwrite each other. The report reads the whole report/ folder: switching a line is one Config change, nothing changes in the report." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="40" y="965" width="1700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="m2cfg" value="&lt;b&gt;1.1 CONFIG&lt;/b&gt; (Config tab, one place for all flows)&lt;br&gt;root: eu_report&lt;br&gt;sites[]: reportSource = provideam | sih, timeZone, runHourLocal&lt;br&gt;lines[]: id, sih name, report name (MachineName), optional reportSource, shiftReport" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="580" y="1020" width="480" height="100" as="geometry" />
        </mxCell>
        <mxCell id="m2btn" value="&lt;b&gt;Button List SIH assets&lt;/b&gt;&lt;br&gt;Every SIH line with its id and its report name from the Machine Names file, as a block to paste into lines[]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1120" y="1020" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="m2pv1" value="&lt;b&gt;Provideam&lt;/b&gt; Day reports, CSV emails. Full list not known yet (see top)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="40" y="1190" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="m2pv2" value="&lt;b&gt;NOW: manual copy&lt;/b&gt; from SharePoint to pbi_report/source/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="290" y="1140" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="m2pv2b" value="&lt;b&gt;TO BE: emails received directly&lt;/b&gt; (same distribution as the report owner), each CSV uploaded to pbi_report/source/ as it arrives, late edits included. No SharePoint, no hand copy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;dashed=1;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="290" y="1230" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="m2pv3" value="&lt;b&gt;PBI report build&lt;/b&gt; (VFC)&lt;br&gt;Reads the CSV and reference files, no API calls. To be: started by the lake watcher" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="580" y="1190" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="m2d1" value="Line source&lt;br&gt;= provideam?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="830" y="1185" width="160" height="100" as="geometry" />
        </mxCell>
        <mxCell id="m2sh1" value="&lt;b&gt;Insights Hub OEE API&lt;/b&gt;&lt;br&gt;evaluateKPIs, downtimeReasons, orders" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="40" y="1420" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="m2sh3" value="&lt;b&gt;&amp;lt;Site&amp;gt; SIH report daily&lt;/b&gt; (VFC)&lt;br&gt;One tab per site (Hull now), runs at runHourLocal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="580" y="1420" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="m2d2" value="Line source&lt;br&gt;= sih?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="830" y="1410" width="160" height="100" as="geometry" />
        </mxCell>
        <mxCell id="m2shr" value="&lt;b&gt;&amp;lt;Site&amp;gt; shift report&lt;/b&gt; (VFC)&lt;br&gt;Lines with shiftReport: true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="580" y="1550" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="m2cp" value="&lt;b&gt;candidate/provideam/&lt;/b&gt;&amp;lt;table&amp;gt;/site=&amp;lt;Site&amp;gt;/ (to compare)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1060" y="1150" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m2rep" value="&lt;b&gt;report/&lt;/b&gt;&amp;lt;table&amp;gt;/site=&amp;lt;Site&amp;gt;/&amp;lt;table&amp;gt;_&amp;lt;YYYY-MM&amp;gt;_&amp;lt;source&amp;gt;.parquet&lt;br&gt;One month file per source; each holds only its own lines" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacing=8;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="1060" y="1290" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="m2cs" value="&lt;b&gt;candidate/sih/&lt;/b&gt;&amp;lt;table&amp;gt;/site=&amp;lt;Site&amp;gt;/ (to compare)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1060" y="1440" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m2tab" value="&lt;b&gt;EU Reporting&lt;/b&gt;&lt;br&gt;One data source per table, reads the whole report/&amp;lt;table&amp;gt;/ folder:&lt;br&gt;Plan_OPT_EU&lt;br&gt;Time_Utilisation_EU&lt;br&gt;Daily_Losses_EU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1480" y="1260" width="260" height="140" as="geometry" />
        </mxCell>
        <mxCell id="m2cmp" value="&lt;b&gt;Compare&lt;/b&gt; candidate/sih/ with report/ per line and month. When the SIH rows match: set reportSource = sih for the line or site in 1.1 CONFIG (step 5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1060" y="1540" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="m2sro" value="&lt;b&gt;shift_report/&lt;/b&gt;&amp;lt;table&amp;gt;/site=&amp;lt;Site&amp;gt;/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="830" y="1640" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m2srr" value="&lt;b&gt;Shift / Management Report&lt;/b&gt;&lt;br&gt;rpt_window, rpt_hour, rpt_event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1480" y="1640" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m2e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="m2btn" target="m2cfg" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="m2pv1" target="m2pv2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2e2b" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#b85450;strokeWidth=2;" parent="1" source="m2pv1" target="m2pv2b" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="m2pv2" target="m2pv3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2e3b" value="lake watcher" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" parent="1" source="m2pv2b" target="m2pv3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="m2pv3" target="m2d1" edge="1">
