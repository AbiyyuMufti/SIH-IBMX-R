        <mxCell id="m4c53" value="&lt;b&gt;BLOCKED&lt;/b&gt;&lt;br&gt;No report rows returned. Need valid ReportRequestModel values and a working one-machine, one-day example from the API owner." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=15;fontColor=#7c5b00;align=left;spacing=8;" parent="1" vertex="1">
