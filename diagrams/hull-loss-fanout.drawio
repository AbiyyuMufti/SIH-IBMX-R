<mxfile host="app.diagrams.net"><diagram name="Loss fan-out" id="lossfanout"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lf2" value="AS-IS (Power BI today)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;fillColor=#ffffff;strokeColor=#ffffff;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="380" height="40" as="geometry"/></mxCell><mxCell id="lf3" value="&lt;b&gt;1. Stops (raw file)&lt;/b&gt;&lt;br&gt;14:45 Mechanical 30 min&lt;br&gt;16:09 Electrical 96 min&lt;br&gt;= 2 stops, 126 min" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="380" height="80" as="geometry"/></mxCell><mxCell id="lf4" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="lf2" target="lf3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lf5" value="&lt;b&gt;2. Price list (raw file)&lt;/b&gt;&lt;br&gt;Electrical 96 min, 5,280 units&lt;br&gt;Mechanical 30 min, 1,650 units" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="380" height="80" as="geometry"/></mxCell><mxCell id="lf6" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="lf3" target="lf5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lf7" value="&lt;b&gt;3. Rename&lt;/b&gt; Breakdown - Electrical / Mechanical to Breakdown (stops and price list)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="380" height="80" as="geometry"/></mxCell><mxCell id="lf8" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="lf5" target="lf7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lf9" value="&lt;b&gt;4. Make the key&lt;/b&gt; for stops and price lines&lt;br&gt;Key = 14/09/2026 SP8 Unplanned Loss Breakdown CasePacker Carton Infeed&lt;br&gt;Both price lines get the SAME key" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="380" height="80" as="geometry"/></mxCell><mxCell id="lf10" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="lf7" target="lf9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lf11" value="&lt;b&gt;5. Join&lt;/b&gt; stops to price list on key&lt;br&gt;every match = one row, key has 2 lines" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="380" height="80" as="geometry"/></mxCell><mxCell id="lf12" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="lf9" target="lf11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lf13" value="&lt;b&gt;6. Result: 4 rows, 252 min&lt;/b&gt;&lt;br&gt;each stop twice, Count of Volume Key = 2&lt;br&gt;(truth: 2 rows, 126 min)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="380" height="80" as="geometry"/></mxCell><mxCell id="lf14" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="lf11" target="lf13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lf15" value="TO-BE (with the fix)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;fillColor=#ffffff;strokeColor=#ffffff;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="20" width="380" height="40" as="geometry"/></mxCell><mxCell id="lf16" value="&lt;b&gt;1. Stops (raw file)&lt;/b&gt;&lt;br&gt;14:45 Mechanical 30 min&lt;br&gt;16:09 Electrical 96 min&lt;br&gt;= 2 stops, 126 min" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="520" y="70" width="380" height="80" as="geometry"/></mxCell><mxCell id="lf17" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="lf15" target="lf16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lf18" value="&lt;b&gt;2. Price list (raw file)&lt;/b&gt;&lt;br&gt;Electrical 96 min, 5,280 units&lt;br&gt;Mechanical 30 min, 1,650 units" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="520" y="190" width="380" height="80" as="geometry"/></mxCell><mxCell id="lf19" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="lf16" target="lf18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lf20" value="&lt;b&gt;3. Rename&lt;/b&gt; Breakdown - Electrical / Mechanical to Breakdown (stops and price list)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="520" y="310" width="380" height="80" as="geometry"/></mxCell><mxCell id="lf21" style="html=1;endArrow=block;endFill=1;strokeWid