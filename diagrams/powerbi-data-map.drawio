          <mxGeometry x="40" y="20" width="1500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p1c3" value="Holds: List of lines (Excel per site). One row is: One row per machine.&lt;br&gt;Insights Hub table: 2 rows, 7 columns. Only the machines of the Config tab (Hull: 2). The Power BI local copy lists 76 machines of all sites.&lt;br&gt;Used on pages: EU-Level Overview, Site-Level Overview, L2/L3 FIT View, Planned Losses, Unplanned Losses, Maintenance (BETA), Loss Trending, By Shift, By Format, OEE Trending (some through measures)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=11;" parent="1" vertex="1">
