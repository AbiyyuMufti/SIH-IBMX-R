        <mxCell id="cmt-p1-1" value="&lt;b&gt;Comment (user, 2026-10-14)&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Insights Hub data is overall complete for this table.&lt;br&gt;- Insights Hub itself covers only: Machine Name, Area, Site Name and Machine ID.&lt;br&gt;- Dept, Area and Product Type now all take the Area. They can be made more accurate: where a confirmed mapping exists from a master data source, use it on top of the Insights Hub data.&lt;br&gt;- This is static reference data with few changes. For now the flow stays as it is. The machine data will be compiled later." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;arcSize=5;fillColor=#FFF59D;strokeColor=#F9A825;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="1340" y="62" width="440" height="250" as="geometry" />
        </mxCell>
        <mxCell id="how2-p1c51" value="&lt;b&gt;Data flow of this table in Power BI: what we must collect and what Insights Hub replaces&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1340" y="340" width="1100" height="24" as="geometry" />
        </mxCell>
        <mxCell id="how2-p1c52" value="Insights Hub replaces it. The original is used for validation" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1340" y="372" width="360" height="40" as="geometry" />
        </mxCell>
        <mxCell id="how2-p1c53" value="Needed and missing: we must get this file" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=middle;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1710" y="372" width="360" height="40" as="geometry" />
        </mxCell>
        <mxCell id="how2-p1c54" value="Built inside Power BI: nothing to collect" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2080" y="372" width="360" height="40" as="geometry" />
        </mxCell>
        <mxCell id="how2-p1c55" value="&lt;b&gt;Data sources&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1340" y="436" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="how2-p1c56" value="&lt;b&gt;Steps in Power BI&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1700" y="436" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="how2-p1c57" value="&lt;b&gt;Result&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2060" y="436" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="how2-p1c58" value="&lt;b&gt;1  &lt;/b&gt;Keep the columns. Remove &amp;quot;GT4 - Auto&amp;quot;. The Hull query keeps only Dries Pack and Liquids Pack" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1700" y="462" width="300" height="74" as="geometry" />
        </mxCell>
        <mxCell id="how2-p1c59" value="&lt;b&gt;2  &lt;/b&gt;Add SiteName and the suffix (for example -Hull)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1700" y="574" width="300" height="74" as="geometry" />
        </mxCell>
        <mxCell id="how2-p1c60" value="&lt;b&gt;3  &lt;/b&gt;Stack the sites: Nottingham + Hull + Weinheim, then Mira" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1700" y="686" width="300" height="74" as="geometry" />
        </mxCell>
        <mxCell id="how2-p1c61" value="&lt;b&gt;4  &lt;/b&gt;Build Unique Machine Name = machine name + suffix" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1700" y="798" width="300" height="74" as="geometry" />
        </mxCell>
        <mxCell id="how2-p1c62" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="how2-p1c58" target="how2-p1c59">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="how2-p1c63" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="how2-p1c59" target="how2-p1c60">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="how2-p1c64" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="how2-p1c60" target="how2-p1c61">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="how2-p1c65" value="&lt;b&gt;Machine Names file (per site)&lt;/b&gt;&lt;br&gt;Columns MachineName, Area, SiteName&lt;br&gt;&lt;br&gt;&lt;b&gt;INSIGHTS HUB REPLACES IT. The original is used for validation. (asset name, area, site).&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=4;fontSize=9.5;" vertex="1" parent="1">
          <mxGeometry x="1340" y="458.5" width="300" height="81" as="geometry" />
        </mxCell>
        <mxCell id="how2-p1c66" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#82b366;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="how2-p1c65" target="how2-p1c58">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="how2-p1c67" value="&lt;b&gt;Machine Names file (per site)&lt;/b&gt;&lt;br&gt;Columns Dept and Product Type&lt;br&gt;&lt;br&gt;&lt;b&gt;WE NEED THIS FILE. It is not in Insights Hub. Hull file: no access yet.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=9.5;" vertex="1" parent="1">
