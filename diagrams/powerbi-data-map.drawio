llColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1060" y="565" width="74" height="36" as="geometry"/></mxCell><mxCell id="p0c28" value="1 with gaps" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1138" y="565" width="74" height="36" as="geometry"/></mxCell><mxCell id="p0c29" value="5 assumption" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1216" y="565" width="74" height="36" as="geometry"/></mxCell><mxCell id="p0c30" value="0 needs file" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1294" y="565" width="74" height="36" as="geometry"/></mxCell><mxCell id="p0c31" value="0 empty / missing" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1372" y="565" width="74" height="36" as="geometry"/></mxCell><mxCell id="p0c32" value="0 not needed" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#eeeeee;strokeColor=#999999;fontSize=10;align=center;spacingLeft=2;s