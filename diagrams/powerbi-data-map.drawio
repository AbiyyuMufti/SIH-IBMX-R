          <mxGeometry x="40" y="20" width="1500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2c3" value="Holds: Actual production per machine, plus capacity and monthly targets. One row is: Machine x date x shift x product.&lt;br&gt;Insights Hub table: 178 rows, 19 columns. One row per production day, machine, shift and product. Dates are text yyyy-mm-dd in the Insights Hub files (parquet has no date type).&lt;br&gt;Used on pages: EU-Level Overview, Site-Level Overview, Planned Losses, Unplanned Losses (some through measures)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="40" y="62" width="1260" height="96" as="geometry" />
        </mxCell>
        <mxCell id="p2c4" value="&lt;b&gt;Power BI column&lt;/b&gt; (blue) and example (below it)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="40" y="172" width="270" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p2c5" value="&lt;b&gt;Insights Hub column&lt;/b&gt; and example (below it)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="380" y="172" width="270" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p2c6" value="&lt;b&gt;SIH integration&lt;/b&gt; (status and difference). Dashed box = SIH source: teal API endpoint, indigo built in the flow, grey none" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=10.5;" parent="1" vertex="1">
          <mxGeometry x="700" y="172" width="600" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p2c7" value="&lt;b&gt;Date&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;dateTime&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
