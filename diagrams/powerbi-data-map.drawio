Cell id="p14c60" value="Reason names differ. Insights Hub has the comment count only and no Planned Loss in the Hull data" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="700" y="848" width="480" height="60" as="geometry"/></mxCell><mxCell id="p14c61" value="Comment text: read the comment endpoint or accept the gap. Planned losses: from the shift calendar" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1190" y="848" width="370" height="60" as="geometry"/></mxCell><mxCell id="p14c62" value="&lt;b&gt;Loss Units&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="916" width="310" height="60" as="geometry"/></mxCell><mxCell id="p14c63" value="Provideam Volume Loss Correction files (daily)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="360" y="916" width="330" height="60" as="geometry"/></mxCell><mxCell id="p14c64" value="Same rule (minutes x capacity per minute: 2,341 of 2,349 machine-days within 3%). Differs only if the speed differs" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="700" y="916" width="480" height="60" as="geometry"/></mxCell><mxCell id="p14c65" value="Compute in the flow. Check the sums against the file" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1190" y="916" width="370" height="60" as="geometry"/></mxCell><mxCell id="p14c66" value="&lt;b&gt;Volume Total&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="984" width="310" height="60" as="geometry"/></mxCell><mxCell id="p14c67" value="Built from the Plan OPT Capacity per machine and day (Hull query)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="360" y="984" width="330" height="60" as="geometry"/></mxCell><mxCell id="p14c68" value="None, it follows the capacity" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="700" y="984" width="480" height="60" as="geometry"/></mxCell><mxCell id="p14c69" value="Build it in the flow (not built yet)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=