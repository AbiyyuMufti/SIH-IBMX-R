<mxfile host="app.diagrams.net" agent="build-drawio.js" version="24.0.0"><diagram name="1 Overview" id="page0"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p0c2" value="&lt;b&gt;Power BI data overview: what the report reads and what is created from Insights Hub&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="p0c3" value="Source: the existing EU Power BI report (model template and report file, read 2026-10-12/13) and the Insights Hub Hull tables in the data lake (profile of 2026-10-13). The report also reads regional tables (N, H, W, M) directly on some pages; they are not in scope. One page per table follows." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1500" height="60" as="geometry"/></mxCell><mxCell id="p0c4" value="&lt;b&gt;Power BI local copy&lt;/b&gt; = the existing EU report as a local Power BI file (model and sample tables). It is the reference for structure and examples; its values may be test data." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="86" width="1500" height="26" as="geometry"/></mxCell><mxCell id="p0c5" value="OK: filled and built by a known rule" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="280" height="28" as="geometry"/></mxCell><mxCell id="p0c6" value="Partly filled: has gaps" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="120" width="280" height="28" as="geometry"/></mxCell><mxCell id="p0c7" value="Assumption or difference: check it" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="120" width="280" height="28" as="geometry"/></mxCell><mxCell id="p0c8" value="Empty now or no column: needs input" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="940" y="120" width="280" height="28" as="geometry"/></mxCell><mxCell id="p0c9" value="Not needed" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#eeeeee;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1240" y="120" width="280" height="28" as="geometry"/></mxCell><mxCell id="p0c10" value="&lt;b&gt;Tables created from Insights Hub today (6): each has its own page&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="1500" height="24" as="geometry"/></mxCell><mxCell id="p0c11" value="&lt;b&gt;Machine Names EU&lt;/b&gt;  -&gt;  &lt;b&gt;pbi_machine_names&lt;/b&gt;&lt;br&gt;&lt;br&gt;Holds: List of lines (Excel per site)&lt;br&gt;&lt;br&gt;One row is: One row per machine&lt;br&gt;&lt;br&gt;Insights Hub table: 2 rows, 7 columns (Hull, downloaded 2026-10-13)&lt;br&gt;&lt;br&gt;Used on pages: EU-Level Overview, Site-Level Overview, L2/L3 FIT View, Planned Losses, Unplanned Losses, Maintenance (BETA), Loss Trending, By Shift, By Format, OEE Trending (some through measures)&lt;br&gt;&lt;br&gt;Columns in Power BI: 6" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=8;fillColor=#ffffff;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="40" y="205" width="480" height="270" as="geometry"/></mxCell><mxCell id="p0c12" value="2 OK" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="40" y="485" width="90" height="36" as="geometry"/></mxCell><mxCell id="p0c13" value="0 with gaps" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="135" y="485" width="90" height="36" as="geometry"/></mxCell><mxCell id="p0c14" value="4 assumption" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="230" y="485" width="90" height="36" as="geometry"/></mxCell><mxCell id="p0c15" value="0 empty / missing" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColo