nt="1"><mxGeometry x="40" y="1120" width="310" height="60" as="geometry"/></mxCell><mxCell id="p14c75" value="Generated by the flow" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="360" y="1120" width="330" height="60" as="geometry"/></mxCell><mxCell id="p14c76" value="None" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="700" y="1120" width="480" height="60" as="geometry"/></mxCell><mxCell id="p14c77" value="None" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1190" y="1120" width="370" height="60" as="geometry"/></mxCell><mxCell id="p14c78" value="&lt;b&gt;Open decisions and blockers&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="1194" width="1500" height="24" as="geometry"/></mxCell><mxCell id="p14c79" value="1. Official OEE source per site, today and after the move (Provideam or Insights Hub). Question for Mei Shin and Asif.&lt;br&gt;&lt;br&gt;2. Machine key: asset ID or machine name + site. All mapping tables depend on it.&lt;br&gt;&lt;br&gt;3. Who builds the Power Automate flow, and the VFC receiver: file size limit and key handling are not tested.&lt;br&gt;&lt;br&gt;4. Access: Hull folders Equipment Coding, Line Losses, Machine Names, Packing Run Rates, Volume Loss Correction; the whole Mira site.&lt;br&gt;&lt;br&gt;5. File format for the integration: Provideam files are UTF-16 with tab separation, CR line ends, a Total row and comments with unescaped quotes. Ask for a clean export." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1228" width="1520" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Not created yet" id="page15"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p15c2" value="&lt;b&gt;Power BI tables not created from Insights Hub yet&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="p15c3" value="Columns are those of the Power BI model. The status says what the table needs. Group 2 = shift KPIs, run rate (decide later); group 3 = files that need an integration (Glidepaths, Format Mapping, Equipment Coding, Volume Loss Correction). Not analysed in the model: Handover, Shift Colours, Master Mode Comment and Full Site Shift Performance are read by visuals but are not tables of the template." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1500" height="44" as="geometry"/></mxCell><mxCell id="p15c4" value="&lt;b&gt;Run Rates EU&lt;/b&gt;&lt;br&gt;&lt;br&gt;Good parts and capacity per machine, shift and product&lt;br&gt;&lt;br&gt;Used on: no visual reads it directly&lt;br&gt;&lt;br&gt;&lt;b&gt;Decide later (group 2)&lt;/b&gt;&lt;br&gt;&lt;br&gt;SIH source: possible: evaluateKPIs hourly (KPI &amp;quot;Good parts&amp;quot;) and the design speed" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#eeeeee;strokeColor=#999999;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="480" height="200" as="geometry"/></mxCell><mxCell id="p15c5" value="AreaName  &lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;string&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="336" width="480" height="24" as="geometry"/></mxCell><mxCell id="p15c6" value="MachineName  &lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;string&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="364" width="480" height="24" as="geometry"/></mxCell><mxCell id="p15c7" value="Date  &lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;string&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="392" width="480" height="24" as="geometry"/></mxCell><mxCell id="p15c8" value="PartName  &lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;string&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="