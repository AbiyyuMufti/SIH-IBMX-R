/mxCell><mxCell id="p8c75" value="&lt;b&gt;Only Provideam&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="834" width="330" height="40" as="geometry"/></mxCell><mxCell id="p8c76" value="Run segments (time while running)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="330" height="40" as="geometry"/></mxCell><mxCell id="p8c77" value="Mode Log: rows with group Run" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="390" y="880" width="400" height="40" as="geometry"/></mxCell><mxCell id="p8c78" value="Not in fact_loss (stops only)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="810" y="880" width="400" height="40" as="geometry"/></mxCell><mxCell id="p8c79" value="&lt;b&gt;Only Provideam&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="880" width="330" height="40" as="geometry"/></mxCell><mxCell id="p8c80" value="MTTR, MTBF, TEEP, micro and macro stops" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="926" width="330" height="40" as="geometry"/></mxCell><mxCell id="p8c81" value="Not seen in the reports" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="390" y="926" width="400" height="40" as="geometry"/></mxCell><mxCell id="p8c82" value="fact_kpi columns" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="810" y="926" width="400" height="40" as="geometry"/></mxCell><mxCell id="p8c83" value="&lt;b&gt;Only Insights Hub&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="926" width="330" height="40" as="geometry"/></mxCell><mxCell id="p8c84" value="Targets (Glidepaths), Machine Names, Equipment Coding, Shift Pattern Naming, Format Mapping" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="972" width="330" height="40" as="geometry"/></mxCell><mxCell id="p8c85" value="Excel files kept by the site. Not made by Provideam" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="390" y="972" width="400" height="40" as="geometry"/></mxCell><mxCell id="p8c86" value="Not available" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="810" y="972" width="400" height="40" as="geometry"/></mxCell><mxCell id="p8c87" value="&lt;b&gt;Independent of both&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="972" width="330" height="40" as="geometry"/></mxCell><mxCell id="p8c88" value="&lt;b&gt;What this means for replacing Provideam&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="1038" width="1500" height="24" as="geometry"/></mxCell><mxCell id="p8c89" value="1. Overlap rows: Insights Hub can supply the data, but the numbers differ. On the overlap days the Insights Hub good parts are 96.6% (B2) and 43.6% (GT4) of the Provideam good parts. Reckitt must name the official source per site.&lt;br&gt;&lt;br&gt;2. Only Provideam: we need the Provideam files or the Provideam rules. Or Reckitt accepts that the column is empty (for example comment text).&lt;br&gt;&lt;br&gt;3. Excel files: they do not depend on the OEE source. We need them in every case.&lt;br&gt;&lt;br&gt;4. At a switch, the history in the report changes: Provideam numbers before the date, Insights Hub numbers after it." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1072" width="1520" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Not created yet" id="page9"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p9c2" value="&lt;b&gt;Power BI tables not created from Insights Hub yet&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="p9c3" value="Columns are those of the Power BI model. The status says what the table needs. Group 2 = shift KPIs, run rate (decide later); group 3 = Glidepaths targets (needs file integration) and correction files (waits for Reckitt). Not analysed in the model: Handover, Shift Colours, Master Mode Comment and Full Site Shift Performance are read by visuals but are not tables of the template." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1500" height="44" as="geometry"/></mxCell><mxCell id="p9c4" value="&lt;b&gt;Run Rates EU&lt;/b&gt;&lt;br&gt;&lt;br&gt;Good parts and capacity per machine, shift and product&lt;br&gt;&lt;br&gt;Used on: no visual reads it directly&lt;br&gt;&lt;br&gt;&lt;b&gt;Decide later (group 2)&lt;/b&gt;&lt;br&gt;&lt;br&gt;SIH source: possible: evaluateKPIs hourly (KPI &amp;quot;Good parts&amp;quot;) and the design speed" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#eeeeee;strokeColor=#999999;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="480" height="200" as="geometry"/></mxCell><mxCell id="p9c5" value="AreaName  &lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;string&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="336" width="480" height="24" as="geometry"/></mxCell><mxCell id="p9c6" value="MachineName  &lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;string&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="364" width="480" height="24" as="geometry"/></mxCell><mxCell id="p9c7" value="Date  &lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;string&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="392" width="480" height="24" as="geometry"/></mxCell><mxCell id="p9c8" value="PartName  &lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;string&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="480" height="24" as="geometry"/></mxCell><mxCell id="p9c9" value="ShiftName  &lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;string&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="448" width="480" height="24" as="geometry"/></mxCell><mxCell id="p9c10" value="Good Parts  &lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;int64&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="476" width="480" height="24" as="geometry"/></mxCell><mxCell id="p9c11" value="Capacity  &lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;int64&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="504" width="480" height="24" as="geometry"/></mxCell><mxCell id="p9c12" value="SiteName  &lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;string&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="532" width="480" height="24" as="geometry"/></mxCell><mxCell id="p9c13" value="Unique Machine Name  &lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;string&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="480" height="24" as="geometry"/></mxCell><mxCell id="p9c14" value="Product Key  &lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;string&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="588" width="480" height="24" as="geometry"/></mxCell><mxCell id="p9c15" value="Good Parts - Copy  &lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;int64&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="616" width="480" height="24" as="geometry"/></mxCell><mxCell id="p9c16" value="Batch ID  &lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;string&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="644" width="480" height="24" as="geometry"/></mxCell><mxCell id="p9c17" value="&lt;b&gt;Volume CoV EU&lt;/b&gt;&lt;br&gt;&lt;br&gt;Per shift and machine: good parts sum and capacity max (volume variation)&lt;br&gt;&lt;br&gt;Used on: no visual reads it directly&lt;br&gt;&lt;br&gt;&lt;b&gt;Decide later (group 2)&lt;/b&gt;&lt;br&gt;&lt;br&gt;SIH source: possible: evaluateKPIs per shift" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#eeeeee;strokeColor=#999999;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="550" y="130" width="480" height="200" as="geometry"/></mxCell><mxCell id="p9c18" value="Date  &lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;dateTime&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2