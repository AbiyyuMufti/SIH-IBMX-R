        <mxCell id="p14c64" value="Same rule (minutes x capacity per minute: 2,341 of 2,349 machine-days within 3%). Differs only if the speed differs" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;fontSize=10;" vertex="1" parent="1">
