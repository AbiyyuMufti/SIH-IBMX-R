          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2c12" value="&lt;b&gt;ASSUMPTION&lt;/b&gt;&lt;br&gt;Production day 06:00 to 06:00 UTC. Power BI local copy: calendar date. Not crucial: a window setting plus a backfill." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=4;fontSize=10.5;" parent="1" vertex="1">
