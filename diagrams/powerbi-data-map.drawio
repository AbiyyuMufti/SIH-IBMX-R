arent="1"><mxGeometry x="380" y="782" width="280" height="40" as="geometry"/></mxCell><mxCell id="p2c47" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#d79b00;" edge="1" parent="1" source="p2c43" target="p2c45"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2c48" value="&lt;b&gt;ASSUMPTION + PARTLY FILLED 83%&lt;/b&gt;&lt;br&gt;Assumption: design speed per minute x planned minutes. In the Power BI local copy the speed is constant for only 56% of machine/part pairs. Must be clarified." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=4;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="700" y="740" width="600" height="82" as="geometry"/></mxCell><mxCell id="p2c49" value="&lt;b&gt;Total Time&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;int64&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="280" height="38" as="geometry"/></mxCell><mxCell id="p2c50" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;e.g. 480&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="872" width="280" height="40" as="geometry"/></mxCell><mxCell id="p2c51" value="&lt;b&gt;total_time&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;Float64, 100% filled&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=m