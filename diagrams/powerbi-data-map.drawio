        <mxCell id="p17c2" value="&lt;b&gt;Plan: ih_report and pbi_report in the data lake (eu_report)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=18;" parent="1" vertex="1">
