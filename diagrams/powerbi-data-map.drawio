vertex="1" parent="1"><mxGeometry x="550" y="845" width="90" height="36" as="geometry"/></mxCell><mxCell id="p0c37" value="0 with gaps" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="645" y="845" width="90" height="36" as="geometry"/></mxCell><mxCell id="p0c38" value="1 assumption" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="740" y="845" width="90" height="36" as="geometry"/></mxCell><mxCell id="p0c39" value="0 empty / missing" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="835" y="845" width="90" height="36" as="geometry"/></mxCell><mxCell id="p0c40" value="0 not needed" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#eeeeee;strokeColor=#999999;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="930" y="845" width="90" height="36" as="geometry"/></mxCell><mxCell id="p0c41" value="&lt;b&gt;Calendar&lt;/b&gt;  -&gt;  &lt;b&gt;pbi_calendar&lt;/b&gt;&lt;br&gt;&lt;br&gt;Holds: Date table generated in Power BI&lt;br&gt;&lt;br&gt;One row is: One row per date&lt;br&gt;&lt;br&gt;Insights Hub table: 122 rows, 11 columns (Hull, downloaded 2026-10-13)&lt;br&gt;&lt;br&gt;Used on pages: EU-Level Overview, Site-Level Overview, L2/L3 FIT View, Planned Losses, Unplanned Losses, Maintenance (BETA), Loss Trending, By Shift, By Format, OEE Trending (some through measures)&lt;br&gt;&lt;br&gt;Columns in Power BI: 11" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=8;fillColor=#ffffff;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1060" y="565" width="480" height="270" as="geometry"/></mxCell><mxCell id="p0c42" value="11 OK" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1060" y="845" width="90" height="36" as="geometry"/></mxCell><mxCell id="p0c43" value="0 with gaps" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1155" y="845" width="90" height="36" as="geometry"/></mxCell><mxCell id="p0c44" value="0 assumption" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1250" y="845" width="90" height="36" as="geometry"/></mxCell><mxCell id="p0c45" value="0 empty / missing" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1345" y="845" width="90" height="36" as="geometry"/></mxCell><mxCell id="p0c46" value="0 not needed" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#eeeeee;strokeColor=#999999;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1440" y="845" width="90" height="36" as="geometry"/></mxCell><mxCell id="p0c47" value="&lt;b&gt;How the report joins the tables (from the model)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="925" width="1500" height="24" as="geometry"/></mxCell><mxCell id="p0c48" value="&lt;b&gt;Machine key&lt;/b&gt;: every fact table joins to Machine Names EU on Unique Machine Name (hidden key, never shown). Power BI local copy = machine-site text; Insights Hub = asset ID. Decision open.&lt;br&gt;&lt;br&gt;&lt;b&gt;Product key&lt;/b&gt;: Plan OPT, Daily Losses and Run Rates join to the product master (Format List EU). Power BI local copy key = machine + part name; Insights Hub = product code. Own product table decided 2026-10-13.&lt;br&gt;&lt;br&gt;&lt;b&gt;Shift&lt;/b&gt;: every fact table joins to Shift Naming EU on the shift name. All Insights Hub shift names must exist there.&lt;br&gt;&lt;br&gt;&lt;b&gt;Date&lt;/b&gt;: every fact table joins to Calendar on the date (Daily Losses: on the shift start date)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="959" width="1500" height="120" as="geometry"/></mxCell><mxCell id="p0c49" value="&lt;b&gt;Power BI tables not created from Insights Hub yet: 7 shown in the Data pane + 3 hidden supporting tables (columns on the last page)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="1115" width="1500" height="24" as="geometry"/></mxCell><mxCell id="p0c50" value="The Data pane of the Power BI local copy shows 14 tables: the 6 above, the 7 below and Measures Table (calculations only, no data). The model also has 39 hidden staging tables (regional copies N, H, W, M, Provideam) that feed the EU tables. 3 of them are listed here because they feed Daily Losses." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1143" width="1500" height="36" as="geometry"/></mxCell><mxCell id="p0c51" value="&lt;b&gt;Run Rates EU&lt;/b&gt;&lt;br&gt;&lt;br&gt;Good parts and capacity per machine, shift and product&lt;br&gt;&lt;br&gt;12 columns. Used on: no visual reads it directly&lt;br&gt;&lt;br&gt;&lt;b&gt;Decide later (group 2)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#eeeeee;strokeColor=#999999;verticalAlign=top;spacingTop=8;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="1199" width="355" height="170" as="geometry"/></mxCell><mxCell id="p0c52" value="&lt;b&gt;Volume CoV EU&lt;/b&gt;&lt;br&gt;&lt;br&gt;Per shift and machine: good parts sum and capacity max (volume variation)&lt;br&gt;&lt;br&gt;7 columns. Used on: no visual reads it directly&lt;br&gt;&lt;br&gt;&lt;b&gt;Decide later (group 2)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#eeeeee;strokeColor=#999999;verticalAlign=top;spacingTop=8;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="415" y="1199" width="355" height="170" as="geometry"/></mxCell><mxCell id="p0c53" value="&lt;b&gt;Format List EU&lt;/b&gt;&lt;br&gt;&lt;br&gt;Product master: brand, unit size, unit count per machine and product&lt;br&gt;&lt;br&gt;8 columns. Used on: By Format&lt;br&gt;&lt;br&gt;&lt;b&gt;Own product table decided (2026-10-13)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=8;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="790" y="1199" width="355" height="170" as="geometry"/></mxCell><mxCell id="p0c54" value="&lt;b&gt;Targets Losses EU&lt;/b&gt;&lt;br&gt;&lt;br&gt;Monthly loss target per machine and loss subgroup&lt;br&gt;&lt;br&gt;3 columns. Used on: no visual reads it directly&lt;br&gt;&lt;br&gt;&lt;b&gt;Waits for Reckitt (Glidepaths)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacingTop=8;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1165" y="1199" width="355" height="170" as="geometry"/></mxCell><mxCell id="p0c55" value="&lt;b&gt;OEE Targets EU&lt;/b&gt;&lt;br&gt;&lt;br&gt;Monthly OEE target per line&lt;br&gt;&lt;br&gt;6 columns. Used on: no visual reads it directly&lt;br&gt;&lt;br&gt;&lt;b&gt;Waits for Reckitt (Glidepaths)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacingTop=8;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="1389" width="355" height="170" as="geometry"/></mxCell><mxCell id="p0c56" value="&lt;b&gt;PDT Targets EU&lt;/b&gt;&lt;br&gt;&lt;br&gt;Monthly planned downtime target per line&lt;br&gt;&lt;br&gt;6 columns. Used on: no visual reads it directly&lt;br&gt;&lt;br&gt;&lt;b&gt;Waits for Reckitt (Glidepaths)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacingTop=8;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="415" y="1389" width="355" height="170" as="geometry"/></mxCell><mxCell id="p0c57" value="&lt;b&gt;UPDT Targets EU&lt;/b&gt;&lt;br&gt;&lt;br&gt;Monthly unplanned downtime target per line&lt;br&gt;&lt;br&gt;7 columns. Used on: no visual reads it directly&lt;br&gt;&lt;br&gt;&lt;b&gt;Waits for Reckitt (Glidepaths)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacingTop=8;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="790" y="1389" width="355" height="170" as="geometry"/></mxCell><mxCell id="p0c58" value="&lt;b&gt;Equipment Coding (N, H, W)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Maps a loss key to an equipment name&lt;br&gt;&lt;br&gt;3 columns. Used on: no visual reads it directly&lt;br&gt;&lt;br&gt;&lt;b&gt;Waits for Reckitt files&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hidden table: not shown in the Data pane" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacingTop=8;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1165" y="1389" width="355" height="170" as="geometry"/></mxCell><mxCell id="p0c59" value="&lt;b&gt;Volume Loss Correction (N, H, W)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Corrects loss units by machine, loss group and time (rule not known)&lt;br&gt;&lt;br&gt;10 columns. Used on: no visual reads it directly&lt;br&gt;&lt;br&gt;&lt;b&gt;Waits for Reckitt files&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hidden table: not shown in the Data pane" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacingTop=8;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="1579" width="355" height="170" as="geometry"/></mxCell><mxCell id="p0c60" value="&lt;b&gt;Targets Volume (N, H, W, M)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Monthly good-parts volume per machine (weight for the targets)&lt;br&gt;&lt;br&gt;2 columns. Used on: no visual reads it directly&lt;br&gt;&lt;br&gt;&lt;b&gt;Waits for Reckitt files&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hidden table: not shown in the Data pane" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacingTop=8;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="415" y="1579" width="355" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 Machine Names EU" id="page1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1c2" value="&lt;b&gt;Machine Names EU  -&amp;gt;  pbi_machine_names&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="p1c3" value="Holds: List of lines (Excel per site). One row is: One row per machine.&lt;br&gt;Insights Hub table: 2 rows, 7 columns. Only the machines of the Config tab (Hull: 2). The Power BI local copy lists 76 machines of all sites.&lt;br&gt;Used on pages: EU-Level Overview, Site-Level Overview, L2/L3 FIT View, Planned Losses, Unplanned Losses, Maintenance (BETA), Loss Trending, By Shift, By Format, OEE Trending (some through measures)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1260" height="96" as="geometry"/></mxCell><mxCell id="p1c4" value="&lt;b&gt;Power BI column&lt;/b&gt; (blue) and example (below it)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="172" width="270" height="20" as="geometry"/></mxCell><mxCell id="p1c5" value="&lt;b&gt;Insights Hub column&lt;/b&gt; and example (below it)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="172" width="270" height="20" as="geometry"/></mxCell><mxCell id="p1c6" value="&lt;b&gt;Difference&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="172" width="600" height="20" as="geometry"/></mxCell><mxCell id="p1c7" value="&lt;b&gt;MachineName&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;string, used on 10 pages&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="280" height="38" as="geometry"/></mxCell><mxCell id="p1c8" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;e.g. S06&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="242" width="280" height="40" as="geometry"/></mxCell><mxCell id="p1c9" value="&lt;b&gt;machine_name&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;String, 100% filled&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="380" y="200" width="280" height="38" as="geometry"/></mxCell><mxCell id="p1c10" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;e.g. B2 Line | GT4&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="380" y="242" width="280" height="40" as="geometry"/></mxCell><mxCell id="p1c11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#82b366;" edge="1" parent="1" source="p1c7" target="p1c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1c12" value="&lt;b&gt;OK&lt;/b&gt;&lt;br&gt;Direct. Name is set in Insights Hub setup; align asset names with Reckitt names during setup." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=4;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="700" y="200" width="600" height="82" as="geometry"/></mxCell><mxCell id="p1c13" value="&lt;b&gt;Dept&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;string, used on 10 pages&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="280" height="38" as="geometry"/></mxCell><mxCell id="p1c14" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;e.g. Strepsils&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="332" width="280" height="40" as="geometry"/></mxCell><mxCell id="p1c15" value="&lt;b&gt;dept&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;String, 100% filled&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="380" y="290" width="280" height="38" as="geometry"/></mxCell><mxCell id="p1c16" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;e.g. Bottles | Blisters&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="380" y="332" width="280" height="40" as="geometry"/></mxCell><mxCell id="p1c17" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#d79b00;" edge="1" parent="1" source="p1c13" target="p1c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1c18" value="&lt;b&gt;ASSUMPTION&lt;/b&gt;&lt;br&gt;Insights Hub has no department: the area is used (same value as Area and Product Type). Power BI local copy: Liquids Pack / Dries Pack for Hull." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=4;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="700" y="290" width="600" height="82" as="geometry"/></mxCell><mxCell id="p1c19" value="&lt;b&gt;Area&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;string&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="280" height="38" as="geometry"/></mxCell><mxCell id="p1c20" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;e.g. Strepsils Packing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="422" width="280" height="40" as="geometry"/></mxCell><mxCell id="p1c21" value="&lt;b&gt;area&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;String, 100% filled&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="380" y="380" width="280" height="38" as="geometry"/></mxCell><mxCell id="p1c22" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;e.g. Bottles | Blisters&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="380" y="422" width="280" height="40" as="geometry"/></mxCell><mxCell id="p1c23" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#d79b00;" edge="1" parent="1" source="p1c19" target="p1c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1c24" value="&lt;b&gt;ASSUMPTION&lt;/b&gt;&lt;br&gt;Insights Hub area names (Bottles, Blisters), also used for Dept and Product Type. Power BI local copy: Liquids / Dries for Hull. Accepted for now." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=4;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="700" y="380" width="600" height="82" as="geometry"/></mxCell><mxCell id="p1c25" value="&lt;b&gt;Product Type&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;string, used on 4 pages&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="280" height="38" as="geometry"/></mxCell><mxCell id="p1c26" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;e.g. Strepsils Blisters&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="512" width="280" height="40" as="geometry"/></mxCell><mxCell id="p1c27" value="&lt;b&gt;product_type&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;String, 100% filled&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"