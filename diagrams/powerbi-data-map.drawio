          <mxGeometry x="1230" y="330" width="330" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p7c32" value="8 Unplanned Loss vs Target (%) and by Site" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1">
