op=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="396" width="330" height="54" as="geometry"/></mxCell><mxCell id="p7c21" value="&lt;b&gt;Daily Losses EU [Target]&lt;/b&gt;&lt;br&gt;Value / 100" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="462" width="330" height="54" as="geometry"/></mxCell><mxCell id="p7c22" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p7c9" target="p7c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c23" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p7c10" target="p7c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c24" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p7c11" target="p7c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c25" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p7c12" target="p7c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c26" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p7c20" target="p7c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c27" value="1 OEE % (Europe): gauge with target" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="170" width="330" height="34" as="geometry"/></mxCell><mxCell id="p7c28" value="4 OEE % by Site" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="210" width="330" height="34" as="geometry"/></mxCell><mxCell id="p7c29" value="3 Planned Loss %" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="250" width="330" height="34" as="geometry"/></mxCell><mxCell id="p7c30" value="7 Planned Loss vs Target (%) and by Site" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="290" width="330" height="34" as="geometry"/></mxCell><mxCell id="p7c31" value="2 Unplanned Loss %" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="330" width="330" height="34" as="geometry"/></mxCell><mxCell id="p7c32" value="8 Unplanned Loss vs Target (%) and by Site" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="370" width="330" height="34" as="geometry"/></mxCell><mxCell id="p7c33" value="5 Top 5 Loss Categories (also needs Volume Total)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="470" width="330" height="34" as="geometry"/></mxCell><mxCell id="p7c34" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="p7c17" target="p7c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c35" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="p7c17" target="p7c28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c36" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="p7c19" target="p7c31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c37" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="p7c19" target="p7c32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c38" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="p7c18" target="p7c29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c39" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="p7c18" target="p7c30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c40" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="p7c21" target="p7c33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c41" value="Not from Glidepaths: Volume Total in Daily Losses comes from the Targets Volume table. The Hull query sums the Capacity per machine and day of the Plan OPT files, so Insights Hub can build it. Visual 5 weights its target with it." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#eeeeee;strokeColor=#999999;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="830" y="530" width="730" height="54" as="geometry"/></mxCell><mxCell id="p7c42" value="&lt;b&gt;How one stop finds its target (Daily Losses): the texts must be equal&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1500" height="24" as="geometry"/></mxCell><mxCell id="p7c43" value="&lt;b&gt;1 A stop in our Insights Hub data&lt;/b&gt;&lt;br&gt;Machine: B2 Line&lt;br&gt;Loss sub group: Process Failure (our values: Unplanned Downtime | Process Failure | Measurement and adjustment)&lt;br&gt;Date: 2026-10-05&lt;br&gt;Sub group is filled for 35% of the stops only." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="330" height="168" as="geometry"/></mxCell><mxCell id="p7c44" value="&lt;b&gt;2 The report builds a key&lt;/b&gt;&lt;br&gt;&lt;br&gt;Loss Target Key = machine + loss sub group + month&lt;br&gt;&lt;br&gt;B2 Line Process Failure 01/10/2026" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="430" y="660" width="330" height="168" as="geometry"/></mxCell><mxCell id="p7c45" value="&lt;b&gt;3 It looks for the same text in the file&lt;/b&gt;&lt;br&gt;&lt;br&gt;Loss Key = &amp;lt;Line&amp;gt;-&amp;lt;Site&amp;gt; + OEE Bucket + month&lt;br&gt;&lt;br&gt;Example (layout only): &amp;lt;line&amp;gt;-Hull &amp;lt;OEE Bucket&amp;gt; 01/10/2026&lt;br&gt;&lt;br&gt;The category name comes from the file. We do not know it yet." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="830" y="660" width="330" height="168" as="geometry"/></mxCell><mxCell id="p7c46" value="&lt;b&gt;Texts are equal&lt;/b&gt;&lt;br&gt;The stop gets Value and Target." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="660" width="330" height="66" as="geometry"/></mxCell><mxCell id="p7c47" value="&lt;b&gt;Texts differ&lt;/b&gt;&lt;br&gt;Value and Target stay empty for this stop." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="744" width="330" height="66" as="geometry"/></mxCell><mxCell id="p7c48" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="p7c43" target="p7c44"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c49" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="p7c44" target="p7c45"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c50" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#82b366;" edge="1" parent="1" source="p7c45" target="p7c46"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c51" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="p7c45" target="p7c47"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c52" value="&lt;b&gt;What can make the texts differ&lt;/b&gt;&lt;br&gt;1. Machine name: the file may write &amp;quot;B2 Auto&amp;quot; where Insights Hub says &amp;quot;B2 Line&amp;quot;. Fix: a mapping of names.&lt;br&gt;2. Loss category name: our sub group is a stand-in (the top level of the reason tree). The file has its own category names. Fix: a mapping from our reason names to their categories.&lt;br&gt;3. Month text: the report writes the month as text (for example 01/10/2026). Both sides must use the same format.&lt;br&gt;Insights Hub numbers stay correct in all three cases. Only the target values stay empty." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="1520" height="130" as="geometry"/></mxCell><mxCell id="p7c53" value="&lt;b&gt;How the report makes the loss names equal to the glidepath buckets: 17 text rules in the Hull query&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="1500" height="24" as="geometry"/></mxCell><mxCell id="p7c54" value="Breakdown - Mechanical  -&amp;gt;  Breakdown&lt;br&gt;Breakdown - Electrical  -&amp;gt;  Breakdown&lt;br&gt;Adjustments  -&amp;gt;  Adjustment&lt;br&gt;Breaks and Meal  -&amp;gt;  Meals &amp;amp; Breaks&lt;br&gt;Lack of resources  -&amp;gt;  Lack of Resource&lt;br&gt;Adjustment  -&amp;gt;  Adjustments&lt;br&gt;Start-Up/End-Up &amp;amp; Sanitization  -&amp;gt;  Start up and Sanitisation&lt;br&gt;In Process Quality Control  -&amp;gt;  In Process Quality&lt;br&gt;Lack Of Resource  -&amp;gt;  Lack Of Resources" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=8;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="1040" width="740" height="183" as="geometry"/></mxCell><mxCell id="p7c55" value="Meals &amp;amp; Breaks  -&amp;gt;  Breaks / Meals&lt;br&gt;Minor Stop  -&amp;gt;  Minor Stops&lt;br&gt;Other  -&amp;gt;  Others&lt;br&gt;Product Change Over  -&amp;gt;  Product Changeover&lt;br&gt;Start Up And Sanitisation  -&amp;gt;  Start up and Sanitisation&lt;br&gt;Lack Of Resourcess  -&amp;gt;  Lack Of Resources&lt;br&gt;Operater Asset Care  -&amp;gt;  Operator Asset Care&lt;br&gt;Beakdown - Mechanical  -&amp;gt;  Breakdown" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=8;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="800" y="1040" width="760" height="183" as="geometry"/></mxCell><mxCell id="p7c56" value="&lt;b&gt;Insights Hub sub groups (10,100 stops of the Hull lake files)&lt;/b&gt;&lt;br&gt;&lt;br&gt;(empty): 6,598   |   Unplanned Downtime: 3,352   |   Process Failure: 73   |   Measurement and adjustment: 52   |   Breakdown: 18   |   Quality Issues: 4   |   Lack of resources: 2   |   Other: 1&lt;br&gt;&lt;br&gt;Only 22 stops have a sub group that equals a bucket. The report rules above work on Provideam names, not on these. A mapping from the Insights Hub reason to the bucket is needed." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=8;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="1243" width="1520" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Explanation Format List" id="page8"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p8c2" value="&lt;b&gt;Format List: from the Format Mapping files to the By Format page&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="p8c3" value="Purple = needs the Format Mapping files (checked 2026-10-14 on the Hull file). Blue = Power BI page. Which page uses which column comes from the Power BI report file. Insights Hub has no brand, size or count: only the product name, code, description and design speed." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1520" height="62" as="geometry"/></mxCell><mxCell id="p8c4" value="&lt;b&gt;1 Source file&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="330" height="20" as="geometry"/></mxCell><mxCell id="p8c5" value="&lt;b&gt;2 Table in the report&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="140" width="330" height="20" as="geometry"/></mxCell><mxCell id="p8c6" value="&lt;b&gt;3 Columns it fills&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="140" width="330" height="20" as="geometry"/></mxCell><mxCell id="p8c7" value="&lt;b&gt;4 Where they are used&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1230" y="140" width="330" height="20" as="geometry"/></mxCell><mxCell id="p8c8" value="&lt;b&gt;Format Mapping files&lt;/b&gt;&lt;br&gt;&lt;br&gt;SharePoint, Nottingham site, regional folder. Kept by hand: one file per site (Hull, Mira, Weinheim).&lt;br&gt;&lt;br&gt;Columns: Site Name | MachineName | Product Name | Brand | Unit Size | Unit Count/Format | Extra Info&lt;br&gt;&lt;br&gt;Hull file: 286 rows, 25 machines, 188 products.&lt;br&gt;&lt;br&gt;Example (GT4): 250 mg tablets - Pep 24's | G. Standard - Dries | 250 mg | 24's | Peppermint" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="330" height="300" as="geometry"/></mxCell><mxCell id="p8c9" value="&lt;b&gt;Format List EU&lt;/b&gt;&lt;br&gt;Product Name, Brand, Unit Size, MachineName, Product Key, Unit Count/Format, Extra Info, Site Name&lt;br&gt;Product Key = machine name + site + product name (built by the report)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="430" y="170" width="330" height="94" as="geometry"/></mxCell><mxCell id="p8c10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p8c8" target="p8c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8c11" value="&lt;b&gt;Format List EU [Brand, Unit Size, Unit Count/Format, Extra Info]&lt;/b&gt;&lt;br&gt;looked up by Product Key" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="170" width="330" height="62" as="geometry"/></mxCell><mxCell id="p8c12" value="&lt;b&gt;Used by the relationships&lt;/b&gt;&lt;br&gt;Plan OPT EU [Product Key] and Daily Losses EU [Product Key] join to Format List EU [Product Key]" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="242" width="330" height="62" as="geometry"/></mxCell><mxCell id="p8c13" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p8c9" target="p8c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8c14" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p8c9" target="p8c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8c15" value="Pages that use the format columns: By Format" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="170" width="330" height="70" as="geometry"/></mxCell><mxCell id="p8c16" value="Without a match the product has no brand, size or count (empty values)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="248" width="330" height="70" as="geometry"/></mxCell><mxCell id="p8c17" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="p8c11" target="p8c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8c18" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="p8c12" target="p8c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8c19" value="&lt;b&gt;How one product finds its format: the product texts must be equal&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="1500" height="24" as="geometry"/></mxCell><mxCell id="p8c20" value="&lt;b&gt;1 A product in the Insights Hub data&lt;/b&gt;&lt;br&gt;&lt;br&gt;Machine: GT4&lt;br&gt;&lt;br&gt;Part name: 250 mg tablets - Pep 24's&lt;br&gt;&lt;br&gt;Machine B2 Line, part name: NURFN,BG,CHILD,ORG,12X100ML" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="330" height="168" as="geometry"/></mxCell><mxCell id="p8c21" value="&lt;b&gt;2 The report builds a key&lt;/b&gt;&lt;br&gt;&lt;br&gt;Product Key = machine name + site + product name&lt;br&gt;&lt;br&gt;GT4-Hull 250 mg tablets - Pep 24's" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="430" y="540" width="330" height="168" as="geometry"/></mxCell><mxCell id="p8c22" value="&lt;b&gt;3 It looks for the same text in the file&lt;/b&gt;&lt;br&gt;&lt;br&gt;GT4-Hull 250 mg tablets - Pep 24's&lt;br&gt;&lt;br&gt;-&amp;gt; Brand G. Standard - Dries, size 250 mg, count 24's&lt;br&gt;&lt;br&gt;B2 products in the file have short names, for example DT COUGH 100x6" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="830" y="540" width="330" height="168" as="geometry"/></mxCell><mxCell id="p8c23" value="&lt;b&gt;Texts are equal&lt;/b&gt;&lt;br&gt;GT4: 13 of 13 Insights Hub part names are in the file." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="540" width="330" height="76" as="geometry"/></mxCell><mxCell id="p8c24" value="&lt;b&gt;Texts differ&lt;/b&gt;&lt;br&gt;B2 Line: 0 of 27. Insights Hub has SAP-style descriptions, the file has short names." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="632" width="330" height="76" as="geometry"/></mxCell><mxCell id="p8c25" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="p8c20" target="p8c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8c26" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="p8c21" target="p8c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8c27" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#82b366;" edge="1" parent="1" source="p8c22" target="p8c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8c28" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="p8c22" target="p8c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8c29" value="&lt;b&gt;What can make the texts differ or the file fail&lt;/b&gt;&lt;br&gt;1. B2 names: Insights Hub part names (for example NURFN,BG,CHILD,ORG,12X100ML) do not exist in the file. Provideam B2 names in the last 4 months: NFC 12 X 100ML, NFC 12 X 100ML with 2D, NFC 12 X 100ML with Spoon or Integrated, NFC 12 X 200ML with 2D, NFC 6 X 100ML. Fix: a mapping table from the Insights Hub product code to the Provideam product name.&lt;br&gt;2. The file is not complete: 111 of 178 (machine, part) pairs of the Hull Plan OPT files are in the Hull list (62%). New products need a new row by hand.&lt;br&gt;3. The key uses the Provideam machine name (B2 Auto) and the site suffix. Insights Hub says B2 Line. Fix: a mapping of machine names." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="728" width="1520" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Explanation Shift names" id="page9"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p9c2" value="&lt;b&gt;Shift names: from the Shift Pattern file to the shift selector&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="p9c3" value="Purple = needs the Shift Pattern file (checked 2026-10-14). Blue = Power BI visual or page. The report shows the mapped Shift value (Day, Night, Afternoon or the crew colour), not the raw Provideam shift name." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1520" height="62" as="geometry"/></mxCell><mxCell id="p9c4" value="&lt;b&gt;1 Source file&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="330" height="20" as="geometry"/></mxCell><mxCell id="p9c5" value="&lt;b&gt;2 Table in the report&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="140" width="330" height="20" as="geometry"/></mxCell><mxCell id="p9c6" value="&lt;b&gt;3 Columns it fills&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="140" width="330" height="20" as="geometry"/></mxCell><mxCell id="p9c7" value="&lt;b&gt;4 Where they are used&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1230" y="140" width="330" height="20" as="geometry"/></mxCell><mxCell id="p9c8" value="&lt;b&gt;Shift Pattern file&lt;/b&gt;&lt;br&gt;&lt;br&gt;SharePoint, Nottingham site, regional folder. Kept by hand: one file for all sites.&lt;br&gt;&lt;br&gt;Columns: ShiftName (raw) | Shift&lt;br&gt;&lt;br&gt;188 rows, 7 Shift values: Afternoon, Blue, Day, Gold, Green, Night, Red.&lt;br&gt;&lt;br&gt;Examples: Fri Afternoon -&amp;gt; Afternoon; SunDay - Blue -&amp;gt; Blue; FriDay -&amp;gt; Day; SunNight - Gold -&amp;gt; Gold; FriDay - Green -&amp;gt; Green" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="330" height="300" as="geometry"/></mxCell><mxCell id="p9c9" value="&lt;b&gt;Shift Naming Provideam (hidden)&lt;/b&gt;&lt;br&gt;Shift, Shift Type (= raw ShiftName)&lt;br&gt;joined to every Plan OPT and loss row on the raw shift name" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="430" y="170" width="330" height="94" as="geometry"/></mxCell><mxCell id="p9c10" value="&lt;b&gt;Shift Naming EU&lt;/b&gt;&lt;br&gt;Shift&lt;br&gt;the list of shift values; fact tables join to it" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="430" y="274" width="330" height="94" as="geometry"/></mxCell><mxCell id="p9c11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p9c8" target="p9c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p9c12" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p9c8" target="p9c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p9c13" value="&lt;b&gt;Plan OPT EU [ShiftName]&lt;/b&gt;&lt;br&gt;the raw name is dropped, the mapped value is kept" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="170" width="330" height="62" as="geometry"/></mxCell><mxCell id="p9c14" value="&lt;b&gt;Daily Losses EU [ShiftName]&lt;/b&gt;&lt;br&gt;same mapping" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="242" width="330" height="62" as="geometry"/></mxCell><mxCell id="p9c15" value="&lt;b&gt;Shift Naming EU [Shift]&lt;/b&gt;&lt;br&gt;relationship target of both" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="314" width="330" height="62" as="geometry"/></mxCell><mxCell id="p9c16" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p9c9" target="p9c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p9c17" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p9c9" target="p9c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p9c18" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p9c10" target="p9c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p9c19" value="16 Shift Name selector (EU-Level Overview)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="170" width="330" height="38" as="geometry"/></mxCell><mxCell id="p9c20" value="Pages: EU-Level Overview, Site-Level Overview, L2/L3 FIT View, Planned Losses, Unplanned Losses, Maintenance (BETA), Loss Trending, By Shift, By Format, OEE Trending" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="216" width="330" height="70" as="geometry"/></mxCell><mxCell id="p9c21" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="p9c15" target="p9c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p9c22" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="p9c15" target="p9c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p9c23" value="&lt;b&gt;How one shift finds its value: the raw name must be in the file&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="1500" height="24" as="geometry"/></mxCell><mxCell id="p9c24" value="&lt;b&gt;1 A shift in the Insights Hub data&lt;/b&gt;&lt;br&gt;&lt;br&gt;Calendar event names: Blue, Gold, Green, Red, Shift 1, Shift 2, Yellow&lt;br&gt;&lt;br&gt;Hull and GT4 shifts are events of the Insights Hub calendar" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="330" height="168" as="geometry"/></mxCell><mxCell id="p9c25" value="&lt;b&gt;2 The report needs a Shift value&lt;/b&gt;&lt;br&gt;&lt;br&gt;Plan OPT EU [ShiftName] must be one of the Shift values&lt;br&gt;&lt;br&gt;Afternoon, Blue, Day, Gold, Green, Night, Red" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="430" y="540" width="330" height="168" as="geometry"/></mxCell><mxCell id="p9c26" value="&lt;b&gt;3 Provideam side (file)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Raw names of the Hull Plan OPT files: 105. In the file: 105 (all).&lt;br&gt;&lt;br&gt;Example: SunDay - Blue -&amp;gt; Blue" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="830" y="540" width="330" height="168" as="geometry"/></mxCell><mxCell id="p9c27" value="&lt;b&gt;Names are equal&lt;/b&gt;&lt;br&gt;Blue, Gold, Green, Red exist as Shift values." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="540" width="330" height="76" as="geometry"/></mxCell><mxCell id="p9c28" value="&lt;b&gt;Names differ&lt;/b&gt;&lt;br&gt;Shift 1, Shift 2, Yellow are not in the list. Day, Night and Afternoon are not Insights Hub names." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="632" width="330" height="76" as="geometry"/></mxCell><mxCell id="p9c29" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="p9c24" target="p9c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p9c30" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="p9c25" target="p9c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p9c31" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#82b366;" edge="1" parent="1" source="p9c26" target="p9c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p9c32" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="p9c26" target="p9c28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p9c33" value="&lt;b&gt;What can make the texts differ or the file fail&lt;/b&gt;&lt;br&gt;1. Insights Hub shift names Yellow, Shift 1 and Shift 2 have no Shift value. Fix: a mapping from the Insights Hub shift to a Shift value, or new rows in the file.&lt;br&gt;2. The report uses Day, Night and Afternoon for 8 hour shifts and the crew colour for 12 hour crews. Insights Hub names the 12 hour crews. Fix: one rule for both systems.&lt;br&gt;3. A new raw Provideam name needs a new row in the file by hand. Without it the row has no shift (null)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="728" width="1520" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Explanation Machine Names" id="page10"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p10c2" value="&lt;b&gt;Machine Names: from the Machine Names files to the selectors&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="p10c3" value="Purple = needs the Machine Names files. Hull file: NOT downloaded (no access to the folder). Nottingham and Weinheim files were downloaded and checked (same 4 columns). The local copy sample has 29 Hull rows. Blue = Power BI visual or page." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1520" height="62" as="geometry"/></mxCell><mxCell id="p10c4" value="&lt;b&gt;1 Source file&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="330" height="20" as="geometry"/></mxCell><mxCell id="p10c5" value="&lt;b&gt;2 Table in the report&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="140" width="330" height="20" as="geometry"/></mxCell><mxCell id="p10c6" value="&lt;b&gt;3 Columns it fills&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="140" width="330" height="20" as="geometry"/></mxCell><mxCell id="p10c7" value="&lt;b&gt;4 Where they are used&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1230" y="140" width="330" height="20" as="geometry"/></mxCell><mxCell id="p10c8" value="&lt;b&gt;Machine Names files&lt;/b&gt;&lt;br&gt;&lt;br&gt;SharePoint, one folder per site. Kept by hand. The guide says a new line needs a row here (required); a line is removed with a filter.&lt;br&gt;&lt;br&gt;Columns: MachineName | Dept | Area | Product Type&lt;br&gt;&lt;br&gt;Nottingham: 66 rows (Dept for example Strepsils, Solid Dose). Weinheim: 6 rows (Fixatives, Tablets).&lt;br&gt;&lt;br&gt;Hull sample: B2 Auto | Liquids Pack | Liquids | Bottles" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="330" height="300" as="geometry"/></mxCell><mxCell id="p10c9" value="&lt;b&gt;Machine Names EU&lt;/b&gt;&lt;br&gt;MachineName, Dept, Area, Product Type, SiteName, Unique Machine Name&lt;br&gt;SiteName and Unique Machine Name (machine name + -Hull) are added by the report" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="430" y="170" width="330" height="94" as="geometry"/></mxCell><mxCell id="p10c10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p10c8" target="p10c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p10c11" value="&lt;b&gt;Machine Names EU [Dept, Area, Product Type]&lt;/b&gt;&lt;br&gt;stand-in today: the Insights Hub area" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="170" width="330" height="62" as="geometry"/></mxCell><mxCell id="p10c12" value="&lt;b&gt;Machine Names EU [MachineName, SiteName]&lt;/b&gt;&lt;br&gt;from the Insights Hub asset hierarchy" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="242" width="330" height="62" as="geometry"/></mxCell><mxCell id="p10c13" value="&lt;b&gt;Machine Names EU [Unique Machine Name]&lt;/b&gt;&lt;br&gt;hidden key of every fact table" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="314" width="330" height="62" as="geometry"/></mxCell><mxCell id="p10c14" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p10c9" target="p10c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p10c15" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p10c9" target="p10c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p10c16" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p10c9" target="p10c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p10c17" value="11 Site, 12 Department, 14 Line, 15 Product Type selectors (EU-Level Overview)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="170" width="330" height="54" as="geometry"/></mxCell><mxCell id="p10c18" value="Pages: EU-Level Overview, Site-Level Overview, L2/L3 FIT View, Planned Losses, Unplanned Losses, Maintenance (BETA), Loss Trending, By Shift, By Format, OEE Trending" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="232" width="330" height="70" as="geometry"/></mxCell><mxCell id="p10c19" value="Relationships: every fact table joins on Unique Machine Name" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="310" width="330" height="54" as="geometry"/></mxCell><mxCell id="p10c20" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="p10c11" target="p10c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p10c21" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="p10c11" target="p10c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p10c22" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="p10c13" target="p10c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p10c23" value="&lt;b&gt;How a machine finds its filters: the key texts must be equal&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="1500" height="24" as="geometry"/></mxCell><mxCell id="p10c24" value="&lt;b&gt;1 A machine in the Insights Hub data&lt;/b&gt;&lt;br&gt;&lt;br&gt;Asset B2 Line, hierarchy Hull / Bottles / B2 Line&lt;br&gt;&lt;br&gt;Key today: the asset ID (32 characters)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="330" height="168" as="geometry"/></mxCell><mxCell id="p10c25" value="&lt;b&gt;2 The report key&lt;/b&gt;&lt;br&gt;&lt;br&gt;Unique Machine Name = machine name + &amp;quot;-Hull&amp;quot;&lt;br&gt;&lt;br&gt;B2 Auto-Hull (Plan OPT, Daily Losses, Glidepaths, Format List all use it)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="430" y="540" width="330" height="168" as="geometry"/></mxCell><mxCell id="p10c26" value="&lt;b&gt;3 The file row&lt;/b&gt;&lt;br&gt;&lt;br&gt;B2 Auto | Liquids Pack | Liquids | Bottles&lt;br&gt;&lt;br&gt;Dept, Area and Product Type come only from this file" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="830" y="540" width="330" height="168" as="geometry"/></mxCell><mxCell id="p10c27" value="&lt;b&gt;Keys are equal&lt;/b&gt;&lt;br&gt;The machine shows in the selectors with its Dept, Area and Product Type." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="540" width="330" height="76" as="geometry"/></mxCell><mxCell id="p10c28" value="&lt;b&gt;Keys differ&lt;/b&gt;&lt;br&gt;B2 Line (Insights Hub) is not B2 Auto-Hull: the machine has no row or no filters." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="632" width="330" height="76" as="geometry"/></mxCell><mxCell id="p10c29" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="p10c24" target="p10c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p10c30" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="p10c25" target="p10c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p10c31" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#82b366;" edge="1" parent="1" source="p10c26" target="p10c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p10c32" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="p10c26" target="p10c28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p10c33" value="&lt;b&gt;What can make the texts differ or the file fail&lt;/b&gt;&lt;br&gt;1. Machine key: Insights Hub uses the asset ID, the report uses machine name + site. Decision open. Either the Insights Hub tables write the report key, or a mapping table links them.&lt;br&gt;2. Names differ: B2 Line (Insights Hub) and B2 Auto (Provideam, files). GT4 is the same in both.&lt;br&gt;3. Dept, Area and Product Type are three different columns in the file (for example Liquids Pack, Liquids, Bottles). Insights Hub has one area. Today all three columns take the area.&lt;br&gt;4. The Hull file was not downloaded. Access to the folder is needed." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="728" width="1520" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Explanation Equipment Coding" id="page11"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p11c2" value="&lt;b&gt;Equipment Coding: from the Equipment Coding files to the Equipment column&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="p11c3" value="Purple = needs the Equipment Coding files. Hull file: NOT downloaded (no access). Nottingham and Weinheim files were checked. Blue = Power BI page. The guide says the board works without this file (optional)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1520" height="62" as="geometry"/></mxCell><mxCell id="p11c4" value="&lt;b&gt;1 Source file&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="330" height="20" as="geometry"/></mxCell><mxCell id="p11c5" value="&lt;b&gt;2 Table in the report&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="140" width="330" height="20" as="geometry"/></mxCell><mxCell id="p11c6" value="&lt;b&gt;3 Columns it fills&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="140" width="330" height="20" as="geometry"/></mxCell><mxCell id="p11c7" value="&lt;b&gt;4 Where they are used&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1230" y="140" width="330" height="20" as="geometry"/></mxCell><mxCell id="p11c8" value="&lt;b&gt;Equipment Coding files&lt;/b&gt;&lt;br&gt;&lt;br&gt;SharePoint, one folder per site. Kept by hand: for every machine and loss description, the equipment that caused the loss.&lt;br&gt;&lt;br&gt;Columns: MachineName | OEELossLvl3Desc | Merged Unique Identifier | Equipment | Lvl 3 Loss Name (empty in all rows)&lt;br&gt;&lt;br&gt;Nottingham: 4,331 rows, 62 machines, 130 equipment values. Weinheim: 267 rows, 6 machines.&lt;br&gt;&lt;br&gt;Example: O5 100% Inspection -&amp;gt; 100% Inspection" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="330" height="300" as="geometry"/></mxCell><mxCell id="p11c9" value="&lt;b&gt;Equipment Coding H / N / W (hidden)&lt;/b&gt;&lt;br&gt;Merged Unique Identifier, Equipment, Lvl 3 Loss Name&lt;br&gt;key = machine name + loss description. An empty Equipment becomes &amp;quot;Unclassed&amp;quot;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="430" y="170" width="330" height="94" as="geometry"/></mxCell><mxCell id="p11c10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p11c8" target="p11c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p11c11" value="&lt;b&gt;Daily Losses EU [Equipment]&lt;/b&gt;&lt;br&gt;looked up with the key machine + loss description" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="170" width="330" height="62" as="geometry"/></mxCell><mxCell id="p11c12" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p11c9" target="p11c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p11c13" value="Pages that use Equipment: Planned Losses, Unplanned Losses" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="170" width="330" height="70" as="geometry"/></mxCell><mxCell id="p11c14" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="p11c11" target="p11c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p11c15" value="&lt;b&gt;How one stop finds its equipment: the machine and the description must be equal&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="1500" height="24" as="geometry"/></mxCell><mxCell id="p11c16" value="&lt;b&gt;1 A stop in the Insights Hub data&lt;/b&gt;&lt;br&gt;&lt;br&gt;Machine: B2 Line&lt;br&gt;&lt;br&gt;Reason (leaf): 001 PRESSED EMERGENCY IN MAIN P.B.PANEL AREA&lt;br&gt;&lt;br&gt;Second reason level (stand-in): for example Capper" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="330" height="168" as="geometry"/></mxCell><mxCell id="p11c17" value="&lt;b&gt;2 The report builds a key&lt;/b&gt;&lt;br&gt;&lt;br&gt;Equipment Loss Key = machine name + loss description&lt;br&gt;&lt;br&gt;B2 Auto 001 PRESSED EMERGENCY IN MAIN P.B.PANEL AREA" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="430" y="540" width="330" height="168" as="geometry"/></mxCell><mxCell id="p11c18" value="&lt;b&gt;3 It looks for the same text in the file&lt;/b&gt;&lt;br&gt;&lt;br&gt;Provideam descriptions look like: 100% Inspection&lt;br&gt;&lt;br&gt;Hull descriptions seen in the guide: Cleaning Area, Labeller Head 1 Coding" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="830" y="540" width="330" height="168" as="geometry"/></mxCell><mxCell id="p11c19" value="&lt;b&gt;Texts are equal&lt;/b&gt;&lt;br&gt;Nottingham: 98% of the unplanned stops have an entry. Weinheim: 70%." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="540" width="330" height="76" as="geometry"/></mxCell><mxCell id="p11c20" value="&lt;b&gt;Texts differ&lt;/b&gt;&lt;br&gt;The stop gets &amp;quot;Unclassed&amp;quot; or no equipment. B2 reason texts of Insights Hub are alarm texts, not Provideam descriptions." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="632" width="330" height="76" as="geometry"/></mxCell><mxCell id="p11c21" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="p11c16" target="p11c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p11c22" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="p11c17" target="p11c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p11c23" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#82b366;" edge="1" parent="1" source="p11c18" target="p11c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p11c24" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="p11c18" target="p11c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p11c25" value="&lt;b&gt;What can make the texts differ or the file fail&lt;/b&gt;&lt;br&gt;1. The reason text of Insights Hub (B2: alarm texts) is not the Provideam description. Fix: a mapping from the Insights Hub reason to the Provideam description, or an equipment column kept in Insights Hub.&lt;br&gt;2. Coverage depends on the people who keep the file: 98% (Nottingham) and 70% (Weinheim) of the unplanned stops. New loss types need a new row.&lt;br&gt;3. The Hull file was not downloaded. Access to the folder is needed." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="728" width="1520" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Explanation Loss Units" id="page12"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p12c2" value="&lt;b&gt;Loss Units: from the Volume Loss Correction files to the Loss Units column&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="p12c3" value="Purple = needs the Volume Loss Correction files. They are a daily Provideam report (OEE Loss, group by object), not a manual file. Hull file: NOT downloaded (no access). Nottingham and Weinheim files were checked. Blue = Power BI visual." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1520" height="62" as="geometry"/></mxCell><mxCell id="p12c4" value="&lt;b&gt;1 Source file&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="330" height="20" as="geometry"/></mxCell><mxCell id="p12c5" value="&lt;b&gt;2 Table in the report&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="140" width="330" height="20" as="geometry"/></mxCell><mxCell id="p12c6" value="&lt;b&gt;3 Columns it fills&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="140" width="330" height="20" as="geometry"/></mxCell><mxCell id="p12c7" value="&lt;b&gt;4 Where they are used&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1230" y="140" width="330" height="20" as="geometry"/></mxCell><mxCell id="p12c8" value="&lt;b&gt;Volume Loss Correction files&lt;/b&gt;&lt;br&gt;&lt;br&gt;SharePoint, one folder per site. Written by a Provideam report (OEE Loss, group by object), one file per month plus the current month.&lt;br&gt;&lt;br&gt;Columns: ShiftStartDate | MachineName | OEELossLvl3Group | OEELossLvl3SubGroup | OEELossLvl3Desc | Time | Loss Units&lt;br&gt;&lt;br&gt;Example: Fette12, Not Logged, Not Logged, 00:20:00, 11.87 units" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="330" height="300" as="geometry"/></mxCell><mxCell id="p12c9" value="&lt;b&gt;Volume Loss Correction H / N / W (hidden)&lt;/b&gt;&lt;br&gt;Loss Units, Volume Key, Time in Mins, Hour/Minute/Second Time&lt;br&gt;Volume Key = day + machine + group + sub group + description. The key must be unique (maintenance guide)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="430" y="170" width="330" height="94" as="geometry"/></mxCell><mxCell id="p12c10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p12c8" target="p12c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p12c11" value="&lt;b&gt;Daily Losses EU [Loss Units]&lt;/b&gt;&lt;br&gt;joined on the Volume Key" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="170" width="330" height="62" as="geometry"/></mxCell><mxCell id="p12c12" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p12c9" target="p12c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p12c13" value="2 Unplanned Loss %, 3 Planned Loss %" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="170" width="330" height="38" as="geometry"/></mxCell><mxCell id="p12c14" value="5 Top 5 Loss Categories, 8 Unplanned Loss vs Target" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="216" width="330" height="38" as="geometry"/></mxCell><mxCell id="p12c15" value="7 Planned Loss vs Target, 9 Top Losses" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="262" width="330" height="38" as="geometry"/></mxCell><mxCell id="p12c16" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="p12c11" target="p12c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p12c17" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="p12c11" target="p12c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p12c18" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="p12c11" target="p12c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p12c19" value="&lt;b&gt;How Loss Units are made: the rule is the same in both systems&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="1500" height="24" as="geometry"/></mxCell><mxCell id="p12c20" value="&lt;b&gt;1 Insights Hub (our assumption)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Loss Units = design speed per minute x stop minutes&lt;br&gt;&lt;br&gt;design speed from the product (productCollections/.../products)&lt;br&gt;&lt;br&gt;duration from downtimeReasons" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="330" height="168" as="geometry"/></mxCell><mxCell id="p12c21" value="&lt;b&gt;2 Provideam (the file)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Loss Units = loss time x capacity per planned minute of the product&lt;br&gt;&lt;br&gt;Checked on Nottingham: 2,341 of 2,349 machine-days within 3% (median ratio 1)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="430" y="540" width="330" height="168" as="geometry"/></mxCell><mxCell id="p12c22" value="&lt;b&gt;3 The report&lt;/b&gt;&lt;br&gt;&lt;br&gt;Daily Losses EU [Loss Units] is looked up by the Volume Key&lt;br&gt;&lt;br&gt;Loss % = Loss Units / Capacity (Plan OPT)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="830" y="540" width="330" height="168" as="geometry"/></mxCell><mxCell id="p12c23" value="&lt;b&gt;Same rule&lt;/b&gt;&lt;br&gt;If the speed per minute is the same, the Loss Units are the same." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="540" width="330" height="76" as="geometry"/></mxCell><mxCell id="p12c24" value="&lt;b&gt;Different speed&lt;/b&gt;&lt;br&gt;Capacity per minute of Provideam differs from the design speed of Insights Hub: the numbers differ." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="632" width="330" height="76" as="geometry"/></mxCell><mxCell id="p12c25" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="p12c20" target="p12c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p12c26" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="p12c21" target="p12c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p12c27" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#82b366;" edge="1" parent="1" source="p12c22" target="p12c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p12c28" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="p12c22" target="p12c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p12c29" value="&lt;b&gt;What can make the texts differ or the file fail&lt;/b&gt;&lt;br&gt;1. The rule is confirmed on Nottingham data, not on Hull (Hull file missing). The speed per minute decides the result: Provideam capacity against Insights Hub design speed (B2: one speed per product, GT4: not always the design speed).&lt;br&gt;2. The file is a daily total per machine, reason and day. Insights Hub has one row per stop. The report joins on day + machine + reason. Fix: build the same key, and check that the sum per key is equal.&lt;br&gt;3. Planned losses exist in the file (groups Planned Losses, Production Not Scheduled). Insights Hub has no planned stops in the Hull data." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="728" width="1520" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Explanation Provideam vs Insights Hub" id="page13"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p13c2" value="&lt;b&gt;Provideam and Insights Hub: what overlaps and what can replace what&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="p13c3" value="Provideam = OEE monitoring software from the vendor DTL Systems (browser based: availability, performance, quality). The Hull site uses it as its production system. Source: the Hull maintenance guide (January 2026), its screenshots and vendor listings. Status 2026-10-13, Hull only. Provideam documentation was not read." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1520" height="62" as="geometry"/></mxCell><mxCell id="p13c4" value="&lt;b&gt;Provideam path (Hull today)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="146" width="700" height="20" as="geometry"/></mxCell><mxCell id="p13c5" value="Machines. Operators enter and edit data" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="235" height="56" as="geometry"/></mxCell><mxCell id="p13c6" value="Provideam reports: daily, then hourly until 17:00" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="298" y="170" width="235" height="56" as="geometry"/></mxCell><mxCell id="p13c7" value="CSV by email. Outlook rules sort the mails" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="556" y="170" width="235" height="56" as="geometry"/></mxCell><mxCell id="p13c8" value="Power Automate saves one file per day" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="814" y="170" width="235" height="56" as="geometry"/></mxCell><mxCell id="p13c9" value="SharePoint folder (Hull site)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1072" y="170" width="235" height="56" as="geometry"/></mxCell><mxCell id="p13c10" value="Power BI board: queries and 5 Excel files" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1330" y="170" width="235" height="56" as="geometry"/></mxCell><mxCell id="p13c11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="p13c5" target="p13c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p13c12" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="p13c6" target="p13c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p13c13" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="p13c7" target="p13c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p13c14" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="p13c8" target="p13c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p13c15" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="p13c9" target="p13c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p13c16" value="&lt;b&gt;Insights Hub path (VFC flows)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="256" width="700" height="20" as="geometry"/></mxCell><mxCell id="p13c17" value="Machines. OEE app and manual entries" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=middle;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="235" height="56" as="geometry"/></mxCell><mxCell id="p13c18" value="Insights Hub OEE API" style="rounded=1;whiteSpace=wrap;html=1;align=left;ve