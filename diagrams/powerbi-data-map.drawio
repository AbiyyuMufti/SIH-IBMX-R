        </mxCell>
        <mxCell id="p1c5" value="&lt;b&gt;Insights Hub column&lt;/b&gt; and example (below it)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;" parent="1" vertex="1">
