wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="834" width="330" height="40" as="geometry"/></mxCell><mxCell id="p13c76" value="Run segments (time while running)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="330" height="40" as="geometry"/></mxCell><mxCell id="p13c77" value="Mode Log: rows with group Run" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="390" y="880" width="400" height="40" as="geometry"/></mxCell><mxCell id="p13c78" value="Not in fact_loss (stops only)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="810" y="880" width="400" height="40" as="geometry"/></mxCell><mxCell id="p13c79" value="&lt;b&gt;Only Provideam&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="880" width="330" height="40" as="geometry"/></mxCell><mxCell id="p13c80" value="MTTR, MTBF, TEEP, micro and macro stops" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="926" width="330" height="40" as="geometry"/></mxCell><mxCell id="p13c81" value="Not seen in the reports" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="390" y="926" width="400" height="40" as="geometry"/></mxCell><mxCell id="p13c82" value="fact_kpi columns" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="810" y="926" width="400" height="40" as="geometry"/></mxCell><mxCell id="p13c83" value="&lt;b&gt;Only Insights Hub&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="926" width="330" height="40" as="geometry"/></mxCell><mxCell id="p13c84" value="Targets (Glidepaths), Machine Names, Equipment Coding, Shift Pattern Naming, Format Mapping" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="972" width="330" height="40" as="geometry"/></mxCell><mxCell id="p13c85" value="Excel files kept by the site. Not made by Provideam" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="390" y="972" width="400" height="40" as="geometry"/></mxCell><mxCell id="p13c86" value="Not available" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="810" y="972" width="400" height="40" as="geometry"/></mxCell><mxCell id="p13c87" value="&lt;b&gt;Independent of both&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="972" width="330" height="40" as="geometry"/></mxCell><mxCell id="p13c88" value="&lt;b&gt;What this means for replacing Provideam&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="1038" width="1500" height="24" as="geometry"/></mxCell><mxCell id="p13c89" value="1. Overlap rows: Insights Hub can supply the data, but the numbers differ. On the overlap days the Insights Hub good parts are 96.6% (B2) and 43.6% (GT4) of the Provideam good parts. Reckitt must name the official source per site.&lt;br&gt;&lt;br&gt;2. Only Provideam: we need the Provideam files or the Provideam rules. Or Reckitt accepts that the column is empty (for example comment text).&lt;br&gt;&lt;br&gt;3. Excel files: they do not depend on the OEE source. We need them in every case.&lt;br&gt;&lt;br&gt;4. At a switch, the history in the report changes: Provideam numbers before the date, Insights Hub numbers after it." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1072" width="1520" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Explanation Data collection and conflicts" id="page14"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p14c2" value="&lt;b&gt;Data collection: how each data item reaches the lake and where it conflicts with Insights Hub&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="p14c3" value="Status 2026-10-14, from the downloaded SharePoint files (Hull, Nottingham, Weinheim; Mira and most Hull folders not reachable). Collection today: the user copies files by hand to the data lake. Next step: Power Automate sends the file to a VFC endpoint, the VFC writes a parquet file. Not tested: file size limit, key handling and POST on the VFC http in node." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1520" height="62" as="geometry"/></mxCell><mxCell id="p14c4" value="&lt;b&gt;Files (Provideam reports and Excel files kept by hand)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="146" width="700" height="20" as="geometry"/></mxCell><mxCell id="p14c5" value="SharePoint folder (Hull and Nottingham sites)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="235" height="62" as="geometry"/></mxCell><mxCell id="p14c6" value="NOW: the user copies the file by hand" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="298" y="170" width="235" height="62" as="geometry"/></mxCell><mxCell id="p14c7" value="NEXT: Power Automate sends the file to a VFC endpoint (not tested)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=middle;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="556" y="170" width="235" height="62" as="geometry"/></mxCell><mxCell id="p14c8" value="VFC converts the file to parquet (encoding, tab, Total row, comment quotes)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="814" y="170" width="235" height="62" as="geometry"/></mxCell><mxCell id="p14c9" value="Data lake: one parquet file per file type, with the download date" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1072" y="170" width="235" height="62" as="geometry"/></mxCell><mxCell id="p14c10" value="Mapping tables (machine, product, shift, reason names) and Power BI" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=10.5;" vertex="1"