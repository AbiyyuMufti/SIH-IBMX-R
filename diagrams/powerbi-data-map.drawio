        <mxCell id="p2c34" value="&lt;b&gt;SIH source: &lt;/b&gt;GET /api/oee/v3/calendars/{calendarId}/calendarEvents -&amp;gt; event name and recurrence. The calendarId comes from GET /api/oee/v3/assets/{assetId}/config" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#26C6B8;strokeColor=#00897B;verticalAlign=middle;fontSize=10;dashed=1;dashPattern=8 4;strokeWidth=3;fillOpacity=30;fontColor=#00574B;" parent="1" vertex="1">
