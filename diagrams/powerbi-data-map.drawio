        </mxCell>
        <mxCell id="p2c13" value="&lt;b&gt;SIH source: &lt;/b&gt;No endpoint: the production day (06:00 to 06:00 UTC) is set in the flow. Hours come from POST /api/oee/v3/expressions/evaluateKPIs" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#7986CB;strokeColor=#3949AB;verticalAlign=middle;fontSize=10;dashed=1;dashPattern=8 4;strokeWidth=3;fillOpacity=30;fontColor=#1A237E;" parent="1" vertex="1">
