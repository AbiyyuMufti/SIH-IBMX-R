xCell><mxCell id="p6c79" value="&lt;b&gt;month_short_name&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;String, 100% filled&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="380" y="1220" width="280" height="38" as="geometry"/></mxCell><mxCell id="p6c80" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;e.g. Oct | Dec&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="380" y="1262" width="280" height="40" as="geometry"/></mxCell><mxCell id="p6c81" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#82b366;" edge="1" parent="1" source="p6c77" target="p6c79"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6c82" value="&lt;b&gt;OK&lt;/b&gt;&lt;br&gt;Generated by the Insights Hub flow from the date (Monday week start)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=4;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="700" y="1220" width="600" height="94" as="geometry"/></mxCell><mxCell id="p6c83" value="&lt;b&gt;SIH source: &lt;/b&gt;No endpoint: generated in the flow from calendarStart and calendarEnd (settings)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#7986CB;strokeColor=#3949AB;verticalAlign=middle;fontSize=10;dashed=1;dashPattern=8 4;strokeWidth=3;fillOpacity=30;fontColor=#1A237E;" vertex="1" parent="1"><mxGeometry x="710" y="1270" width="580" height="38" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Explanation Targets (Glidepaths)" id="page7"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p7c2" value="&lt;b&gt;Targets: from the Glidepaths files to the report visuals&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="p7c3" value="Purple = needs the Glidepaths files (not connected yet). Blue = Power BI visual. The Glidepaths files fill 5 columns in 2 tables. Which visual uses which column comes from the data lineage document. No Glidepaths file has been seen yet: the file layout below comes from the load queries of the Power BI model." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1520" height="62" as="geometry"/></mxCell><mxCell id="p7c4" value="&lt;b&gt;1 Source files&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="330" height="20" as="geometry"/></mxCell><mxCell id="p7c5" value="&lt;b&gt;2 Target tables in the report&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="140" width="330" height="20" as="geometry"/></mxCell><mxCell id="p7c6" value="&lt;b&gt;3 Columns they fill&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="140" width="330" height="20" as="geometry"/></mxCell><mxCell id="p7c7" value="&lt;b&gt;4 Visuals that use them&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1230" y="140" width="330" height="20" as="geometry"/></mxCell><mxCell id="p7c8" value="&lt;b&gt;Glidepaths files&lt;/b&gt;&lt;br&gt;&lt;br&gt;SharePoint, Nottingham site, one folder for all sites. One row per site, line and loss category (OEE Bucket). One column per month.&lt;br&gt;&lt;br&gt;&lt;b&gt;Columns (from the model query)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Site Name | Line | OEE Bucket | one column per month (value in percent)&lt;br&gt;&lt;br&gt;&lt;b&gt;Example row (layout only, not real values)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hull | &amp;lt;line&amp;gt; | % OEE | 01/10/2026 = &amp;lt;percent&amp;gt;&lt;br&gt;&lt;br&gt;The report turns the month columns into rows, then builds a key: &amp;lt;Line&amp;gt;-&amp;lt;Site&amp;gt; + category + month." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="330" height="330" as="geometry"/></mxCell><mxCell id="p7c9" value="&lt;b&gt;OEE Targets EU&lt;/b&gt;&lt;br&gt;Line, OEE Bucket, Attribute, OEE Target, Volume Key, Site Name&lt;br&gt;only the rows with bucket &amp;quot;% OEE&amp;quot;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="430" y="170" width="330" height="74" as="geometry"/></mxCell><mxCell id="p7c10" value="&lt;b&gt;PDT Targets EU&lt;/b&gt;&lt;br&gt;Line, OEE Bucket, Attribute, PDT Target, Volume Key, Site Name&lt;br&gt;planned downtime target" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="430" y="254" width="330" height="74" as="geometry"/></mxCell><mxCell id="p7c11" value="&lt;b&gt;UPDT Targets EU&lt;/b&gt;&lt;br&gt;Line, OEE Bucket, Attribute, UPDT Target, Volume Key, % Target, Site Name&lt;br&gt;unplanned downtime target" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="430" y="338" width="330" height="74" as="geometry"/></mxCell><mxCell id="p7c12" value="&lt;b&gt;Targets Losses EU&lt;/b&gt;&lt;br&gt;Value, Loss Key, Volume Key&lt;br&gt;one target per machine, loss category and month" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="430" y="422" width="330" height="74" as="geometry"/></mxCell><mxCell id="p7c13" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p7c8" target="p7c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c14" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p7c8" target="p7c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c15" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;