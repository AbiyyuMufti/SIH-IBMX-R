metry relative="1" as="geometry"/></mxCell><mxCell id="p14c25" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="p14c20" target="p14c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p14c26" value="Conflict with Insights Hub: a mapping or decision is needed" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="365" width="370" height="34" as="geometry"/></mxCell><mxCell id="p14c27" value="No conflict: same rule or only one source" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="425" y="365" width="370" height="34" as="geometry"/></mxCell><mxCell id="p14c28" value="Open question: Reckitt must decide" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="810" y="365" width="370" height="34" as="geometry"/></mxCell><mxCell id="p14c29" value="Group 2, decide later" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#eeeeee;strokeColor=#999999;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1195" y="365" width="370" height="34" as="geometry"/></mxCell><mxCell id="p14c30" value="&lt;b&gt;Data item&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="412" width="310" height="20" as="geometry"/></mxCell><mxCell id="p14c31" value="&lt;b&gt;Source and how it is collected&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="412" width="330" height="20" as="geometry"/></mxCell><mxCell id="p14c32" value="&lt;b&gt;Conflict with Insights Hub&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="412" width="480" height="20" as="geometry"/></mxCell><mxCell id="p14c33" value="&lt;b&gt;Resolution&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1190" y="412" width="370" height="20" as="geometry"/></mxCell><mxCell id="p14c34" value="&lt;b&gt;Targets (Glidepaths)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="310" height="60" as="geometry"/></mxCell><mxCell id="p14c35" value="Excel/CSV kept by hand, one file per site (Hull: 30 lines, 2026 91% filled, 2027 empty). Copy by hand, later Power Automate" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="360" y="440" width="330" height="60" as="geometry"/></mxCell><mxCell id="p14c36" value="Line names (B2 Auto against B2 Line). Loss names: 22 of 10,100 Insights Hub stops have a sub group that equals a bucket" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="700" y="440" width="480" height="60" as="geometry"/></mxCell><mxCell id="p14c37" value="Mapping tables: line names, and reason to bucket (start from the 17 text rules of the Hull query)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1190" y="440" width="370" height="60" as="geometry"/></mxCell><mxCell id="p14c38" value="&lt;b&gt;Product format (brand, size, count)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="508" width="310" height="60" as="geometry"/></mxCell><mxCell id="p14c39" value="Format Mapping file kept by hand (Hull 286 rows). Copy by hand" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="360" y="508" width="330" height="60" as="geometry"/></mxCell><mxCell id="p14c40" value="B2 Line: 0 of 27 product names match (SAP-style against short names). GT4: 13 of 13 match" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="700" y="508" width="480" height="60" as="geometry"/></mxCell><mxCell id="p14c41" value="Mapping from the Insights Hub product code to the Provideam product name (B2)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1190" y="508" width="370" height="60" as="geometry"/></mxCell><mxCell id="p14c42" value="&lt;b&gt;Shift names&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="576" width="310" height="60" as="geometry"/></mxCell><mxCell id="p14c43" value="Shift Pattern file, one for all sites (188 rows, 7 values). Copy by hand" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="360" y="576" width="330" height="60" as="geometry"/></mxCell><mxCell id="p14c44" value="Shift 1, Shift 2, Yellow have no Shift value. Day, Night, Afternoon are not Insights Hub names" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="700" y="576" width="480" height="60" as="geometry"/></mxCell><mxCell id="p14c45" value="Mapping from the Insights Hub shift to a Shift value, or new rows in the file" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1190" y="576" width="370" height="60" as="geometry"/></mxCell><mxCell id="p14c46" value="&lt;b&gt;Machine names, Dept, Area, Product Type&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="644" width="310" height="60" as="geometry"/></mxCell><mxCell id="p14c47" value="Machine Names file per site (Hull: no access, local copy sample only). Copy by hand" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="360" y="644" width="330" height="60" as="geometry"/></mxCell><mxCell id="p14c48" value="B2 Line against B2 Auto. Three columns in the file, one area in Insights Hub. Asset ID against machine name + site as key" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="700" y="644" width="480" height="60" as="geometry"/></mxCell><mxCell id="p14c49" value="The file is the master for Dept, Area, Product Type. Mapping for names. Decision on the key is open" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1190" y="644" width="370" height="60" as="geometry"/></mxCell><mxCell id="p14c50" value="&lt;b&gt;Equipment of a stop&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="712" width="310" height="60" as="geometry"/></mxCell><mxCell id="p14c51" value="Equipment Coding file per site (Hull: no access). Copy by hand" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="360" y="712" width="330" height="60" as="geometry"/></mxCell><mxCell id="p14c52" value="Insights Hub reason texts (B2: alarm texts) are not the Provideam descriptions the file uses" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="700" y="712" width="480" height="60" as="geometry"/></mxCell><mxCell id="p14c53" value="Mapping reason to description, or an equipment attribute kept in Insights Hub" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1190" y="712" width="370" height="60" as="geometry"/></mxCell><mxCell id="p14c54" value="&lt;b&gt;Production actuals (good parts, capacity, times)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="310" height="60" as="geometry"/></mxCell><mxCell id="p14c55" value="Provideam Plan OPT files: monthly and current month, rewritten by an hourly job. Not needed if Insights Hub is the source" style="rounded=1;whiteSpace=wrap;html=1;