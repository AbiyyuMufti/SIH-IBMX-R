uses which column comes from the data lineage document. No Glidepaths file has been seen yet: the file layout below comes from the load queries of the Power BI model." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1520" height="62" as="geometry"/></mxCell><mxCell id="p7c4" value="&lt;b&gt;1 Source files&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="330" height="20" as="geometry"/></mxCell><mxCell id="p7c5" value="&lt;b&gt;2 Target tables in the report&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="140" width="330" height="20" as="geometry"/></mxCell><mxCell id="p7c6" value="&lt;b&gt;3 Columns they fill&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="140" width="330" height="20" as="geometry"/></mxCell><mxCell id="p7c7" value="&lt;b&gt;4 Visuals that use them&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1230" y="140" width="330" height="20" as="geometry"/></mxCell><mxCell id="p7c8" value="&lt;b&gt;Glidepaths files&lt;/b&gt;&lt;br&gt;&lt;br&gt;SharePoint, Nottingham site, one folder for all sites. One row per site, line and loss category (OEE Bucket). One column per month.&lt;br&gt;&lt;br&gt;&lt;b&gt;Columns (from the model query)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Site Name | Line | OEE Bucket | one column per month (value in percent)&lt;br&gt;&lt;br&gt;&lt;b&gt;Example row (layout only, not real values)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hull | &amp;lt;line&amp;gt; | % OEE | 01/10/2026 = &amp;lt;percent&amp;gt;&lt;br&gt;&lt;br&gt;The report turns the month columns into rows, then builds a key: &amp;lt;Line&amp;gt;-&amp;lt;Site&amp;gt; + category + month." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="330" height="330" as="geometry"/></mxCell><mxCell id="p7c9" value="&lt;b&gt;OEE Targets EU&lt;/b&gt;&lt;br&gt;Line, OEE Bucket, Attribute, OEE Target, Volume Key, Site Name&lt;br&gt;only the rows with bucket &amp;quot;% OEE&amp;quot;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="430" y="170" width="330" height="74" as="geometry"/></mxCell><mxCell id="p7c10" value="&lt;b&gt;PDT Targets EU&lt;/b&gt;&lt;br&gt;Line, OEE Bucket, Attribute, PDT Target, Volume Key, Site Name&lt;br&gt;planned downtime target" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="430" y="254" width="330" height="74" as="geometry"/></mxCell><mxCell id="p7c11" value="&lt;b&gt;UPDT Targets EU&lt;/b&gt;&lt;br&gt;Line, OEE Bucket, Attribute, UPDT Target, Volume Key, % Target, Site Name&lt;br&gt;unplanned downtime target" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="430" y="338" width="330" height="74" as="geometry"/></mxCell><mxCell id="p7c12" value="&lt;b&gt;Targets Losses EU&lt;/b&gt;&lt;br&gt;Value, Loss Key, Volume Key&lt;br&gt;one target per machine, loss category and month" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="430" y="422" width="330" height="74" as="geometry"/></mxCell><mxCell id="p7c13" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p7c8" target="p7c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c14" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p7c8" target="p7c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c15" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p7c8" target="p7c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c16" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p7c8" target="p7c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c17" value="&lt;b&gt;Plan OPT EU [OEE Target]&lt;/b&gt;&lt;br&gt;join: machine + month" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="170" width="330" height="54" as="geometry"/></mxCell><mxCell id="p7c18" value="&lt;b&gt;Plan OPT EU [PDT Target]&lt;/b&gt;&lt;br&gt;join: machine + month" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="236" width="330" height="54" as="geometry"/></mxCell><mxCell id="p7c19" value="&lt;b&gt;Plan OPT EU [UPDT Target]&lt;/b&gt;&lt;br&gt;join: machine + month" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="302" width="330" height="54" as="geometry"/></mxCell><mxCell id="p7c20" value="&lt;b&gt;Daily Losses EU [Value]&lt;/b&gt;&lt;br&gt;join: machine + loss sub group + month" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="396" width="330" height="54" as="geometry"/></mxCell><mxCell id="p7c21" value="&lt;b&gt;Daily Losses EU [Target]&lt;/b&gt;&lt;br&gt;Value / 100" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="462" width="330" height="54" as="geometry"/></mxCell><mxCell id="p7c22" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p7c9" target="p7c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c23" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p7c10" target="p7c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c24" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p7c11" target="p7c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c25" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p7c12" target="p7c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c26" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p7c20" target="p7c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c27" value="1 OEE % (Europe): gauge with target" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="170" width="330" height="34" as="geometry"/></mxCell><mxCell id="p7c28" value="4 OEE % by Site" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="210" width="330" height="34" as="geometry"/></mxCell><mxCell id="p7c29" value="3 Planned Loss %" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="250" width="330" height="34" as="geometry"/></mxCell><mxCell id="p7c30" value="7 Planned Loss vs Target (%) and by Site" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="290" width="330" height="34" as="geometry"/></mxCell><mxCell id="p7c31" value="2 Unplanned Loss %" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="330" width="330" height="34" as="geometry"/></mxCell><mxCell id="p7c32" value="8 Unplanned Loss vs Target (%) and by Site" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="370" width="330" height="34" as="geometry"/></mxCell><mxCell id="p7c33" value="5 Top 5 Loss Categories (also needs Volume Total)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="470" width="330" height="34" as="geometry"/></mxCell><mxCell id="p7c34" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="p7c17" target="p7c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c35" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="p7c17" target="p7c28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c36" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="p7c19" target="p7c31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c37" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="p7c19" target="p7c32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c38" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="p7c18" target="p7c29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c39" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="p7c18" target="p7c30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c40" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="p7c21" target="p7c33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c41" value="Not from Glidepaths: Volume Total in Daily Losses comes from the Targets Volume table. For Hull that query reads the Plan OPT folder, so it can probably be added up from good parts. Visual 5 weights its target with it." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#eeeeee;strokeColor=#999999;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="830" y="530" width="730" height="54" as="geometry"/></mxCell><mxCell id="p7c42" value="&lt;b&gt;How one stop finds its target (Daily Losses): the texts must be equal&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1500" height="24" as="geometry"/></mxCell><mxCell id="p7c43" value="&lt;b&gt;1 A stop in our Insights Hub data&lt;/b&gt;&lt;br&gt;Machine: B2 Line&lt;br&gt;Loss sub group: Process Failure (our values: Unplanned Downtime | Process Failure | Measurement and adjustment)&lt;br&gt;Date: 2026-10-05&lt;br&gt;Sub group is filled for 35% of the stops only." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="330" height="168" as="geometry"/></mxCell><mxCell id="p7c44" value="&lt;b&gt;2 The report builds a key&lt;/b&gt;&lt;br&gt;&lt;br&gt;Loss Target Key = machine + loss sub group + month&lt;br&gt;&lt;br&gt;B2 Line Process Failure 01/10/2026" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="430" y="660" width="330" height="168" as="geometry"/></mxCell><mxCell id="p7c45" value="&lt;b&gt;3 It looks for the same text in the file&lt;/b&gt;&lt;br&gt;&lt;br&gt;Loss Key = &amp;lt;Line&amp;gt;-&amp;lt;Site&amp;gt; + OEE Bucket + month&lt;br&gt;&lt;br&gt;Example (layout only): &amp;lt;line&amp;gt;-Hull &amp;lt;OEE Bucket&amp;gt; 01/10/2026&lt;br&gt;&lt;br&gt;The category name comes from the file. We do not know it yet." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="830" y="660" width="330" height="168" as="geometry"/></mxCell><mxCell id="p7c46" value="&lt;b&gt;Texts are equal&lt;/b&gt;&lt;br&gt;The stop gets Value and Target." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="660" width="330" height="66" as="geometry"/></mxCell><mxCell id="p7c47" value="&lt;b&gt;Texts differ&lt;/b&gt;&lt;br&gt;Value and Target stay empty for this stop." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="744" width="330" height="66" as="geometry"/></mxCell><mxCell id="p7c48" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="p7c43" target="p7c44"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c49" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="p7c44" target="p7c45"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c50" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#82b366;" edge="1" parent="1" source="p7c45" target="p7c46"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c51" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="p7c45" target="p7c47"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7c52" value="&lt;b&gt;What can make the texts differ&lt;/b&gt;&lt;br&gt;1. Machine name: the file may write &amp;quot;B2 Auto&amp;quot; where Insights Hub says &amp;quot;B2 Line&amp;quot;. Fix: a mapping of names.&lt;br&gt;2. Loss category name: our sub group is a stand-in (the top level of the reason tree). The file has its own category names. Fix: a mapping from our reason names to their categories.&lt;br&gt;3. Month text: the report writes the month as text (for example 01/10/2026). Both sides must use the same format.&lt;br&gt;Insights Hub numbers stay correct in all three cases. Only the target values stay empty." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="1520" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Explanation Provideam vs Insights Hub" id="page8"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p8c2" value="&lt;b&gt;Provideam and Insights Hub: what overlaps and what can replace what&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="p8c3" value="Provideam = OEE monitoring software from the vendor DTL Systems (browser based: availability, performance, quality). The Hull site uses it as its production system. Source: the Hull maintenance guide (January 2026), its screenshots and vendor listings. Status 2026-10-13, Hull only. Provideam documentation was not read." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1520" height="62" as="geometry"/></mxCell><mxCell id="p8c4" value="&lt;b&gt;Provideam path (Hull today)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="146" width="700" height="20" as="geometry"/></mxCell><mxCell id="p8c5" value="Machines. Operators enter and edit data" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="235" height="56" as="geometry"/></mxCell><mxCell id="p8c6" value="Provideam reports: daily, then hourly until 17:00" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="298" y="170" width="235" height="56" as="geometry"/></mxCell><mxCell id="p8c7" value="CSV by email. Outlook rules sort the mails" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="556" y="170" width="235" height="56" as="geometry"/></mxCell><mxCell id="p8c8" value="Power Automate saves one file per day" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="814" y="170" width="235" height="56" as="geometry"/></mxCell><mxCell id="p8c9" value="SharePoint folder (Hull site)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1072" y="170" width="235" height="56" as="geometry"/></mxCell><mxCell id="p8c10" value="Power BI board: queries and 5 Excel files" style="rounded=1;whiteSpace=wr