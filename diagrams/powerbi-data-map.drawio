        <mxCell id="how2-p1c68" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="how2-p1c67" target="how2-p1c58">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1670" y="611" />
              <mxPoint x="1670" y="518" />
              <mxPoint x="1700" y="518" />
