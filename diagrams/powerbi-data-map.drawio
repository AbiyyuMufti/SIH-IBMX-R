1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="280" height="38" as="geometry"/></mxCell><mxCell id="p1c38" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;e.g. S06-Nottingham&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="692" width="280" height="40" as="geometry"/></mxCell><mxCell id="p1c39" value="&lt;b&gt;unique_machine_name&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;String, 100% filled&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="380" y="650" width="280" height="38" as="geometry"/></mxCell><mxCell id="p1c40" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;e.g. cf4565d7... | bc08dae1...&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="380" y="692" width="280" height="40" as="geometry"/></mxCell><mxCell id="p1c41" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#d79b00;" edge="1" parent="1" source="p1c37" target="p1c39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1c42" value="&lt;b&gt;ASSUMPTION&lt;/b&gt;&lt;br&gt;Insights Hub = asset ID. Power BI local copy = machine-site text (Line 5-Weinheim). It is the hidden join key of every fact table. Decision open." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=4;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="700" y="650" width="600" height="82" as="geometry"/></mxCell><mxCell id="p1c43" value="&lt;b&gt;Columns added from Insights Hub that the report does not have&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="746" width="1260" height="20" as="geometry"/></mxCell><mxCell id="p1c44" value="loaded_at (Datetime, 100% filled)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#eeeeee;strokeColor=#999999;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="772" width="1260" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 Plan OPT EU" id="page2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2c2" value="&lt;b&gt;Plan OPT EU  -&amp;gt;  pbi_plan_opt&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="p2c3" value="Holds: Actual production per machine, plus capacity and monthly targets. One row is: Machine x date x shift x product.&lt;br&gt;Insights Hub table: 178 rows, 19 columns. One row per production day, machine, shift and product. Dates are text yyyy-mm-dd in the Insights Hub files (parquet has no date type).&lt;br&gt;Used on pages: EU-Level Overview, Site-Level Overview, Planned Losses, Unplanned Losses (some through measures)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1260" height="96" as="geometry"/></mxCell><mxCell id="p2c4" value="&lt;b&gt;Power BI column&lt;/b&gt; (blue) and example (below it)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="172" width="270" height="20" as="geometry"/></mxCell><mxCell id="p2c5" value="&lt;b&gt;Insights Hub column&lt;/b&gt; and example (below it)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="172" width="270" height="20" as="geometry"/></mxCell><mxCell id="p2c6" value="&lt;b&gt;Difference&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="172" width="600" height="20" as="geometry"/></mxCell><mxCell id="p2c7" value="&lt;b&gt;Date&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;dateTime&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="280" height="38" as="geometry"/></mxCell><mxCell id="p2c8" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;e.g. 45678 (2025-01-21)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="242" width="280" height="40" as="geometry"/></mxCell><mxCell id="p2c9" value="&lt;b&gt;date&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;String, 100% filled&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="380" y="200" width="280" height="38" as="geometry"/></mxCell><mxCell id="p2c10" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;e.g. 2026-10-01 | 2026-10-02&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="380" y="242" width="280" height="40" as="geometry"/></mxCell><mxCell id="p2c11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#d79b00;" edge="1" parent="1" source="p2c7" target="p2c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2c12" value="&lt;b&gt;ASSUMPTION&lt;/b&gt;&lt;br&gt;Production day 06:00 to 06:00 UTC. Power BI local copy: calendar date. Not crucial: a window setting plus a backfill." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=4;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="700" y="200" width="600" height="82" as="geometry"/></mxCell><mxCell id="p2c13" value="&lt;b&gt;AreaName&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;string&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcS