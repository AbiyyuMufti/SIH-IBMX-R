="16 assumption" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="196" y="1005" width="74" height="36" as="geometry"/></mxCell><mxCell id="p0c37" value="2 needs file" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="274" y="1005" width="74" height="36" as="geometry"/></mxCell><mxCell id="p0c38" value="1 empty / missing" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="352" y="1005" width="74" height="36" as="geometry"/></mxCell><mxCell id="p0c39" value="3 not needed" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#eeeeee;strokeColor=#999999;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="430" y="1005" width="74" height="36" as="geometry"/></mxCell><mxCell id="p0c40" value="&lt;b&gt;5  Shift Naming EU&lt;/b&gt;  -&gt;  &lt;b&gt;pbi_shift_naming&lt;/b&gt;&lt;br&gt;&lt;br&gt;Holds: List of shift names&lt;br&gt;&lt;br&gt;One row is: One row per shift&lt;br&gt;&lt;br&gt;Insights Hub table: 7 rows, 2 columns (Hull, downloaded 2026-10-13)&lt;br&gt;&lt;br&gt;Used on pages: EU-Level Overview, Site-Level Overview, L2/L3 FIT View, Planned Losses, Unplanned Losses, Maintenance (BETA), Loss Trending, By Shift, By Format, OEE Trending&lt;br&gt;&lt;br&gt;Columns in Power BI: 1&lt;br&gt;&lt;br&gt;&lt;b&gt;Insights Hub endpoints: &lt;/b&gt;OEE assets/{id}/config, calendars/{id}/calendarEvents" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=8;fillColor=#ffffff;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="550" y="645" width="480" height="350" as="geometry"/></mxCell><mxCell id="p0c41" value="0 OK" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="550" y="1005" width="74" height="36" as="geometry"/></mxCell><mxCell id="p0c42" value="0 with gaps" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="628" y="1005" width="74" height="36" as="geometry"/></mxCell><mxCell id="p0c43" value="0 assumption" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="706" y="1005" width="74" height="36" as="geometry"/></mxCell><mxCell id="p0c44" value="1 needs file" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="784" y="1005" width="74" height="36" as="geometry"/></mxCell><mxCell id="p0c45" value="0 empty / missing" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="862" y="1005" width="74" height="36" as="geometry"/></mxCell><mxCell id="p0c46" value="0 not needed" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#eeeeee;strokeColor=#999999;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="940" y="1005" width="74" height="36" as="geometry"/></mxCell><mxCell id="p0c47" value="&lt;b&gt;6  Calendar&lt;/b&gt;  -&gt;  &lt;b&gt;pbi_calendar&lt;/b&gt;&lt;br&gt;&lt;br&gt;Holds: Date table generated in Power BI&lt;br&gt;&lt;br&gt;One row is: One row per date&lt;br&gt;&lt;br&gt;Insights Hub table: 122 rows, 11 columns (Hull, downloaded 2026-10-13)&lt;br&gt;&lt;br&gt;Used on pages: EU-Level Overview, Site-Level Overview, L2/L3 FIT View, Planned Losses, Unplanned Losses, Maintenance (BETA), Loss Trending, By Shift, By Format, OEE Trending (some through measures)&lt;br&gt;&lt;br&gt;Columns in Power BI: 11&lt;br&gt;&lt;br&gt;&lt;b&gt;Insights Hub endpoints: &lt;/b&gt;None: generated in the flow" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=8;fillColor=#ffffff;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1060" y="645" width="480" height="350" as="geometry"/></mxCell><mxCell id="p0c48" value="11 OK" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1060" y="1005" width="74" height="36" as="geometry"/></mxCell><mxCell id="p0c49" value="0 with gaps" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1138" y="1005" width="74" height="36" as="geometry"/></mxCell><mxCell id="p0c50" value="0 assumption" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1216" y="1005" width="74" height="36" as="geometry"/></mxCell><mxCell id="p0c51" value="0 needs file" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1294" y="1005" width="74" height="36" as="geometry"/></mxCell><mxCell id="p0c52" value="0 empty / missing" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1372" y="1005" width="74" height="36" as="geometry"/></mxCell><mxCell id="p0c53" value="0 not needed" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#eeeeee;strokeColor=#999999;fontSize=10;align=center;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1450" y="1005" width="74" height="36" as="geometry"/></mxCell><mxCell id="p0c54" value="&lt;b&gt;How the report joins the tables (from the model)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="1085" width="1500" height="24" as="geometry"/></mxCell><mxCell id="p0c55" value="&lt;b&gt;Machine key&lt;/b&gt;: every fact table joins to Machine Names EU on Unique Machine Name (hidden key, never shown). Power BI local copy = machine-site text; Insights Hub = asset ID. Decision open.&lt;br&gt;&lt;br&gt;&lt;b&gt;Product key&lt;/b&gt;: Plan OPT, Daily Losses and Run Rates join to the product master (Format List EU). Power BI local copy key = machine + part name; Insights Hub = product code. Own product table decided 2026-10-13.&lt;br&gt;&lt;br&gt;&lt;b&gt;Shift&lt;/b&gt;: every fact table joins to Shift Naming EU on the shift name. All Insights Hub shift names must exist there.&lt;br&gt;&lt;br&gt;&lt;b&gt;Date&lt;/b&gt;: every fact table joins to Calendar on the date (Daily Losses: on the shift start date).&lt;br&gt;&lt;br&gt;&lt;b&gt;Endpoints&lt;/b&gt;: the paths are shown without the Xcelerator service suffix. Target platform (xcelerator, from 2026-10-13): host api.eu1.siemens.app and the service name gets the suffix -1000001700, for example /api/oee-1000001700/v3/... Legacy: host gateway.eu1.mindsphere.io, no suffix (docs/platform-switch.md)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="1119" width="1500" height="175" as="geometry"/></mxCell><mxCell id="p0c56" value="&lt;b&gt;Power BI tables not created from Insights Hub yet: 7 shown in the Data pane + 3 hidden supporting tables (columns on the last page)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="1330" width="1500" height="24" as="geometry"/></mxCell><mxCell id="p0c57" value="The Data pane of the Power BI local copy shows 14 tables: the 6 above, the 7 below and Measures Table (calculations only, no data). The model also has 39 hidden staging tables (regional copies N, H, W, M, Provideam) that feed the EU tables. 3 of them are listed here because they feed Daily Losses." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1358" width="1500" height="36" as="geometry"/></mxCell><mxCell id="p0c58" value="&lt;b&gt;Run Rates EU&lt;/b&gt;&lt;br&gt;&lt;br&gt;Good parts and capacity per machine, shift and product&lt;br&gt;&lt;br&gt;12 columns. Used on: no visual reads it directly&lt;br&gt;&lt;br&gt;&lt;b&gt;Decide later (group 2)&lt;/b&gt;&lt;br&gt;&lt;br&gt;SIH source: possible: evaluateKPIs hourly (KPI &amp;quot;Good parts&amp;quot;) and the design speed" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#eeeeee;strokeColor=#999999;verticalAlign=top;spacingTop=8;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="1414" width="355" height="230" as="geometry"/></mxCell><mxCell id="p0c59" value="&lt;b&gt;Volume CoV EU&lt;/b&gt;&lt;br&gt;&lt;br&gt;Per shift and machine: good parts sum and capacity max (volume variation)&lt;br&gt;&lt;br&gt;7 columns. Used on: no visual reads it directly&lt;br&gt;&lt;br&gt;&lt;b&gt;Decide later (group 2)&lt;/b&gt;&lt;br&gt;&lt;br&gt;SIH source: possible: evaluateKPIs per shift" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#eeeeee;strokeColor=#999999;verticalAlign=top;spacingTop=8;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="415" y="1414" width="355" height="230" as="geometry"/></mxCell><mxCell id="p0c60" value="&lt;b&gt;Format List EU&lt;/b&gt;&lt;br&gt;&lt;br&gt;Product master: brand, unit size, unit count per machine and product&lt;br&gt;&lt;br&gt;8 columns. Used on: By Format&lt;br&gt;&lt;br&gt;&lt;b&gt;Needs file integration (Format Mapping files)&lt;/b&gt;&lt;br&gt;&lt;br&gt;SIH source: productCollections/{id}/products (name, code, description, design speed). Brand, size and count: none" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=8;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="790" y="1414" width="355" height="230" as="geometry"/></mxCell><mxCell id="p0c61" value="&lt;b&gt;Targets Losses EU&lt;/b&gt;&lt;br&gt;&lt;br&gt;Monthly loss target per machine and loss subgroup&lt;br&gt;&lt;br&gt;3 columns. Used on: no visual reads it directly&lt;br&gt;&lt;br&gt;&lt;b&gt;Needs file integration (Glidepaths)&lt;/b&gt;&lt;br&gt;&lt;br&gt;SIH source: none (Glidepaths file)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=8;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1165" y="1414" width="355" height="230" as="geometry"/></mxCell><mxCell id="p0c62" value="&lt;b&gt;OEE Targets EU&lt;/b&gt;&lt;br&gt;&lt;br&gt;Monthly OEE target per line&lt;br&gt;&lt;br&gt;6 columns. Used on: no visual reads it directly&lt;br&gt;&lt;br&gt;&lt;b&gt;Needs file integration (Glidepaths)&lt;/b&gt;&lt;br&gt;&lt;br&gt;SIH source: none (Glidepaths file)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=8;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="1664" width="355" height="230" as="geometry"/></mxCell><mxCell id="p0c63" value="&lt;b&gt;PDT Targets EU&lt;/b&gt;&lt;br&gt;&lt;br&gt;Monthly planned downtime target per line&lt;br&gt;&lt;br&gt;6 columns. Used on: no visual reads it directly&lt;br&gt;&lt;br&gt;&lt;b&gt;Needs file integration (Glidepaths)&lt;/b&gt;&lt;br&gt;&lt;br&gt;SIH source: none (Glidepaths file)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=8;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="415" y="1664" width="355" height="230" as="geometry"/></mxCell><mxCell id="p0c64" value="&lt;b&gt;UPDT Targets EU&lt;/b&gt;&lt;br&gt;&lt;br&gt;Monthly unplanned downtime target per line&lt;br&gt;&lt;br&gt;7 columns. Used on: no visual reads it directly&lt;br&gt;&lt;br&gt;&lt;b&gt;Needs file integration (Glidepaths)&lt;/b&gt;&lt;br&gt;&lt;br&gt;SIH source: none (Glidepaths file)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=8;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="790" y="1664" width="355" height="230" as="geometry"/></mxCell><mxCell id="p0c65" value="&lt;b&gt;Equipment Coding (N, H, W)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Maps a machine and loss description to an equipment name&lt;br&gt;&lt;br&gt;3 columns. Used on: no visual reads it directly&lt;br&gt;&lt;br&gt;&lt;b&gt;Needs file integration (Hull file not downloaded)&lt;/b&gt;&lt;br&gt;&lt;br&gt;SIH source: none. The reason names are in /reasontrees/{id}/reasons&lt;br&gt;&lt;br&gt;Hidden table: not shown in the Data pane" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=8;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1165" y="1664" width="355" height="230" as="geometry"/></mxCell><mxCell id="p0c66" value="&lt;b&gt;Volume Loss Correction (N, H, W)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Loss units per day, machine and loss reason (Provideam OEE Loss report)&lt;br&gt;&lt;br&gt;10 columns. Used on: no visual reads it directly&lt;br&gt;&lt;br&gt;&lt;b&gt;Needs file integration (Provideam report; Hull file not downloaded)&lt;/b&gt;&lt;br&gt;&lt;br&gt;SIH source: none (Insights Hub has no loss units). Rule: stop minutes x capacity per minute&lt;br&gt;&lt;br&gt;Hidden table: not shown in the Data pane" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=8;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="1914" width="355" height="230" as="geometry"/></mxCell><mxCell id="p0c67" value="&lt;b&gt;Targets Volume (N, H, W, M)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Capacity per machine and day (weight for the loss targets)&lt;br&gt;&lt;br&gt;2 columns. Used on: no visual reads it directly&lt;br&gt;&lt;br&gt;&lt;b&gt;Built from the Plan OPT Capacity per machine and day (not a file)&lt;/b&gt;&lt;br&gt;&lt;br&gt;SIH source: built in the flow: sum of the Plan OPT Capacity per machine and day&lt;br&gt;&lt;br&gt;Hidden table: not shown in the Data pane" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=8;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="415" y="1914" width="355" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="1 Machine Names EU" id="page1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1c2" value="&lt;b&gt;Machine Names EU  -&amp;gt;  pbi_machine_names&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="p1c3" value="Holds: List of lines (Excel per site). One row is: One row per machine.&lt;br&gt;Insights Hub table: 2 rows, 7 columns. Only the machines of the Config tab (Hull: 2). The Power BI local copy lists 76 machines of all sites.&lt;br&gt;Used on pages: EU-Level Overview, Site-Level Overview, L2/L3 FIT View, Planned Losses, Unplanned Losses, Maintenance (BETA), Loss Trending, By Shift, By Format, OEE Trending (some through measures)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1260" height="96" as="geometry"/></mxCell><mxCell id="p1c4" value="&lt;b&gt;Power BI column&lt;/b&gt; (blue) and example (below it)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="172" width="270" height="20" as="geometry"/></mxCell><mxCell id="p1c5" value="&lt;b&gt;Insights Hub column&lt;/b&gt; and example (below it)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="172" width="270" height="20" as="geometry"/></mxCell><mxCell id="p1c6" value="&lt;b&gt;SIH integration&lt;/b&gt; (status and difference). Dashed box = SIH source: teal API endpoint, indigo built in the flow, grey none" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="700" y="172" width="600" height="20" as="geometry"/></mxCell><mxCell id="p1c7" value="&lt;b&gt;MachineName&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;string, used on 10 pages&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="280" height="38" as="geometry"/></mxCell><mxCell id="p1c8" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;e.g. S06&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="242" width="280" height="40" as="geometry"/></mxCell><mxCell id="p1c9" value="&lt;b&gt;machine_name&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;String, 100% filled&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="380" y="200" width="280" height="38" as="geometry"/></mxCell><mxCell id="p1c10" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;e.g. B2 Line | GT4&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="380" y="242" width="280" height="40" as="geometry"/></mxCell><mxCe