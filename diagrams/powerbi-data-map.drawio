          </mxGeometry>
        </mxCell>
        <mxCell id="how2-p1c69" value="&lt;b&gt;Power BI table: &lt;/b&gt;Machine Names EU" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=11;strokeWidth=3;" vertex="1" parent="1">
