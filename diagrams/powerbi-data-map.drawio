" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="422" width="280" height="40" as="geometry"/></mxCell><mxCell id="p2c24" value="&lt;b&gt;machine_name&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;String, 100% filled&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="380" y="380" width="280" height="38" as="geometry"/></mxCell><mxCell id="p2c25" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;e.g. B2 Line | GT4&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="380" y="422" width="280" height="40" as="geometry"/></mxCell><mxCell id="p2c26" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#82b366;" edge="1" parent="1" source="p2c22" target="p2c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2c27" value="&lt;b&gt;SIH source&lt;/b&gt;&lt;br&gt;GET /api/assetmanagement/v3/assets/{assetId} -&amp;gt; asset name" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5efee;strokeColor=#3c9a96;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="700" y="380" width="340" height="82" as="geometry"/></mxCell><mxCell id="p2c28" value="&lt;b&gt;OK&lt;/b&gt;&lt;br&gt;Direct. As Machine Names EU." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=4;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1060" y="380" width="500" height="82" as="geometry"/></mxCell><mxCell id="p2c29" value="&lt;b&gt;ShiftName&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;string&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="280" height="38" as="geometry"/></mxCell><mxCell id="p2c30" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;e.g. Day&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="512" width="280" height="40" as="geometry"/></mxCell><mxCell id="p2c31" value="&lt;b&gt;shift_name&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;String, 100% filled&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="380" y="470" width="280" height="38" as="geometry"/></mxCell><mxCell id="p2c32" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;e.g. Shift 2 | Shift 1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="380" y="512" width="280" height="40" as="geometry"/></mxCell><mxCell id="p2c33" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#d79b00;" edge="1" parent="1" source="p2c29" target="p2c31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2c34" value="&lt;b&gt;SIH source&lt;/b&gt;&lt;br&gt;GET /api/oee/v3/calendars/{calendarId}/calendarEvents -&amp;gt; event name and recurrence. The calendarId comes from GET /api/oee/v3/assets/{assetId}/config" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5efee;strokeColor=#3c9a96;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="700" y="470" width="340" height="82" as="geometry"/></mxCell><mxCell id="p2c35" value="&lt;b&gt;ASSUMPTION&lt;/b&gt;&lt;br&gt;Names come from the Insights Hub calendar (Blue, Red, Yellow, Gold, Green, Shift 1, Shift 2). Power BI local copy: crew colours and Day/Afternoon/Night. Accepted; each name must exist in Shift Naming." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=4;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1060" y="470" width="500" height="82" as="geometry"/></mxCell><mxCell id="p2c36" value="&lt;b&gt;PartName&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;string&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="280" height="38" as="geometry"/></mxCell><mxCell id="p2c37" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;e.g. SDENT,GB,GONZALES,12X30 TABS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="602" width="280" height="40" as="geometry"/></mxCell><mxCell id="p2c38" value="&lt;b&gt;part_name&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;String, 83.1% filled&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="380" y="560" width="280" height="38" as="geometry"/></mxCell><mxCell id="p2c39" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;e.g. 250 mg tablets - Pep 8's | Dada/Straw 24's&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="380" y="602" width="280" height="40" as="geometry"/></mxCell><mxCell id="p2c40" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#d79b00;" edge="1" parent="1" source="p2c36" target="p2c38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2c41" value="&lt;b&gt;SIH source&lt;/b&gt;&lt;br&gt;GET /api/oee/v3/assets/{assetId}/filterValues -&amp;gt; product names, then GET /api/oee/v3/productCollections/{collectionId}/products -&amp;gt; description" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5efee;strokeColor=#3c9a96;verticalAlign=top;spacingTop=4;fontSize=10;" vertex