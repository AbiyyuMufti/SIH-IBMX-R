        <mxCell id="p14c71" value="Provideam Packing Hourly Run Rates files (Nottingham, Weinheim seen)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#eeeeee;strokeColor=#999999;verticalAlign=middle;fontSize=10;" vertex="1" parent="1">
