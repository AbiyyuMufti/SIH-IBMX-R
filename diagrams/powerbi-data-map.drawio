          <mxGeometry x="640" y="74" width="480" height="52" as="geometry" />
        </mxCell>
        <mxCell id="V8K-Alwzt7QPzvGKSm8b-3" value="&lt;b&gt;How it works&lt;/b&gt;&lt;br&gt;&lt;br&gt;A flow of Reckitt runs when a file is created or changed in the SharePoint folder. It sends the file by HTTP POST to an endpoint of our VFC (http in node). The VFC converts the file and writes parquet to the data lake. Reckitt already runs Power Automate flows for these reports (maintenance guide)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="640" y="134" width="480" height="156" as="geometry" />
        </mxCell>
        <mxCell id="V8K-Alwzt7QPzvGKSm8b-4" value="&lt;b&gt;What Reckitt must do&lt;/b&gt;&lt;br&gt;&lt;br&gt;A person at Reckitt builds and owns one flow per file type. We build and own the VFC receiver and give them the endpoint address and key (never in documents)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="640" y="298" width="480" height="104" as="geometry" />
        </mxCell>
        <mxCell id="V8K-Alwzt7QPzvGKSm8b-5" value="&lt;b&gt;Tested?&lt;/b&gt;&lt;br&gt;&lt;br&gt;NOT tested. To check: size limit and body format of the VFC http in node, UTF-16 files, key handling, and whether the HTTP action of Power Automate needs a premium licence." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="640" y="410" width="480" height="104" as="geometry" />
        </mxCell>
        <mxCell id="V8K-Alwzt7QPzvGKSm8b-6" value="&lt;b&gt;Good&lt;/b&gt;&lt;br&gt;&lt;br&gt;Push on change, no polling. No new access to SharePoint for us. A tool Reckitt already knows. One receiver serves all sites." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="640" y="522" width="480" height="96" as="geometry" />
        </mxCell>
        <mxCell id="V8K-Alwzt7QPzvGKSm8b-7" value="&lt;b&gt;Risks&lt;/b&gt;&lt;br&gt;&lt;br&gt;A flow can fail without anyone noticing: we need a heartbeat check in our log. Large files (up to 6.5 MB) may exceed the limit. Reckitt must keep the flow alive. The key is a secret inside their flow." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="640" y="626" width="480" height="126" as="geometry" />
        </mxCell>
        <mxCell id="V8K-Alwzt7QPzvGKSm8b-8" value="&lt;b&gt;2  Direct access: the VFC reads SharePoint&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=6;fontSize=10.5;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1160" y="74" width="480" height="52" as="geometry" />
        </mxCell>
        <mxCell id="V8K-Alwzt7QPzvGKSm8b-9" value="&lt;b&gt;How it works&lt;/b&gt;&lt;br&gt;&lt;br&gt;The VFC calls Microsoft Graph (or the SharePoint REST API) on a schedule, lists the folders, downloads new or changed files, converts them and writes parquet to the lake. It logs in with an app registration or a service account with read access to the folders." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="1160" y="134" width="480" height="156" as="geometry" />
        </mxCell>
        <mxCell id="V8K-Alwzt7QPzvGKSm8b-10" value="&lt;b&gt;What Reckitt must do&lt;/b&gt;&lt;br&gt;&lt;br&gt;Reckitt IT creates the app registration or service account and gives read access to the folders of all sites. We keep the secret in the Config node. The VFC must be allowed to call the Microsoft hosts." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="1160" y="298" width="480" height="104" as="geometry" />
        </mxCell>
        <mxCell id="V8K-Alwzt7QPzvGKSm8b-11" value="&lt;b&gt;Tested?&lt;/b&gt;&lt;br&gt;&lt;br&gt;NOT tested. To check: can the VFC reach the Microsoft login and Graph hosts, token handling in an http request node, and how long the IT approval takes." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="1160" y="410" width="480" height="104" as="geometry" />
        </mxCell>
        <mxCell id="V8K-Alwzt7QPzvGKSm8b-12" value="&lt;b&gt;Good&lt;/b&gt;&lt;br&gt;&lt;br&gt;Fully in our control: schedule, retries, file history, logs. Nothing for Reckitt to maintain after the setup. One setup works for all sites." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="1160" y="522" width="480" height="96" as="geometry" />
        </mxCell>
        <mxCell id="V8K-Alwzt7QPzvGKSm8b-13" value="&lt;b&gt;Risks&lt;/b&gt;&lt;br&gt;&lt;br&gt;IT approval is probably the slowest step. A secret that can read SharePoint must be kept safe and renewed. The permission scope may be wider than we need." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="1160" y="626" width="480" height="126" as="geometry" />
        </mxCell>
        <mxCell id="V8K-Alwzt7QPzvGKSm8b-14" value="&lt;b&gt;3  Manual copy (interim, works now)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=6;fontSize=10.5;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1680" y="74" width="480" height="52" as="geometry" />
        </mxCell>
        <mxCell id="V8K-Alwzt7QPzvGKSm8b-15" value="&lt;b&gt;How it works&lt;/b&gt;&lt;br&gt;&lt;br&gt;The user downloads the files from SharePoint (browser, or Claude in Chrome) into the project folder. A script converts them (the loader is not built yet). The user puts the converted files into the data lake. First run: 36 files from the Nottingham site on 2026-10-14." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="1680" y="134" width="480" height="156" as="geometry" />
        </mxCell>
        <mxCell id="V8K-Alwzt7QPzvGKSm8b-16" value="&lt;b&gt;What Reckitt must do&lt;/b&gt;&lt;br&gt;&lt;br&gt;Access to each folder. Missing: five Hull folders and the whole Mira site." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="1680" y="298" width="480" height="104" as="geometry" />
        </mxCell>
        <mxCell id="V8K-Alwzt7QPzvGKSm8b-17" value="&lt;b&gt;Tested?&lt;/b&gt;&lt;br&gt;&lt;br&gt;TESTED and working on 2026-10-14: 36 files, all complete. Chrome blocks repeated automatic downloads, so real clicks are needed." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="1680" y="410" width="480" height="104" as="geometry" />
        </mxCell>
        <mxCell id="V8K-Alwzt7QPzvGKSm8b-18" value="&lt;b&gt;Good&lt;/b&gt;&lt;br&gt;&lt;br&gt;No dependency on Reckitt IT. Good enough for Class A (small files, rare changes). Starts today." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="1680" y="522" width="480" height="96" as="geometry" />
        </mxCell>
        <mxCell id="V8K-Alwzt7QPzvGKSm8b-19" value="&lt;b&gt;Risks&lt;/b&gt;&lt;br&gt;&lt;br&gt;Manual work and delay. Class B files change every hour and go stale. Someone must remember to repeat it. Risk of an old file version: keep the download date in the file name." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="1680" y="626" width="480" height="126" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
