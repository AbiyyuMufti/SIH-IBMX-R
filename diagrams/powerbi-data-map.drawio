, else name). Empty where no product was found." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=4;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="700" y="494" width="600" height="108" as="geometry"/></mxCell><mxCell id="p4c34" value="&lt;b&gt;SIH source: &lt;/b&gt;Product of the hour of the stop: GET /api/oee/v3/assets/{assetId}/filterValues, POST /api/oee/v3/expressions/evaluateKPIs filter PRODUCT, GET /api/oee/v3/productCollections/{collectionId}/products" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#26C6B8;strokeColor=#00897B;verticalAlign=middle;fontSize=10;dashed=1;dashPattern=8 4;strokeWidth=3;fillOpacity=30;fontColor=#00574B;" vertex="1" parent="1"><mxGeometry x="710" y="544" width="580" height="52" as="geometry"/></mxCell><mxCell id="p4c35" value="&lt;b&gt;ShiftName&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;string&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="280" height="38" as="geometry"/></mxCell><mxCell id="p4c36" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;no sample file for this table&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="652" width="280" height="40" as="geometry"/></mxCell><mxCell id="p4c37" value="&lt;b&gt;shift_name&lt;/b&gt;&lt;br&gt;&lt;fo