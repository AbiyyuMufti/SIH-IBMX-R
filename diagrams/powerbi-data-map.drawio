        <mxCell id="p0c2" value="&lt;b&gt;Power BI data overview: what the report reads and what is created from Insights Hub&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=18;" parent="1" vertex="1">
          <mxGeometry x="40" y="20" width="1500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p0c3" value="Source: the existing EU Power BI report (model template and report file, read 2026-10-12/13) and the Insights Hub Hull tables in the data lake (profile of 2026-10-13). The report also reads regional tables (N, H, W, M) directly on some pages; they are not in scope. Sheets 1 to 6 follow, one per table." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="40" y="58" width="1500" height="60" as="geometry" />
        </mxCell>
