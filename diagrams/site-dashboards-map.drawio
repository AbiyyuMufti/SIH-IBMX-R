ont&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="960" y="400" width="300" height="44" as="geometry"/></mxCell><mxCell id="d9c28" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="d9c13" target="d9c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d9c29" value="&lt;b&gt;Historical_OEE_EU&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;report/Historical_OEE_EU/site=...&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="960" y="460" width="300" height="44" as="geometry"/></mxCell><mxCell id="d9c30" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="d9c15" target="d9c29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d9c31" value="&lt;b&gt;SIH rows&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;Plan, Time Utilisation, Losses&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1300" y="160" width="220" height="60" as="geometry"/></mxCell><mxCell id="d9c32" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;dashed=1;" edge="1" parent="1" source="d9c14" target="d9c31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d9c33" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="d9c11" target="d9c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d9c34" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="d9c11" target="d9c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d9c35" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#d79b00;" edge="1" parent="1" source="d9c8" target="d9c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d9c36" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#d79b00;" edge="1" parent="1" source="d9c8" target="d9c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d9c37" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#d79b00;dashed=1;" edge="1" parent="1" source="d9c8" target="d9c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d9c38" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#d79b00;" edge="1" parent="1" source="d9c5" target="d9c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d9c39" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#d79b00;" edge="1" parent="1" source="d9c9" target="d9c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d9c40" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="d9c10" target="d9c15"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="EU scope (idea C1)" id="site10"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="d10c2" value="&lt;b&gt;Built 2026-10-27 (C1): the rows the EU report drops are kept and marked with the column In EU Report, rules in config/report_scope.csv&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;The site dashboards use the same Provideam files and query steps as the EU report, without the EU filters. Our build copies the EU filters today. For the meeting with Segun, then Reckitt.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="50" as="geometry"/></mxCell><mxCell id="d10c3" value="&lt;b&gt;Provideam files&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;all machines of the site&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="300" height="60" as="geometry"/></mxCell><mxCell id="d10c4" value="&lt;b&gt;Build today&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;EU rules DROP the rows&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="420" y="100" width="320" height="60" as="geometry"/></mxCell><mxCell id="d10c5" value="&lt;b&gt;Our 3 tables today&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;packing lines only: EU pages fine, site pages miss machines&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="820" y="100" width="320" height="60" as="geometry"/></mxCell><mxCell id="d10c6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="d10c3" target="d10c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d10c7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="d10c4" target="d10c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d10c8" value="&lt;b&gt;Provideam files&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;all machines of the site&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="300" height="60" as="geometry"/></mxCell><mxCell id="d10c9" value="&lt;b&gt;Build (idea C1)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;a scope rule SETS In EU Report = true / false&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="420" y="210" width="320" height="60" as="geometry"/></mxCell><mxCell id="d10c10" value="&lt;b&gt;Our 3 tables + In EU Report&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;all machines; Machine Names lookup unfiltered&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="820" y="210" width="320" height="60" as="geometry"/></mxCell><mxCell id="d10c11" value="&lt;b&gt;EU pages&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;filter In EU Report = true&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1220" y="170" width="260" height="50" as="geometry"/></mxCell><mxCell id="d10c12" value="&lt;b&gt;Site pages&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;no EU filter; S14 / packing filters per page&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1220" y="260" width="260" height="50" as="geometry"/></mxCell><mxCell id="d10c13" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="d10c8" target="d10c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d10c14" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="d10c9" target="d10c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d10c15" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#82b366;" edge="1" parent="1" source="d10c10" target="d10c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d10c16" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#82b366;" edge="1" parent="1" source="d10c10" target="d10c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d10c17" value="&lt;b&gt;Today's EU rules: one rule for Hull, a different rule per table for Nottingham&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="1100" height="30" as="geometry"/></mxCell><mxCell id="d10c18" value="&lt;b&gt;Hull, every table&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="374" width="300" height="50" as="geometry"/></mxCell><mxCell id="d10c19" value="EU drops the 19 machines whose Dept is Dries Process or Liquids Process (4 Tonne, 6 Tonne, 6000L, GG4 to GG7, Lemsip Process, Senokot Press...). One rule: Dept is Dries Pack or Liquids Pack" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="346" y="374" width="800" height="50" as="geometry"/></mxCell><mxCell id="d10c20" value="&lt;b&gt;Nottingham, Plan OPT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="300" height="40" as="geometry"/></mxCell><mxCell id="d10c21" value="EU keeps areas SD Packing and &amp;quot; Strepsils Packing&amp;quot; (leading space), not S14: 24 machines" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="346" y="430" width="800" height="40" as="geometry"/></mxCell><mxCell id="d10c22" value="&lt;b&gt;Nottingham, Time Utilisation&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="476" width="300" height="40" as="geometry"/></mxCell><mxCell id="d10c23" value="EU keeps a fixed list of 23 machines: the same as Plan OPT minus T1 (looks like an oversight)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="346" y="476" width="800" height="40" as="geometry"/></mxCell><mxCell id="d10c24" value="&lt;b&gt;Nottingham, Daily losses&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="522" width="300" height="50" as="geometry"/></mxCell><mxCell id="d10c25" value="EU drops only 9 names (Bosch, Fette 23, Fette12, Fette2, Fette20, Fette4, Fette5, Gran0, S14): 33 of the 41 non-packing machines stay in the rows, but not in EU Machine Names" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="346" y="522" width="800" height="50" as="geometry"/></mxCell><mxCell id="d10c26" value="&lt;b&gt;Nottingham, Volume CoV / Run Rates&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="578" width="300" height="40" as="geometry"/></mxCell><mxCell id="d10c27" value="EU drops 14 process names (28 non-packing machines stay) / only S14" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="346" y="578" width="800" height="40" as="geometry"/></mxCell><mxCell id="d10c28" value="&lt;b&gt;Nottingham, Machine Names&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="624" width="300" height="40" as="geometry"/></mxCell><mxCell id="d10c29" value="EU keeps the two packing areas: 25 of 66 machines" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="346" y="624" width="800" height="40" as="geometry"/></mxCell><mxCell id="d10c30" value="Dropped in both reports, stays in the build: Nottingham N11 Auto (plan side), B1 - Auto, B4 Auto, B5 Auto (losses); Hull GT4 - Auto. Rows are dropped by machine only, never by product." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="1106" height="50" as="geometry"/></mxCell><mxCell id="d10c31" value="The intent is one rule per machine: &amp;quot;packing lines, not S14&amp;quot;. Applying it to every table makes the EU numbers move slightly where today's Nottingham rules differ (losses and CoV of non-packing machines, T1 in Time Utilisation). To decide (D1)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="746" width="1106" height="50" as="geometry"/></mxCell><mxCell id="d10c32" value="&lt;b&gt;Where the scope could live (to discuss)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="826" width="1100" height="30" as="geometry"/></mxCell><mxCell id="d10c33" value="&lt;b&gt;Option&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="300" height="40" as="geometry"/></mxCell><mxCell id="d10c34" value="&lt;b&gt;How&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="346" y="860" width="330" height="40" as="geometry"/></mxCell><mxCell id="d10c35" value="&lt;b&gt;For&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="682" y="860" width="330" height="40" as="geometry"/></mxCell><mxCell id="d10c36" value="&lt;b&gt;Against&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1018" y="860" width="330" height="40" as="geometry"/></mxCell><mxCell id="d10c37" value="&lt;b&gt;A. Rule per site in Config (on Machine Names columns)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="906" width="300" height="70" as="geometry"/></mxCell><mxCell id="d10c38" value="Nottingham: Area is SD Packing or Strepsils Packing, except S14. Hull: Dept is Dries Pack or Liquids Pack" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="346" y="906" width="330" height="70" as="geometry"/></mxCell><mxCell id="d10c39" value="No file changes; a new machine is classified by its Area / Dept automatically; SIH rows follow the same lookup" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="682" y="906" width="330" height="70" as="geometry"/></mxCell><mxCell id="d10c40" value="The rule lives with us, not with Reckitt" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1018" y="906" width="330" height="70" as="geometry"/></mxCell><mxCell id="d10c41" value="&lt;b&gt;B. Column In EU Report in the Machine Names file&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="982" width="300" height="50" as="geometry"/></mxCell><mxCell id="d10c42" value="One Y/N per machine in the site file" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="346" y="982" width="330" height="50" as="geometry"/></mxCell><mxCell id="d10c43" value="Clear, one row per machine, owned by the site" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="682" y="982" width="330" height="50" as="geometry"/></mxCell><mxCell id="d10c44" value="The file is Reckitt's (SharePoint): our copy is overwritten unless Reckitt adds the column" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1018" y="982" width="330" height="50" as="geometry"/></mxCell><mxCell id="d10c45" value="&lt;b&gt;C. Own scope list in eu_report/reference&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="1038" width="300" height="40" as="geometry"/></mxCell><mxCell id="d10c46" value="MachineName, In EU Report per site" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="346" y="1038" width="330" height="40" as="geometry"/></mxCell><mxCell id="d10c47" value="Explicit, ours" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="682" y="1038" width="330" height="40" as="geometry"/></mxCell><mxCell id="d10c48" value="One more file to keep in step with Machine Names" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1018" y="1038" width="330" height="40" as="geometry"/></mxCell><mxCell id="d10c49" value="Size: Nottingham plan rows about 2.4 times (Sep 2026: 1,132 to 2,744). Proof when built: the rows with In EU Report = true equal today's files (with the per-table rules)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="1094" width="1308" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="What SIH can give" id="site11"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="d11c2" value="&lt;b&gt;Every data need: Provideam today and the SIH source for a line that has switched&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;Coverage today: Hull B2 Line + 7 machines and GT4 in SIH; Nottingham N1 not configured. Plan to switch lines exists. Columns are not the limit: the loss reasons and comments are.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="50" as="geometry"/></mxCell><mxCell id="d11c3" value="&lt;b&gt;OURS TODAY&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1400" y="20" width="260" height="30" as="geometry"/></mxCell><mxCell id="d11c4" value="&lt;b&gt;NEW TABLE FROM FILES WE HOLD&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1400" y="60" width="260" height="30" as="geometry"/></mxCell><mxCell id="d11c5" value="&lt;b&gt;ONE-TIME ARCHIVE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1400" y="100" width="260" height="30" as="geometry"/></mxCell><mxCell id="d11c6" value="&lt;b&gt;NEW FILE OR INPUT (RECKITT)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1400" y="140" width="260" height="30" as="geometry"/></mxCell><mxCell id="d11c7" value="&lt;b&gt;NOT AVAILABLE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1400" y="180" width="260" height="30" as="geometry"/></mxCell><mxCell id="d11c8" value="&lt;b&gt;Nee