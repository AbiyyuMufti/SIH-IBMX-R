        <mxCell id="p10c16" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="p10c9" target="p10c13" edge="1">
          <mxGeometry relative="1" as="geometry" />
