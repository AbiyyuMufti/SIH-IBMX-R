        <mxCell id="p13c41" value="Plan OPT: OEE = Good Parts / Capacity. Performance Availability report" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10.5;" vertex="1" parent="1">
