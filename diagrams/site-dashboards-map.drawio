        <mxCell id="p10c18" value="Pages: EU-Level Overview, Site-Level Overview, L2/L3 FIT View, Planned Losses, Unplanned Losses, Maintenance (BETA), Loss Trending, By Shift, By Format, OEE Trending" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" parent="1" vertex="1">
