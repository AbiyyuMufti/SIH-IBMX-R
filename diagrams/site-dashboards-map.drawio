        <mxCell id="p10c20" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;" parent="1" source="p10c11" target="p10c17" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p10c21" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;" parent="1" source="p10c11" target="p10c18" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p10c22" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;" parent="1" source="p10c13" target="p10c19" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p10c23" value="&lt;b&gt;How a machine finds its filters: the key texts must be equal&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="40" y="500" width="1500" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p10c24" value="&lt;b&gt;1 A machine in the Insights Hub data&lt;/b&gt;&lt;br&gt;&lt;br&gt;Asset B2 Line, hierarchy Hull / Bottles / B2 Line&lt;br&gt;&lt;br&gt;Key today: the asset ID (32 characters)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=10.5;" parent="1" vertex="1">
          <mxGeometry x="40" y="540" width="330" height="168" as="geometry" />
        </mxCell>
        <mxCell id="p10c25" value="&lt;b&gt;2 The report key&lt;/b&gt;&lt;br&gt;&lt;br&gt;Unique Machine Name = machine name + &amp;quot;-Hull&amp;quot;&lt;br&gt;&lt;br&gt;B2 Auto-Hull (Plan OPT, Daily Losses, Glidepaths, Format List all use it)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=6;fontSize=10.5;" parent="1" vertex="1">
          <mxGeometry x="430" y="540" width="330" height="168" as="geometry" />
        </mxCell>
        <mxCell id="p10c26" value="&lt;b&gt;3 The file row&lt;/b&gt;&lt;br&gt;&lt;br&gt;B2 Auto | Liquids Pack | Liquids | Bottles&lt;br&gt;&lt;br&gt;Dept, Area and Product Type come only from this file" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=6;fontSize=10.5;" parent="1" vertex="1">
          <mxGeometry x="830" y="540" width="330" height="168" as="geometry" />
        </mxCell>
        <mxCell id="p10c27" value="&lt;b&gt;Keys are equal&lt;/b&gt;&lt;br&gt;The machine shows in the selectors with its Dept, Area and Product Type." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=6;fontSize=10.5;" parent="1" vertex="1">
          <mxGeometry x="1230" y="540" width="330" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p10c28" value="&lt;b&gt;Keys differ&lt;/b&gt;&lt;br&gt;B2 Line (Insights Hub) is not B2 Auto-Hull: the machine has no row or no filters." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacingTop=6;fontSize=10.5;" parent="1" vertex="1">
          <mxGeometry x="1230" y="632" width="330" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p10c29" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" parent="1" source="p10c24" target="p10c25" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p10c30" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" parent="1" source="p10c25" target="p10c26" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p10c31" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#82b366;" parent="1" source="p10c26" target="p10c27" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p10c32" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;dashed=1;" parent="1" source="p10c26" target="p10c28" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p10c33" value="&lt;b&gt;What can make the texts differ or the file fail&lt;/b&gt;&lt;br&gt;1. Machine key: Insights Hub uses the asset ID, the report uses machine name + site. Decision open. Either the Insights Hub tables write the report key, or a mapping table links them.&lt;br&gt;2. Names differ: B2 Line (Insights Hub) and B2 Auto (Provideam, files). GT4 is the same in both.&lt;br&gt;3. Dept, Area and Product Type are three different columns in the file (for example Liquids Pack, Liquids, Bottles). Insights Hub has one area. Today all three columns take the area.&lt;br&gt;4. The Hull file was not downloaded. Access to the folder is needed." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=6;fontSize=10.5;" parent="1" vertex="1">
          <mxGeometry x="40" y="728" width="1520" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram><diagram name="Background: Equipment Coding" id="page11">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" /><mxCell id="bg-note" value="&lt;b&gt;Background page (state of 2026-10-14, copied from powerbi-data-map.drawio)&lt;/b&gt;&lt;br&gt;Since then: used by the Provideam build only; SIH rows take the reason sub group as Equipment." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="-60" width="1000" height="50" as="geometry"/></mxCell>
        <mxCell id="p11c2" value="&lt;b&gt;Equipment Coding: from the Equipment Coding files to the Equipment column&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p11c3" value="Purple = needs the Equipment Coding files. Hull file: NOT downloaded (no access). Nottingham and Weinheim files were checked. Blue = Power BI page. The guide says the board works without this file (optional)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1520" height="62" as="geometry" />
        </mxCell>
        <mxCell id="p11c4" value="&lt;b&gt;1 Source file&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="330" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p11c5" value="&lt;b&gt;2 Table in the report&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="140" width="330" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p11c6" value="&lt;b&gt;3 Columns it fills&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="830" y="140" width="330" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p11c7" value="&lt;b&gt;4 Where they are used&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1230" y="140" width="330" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p11c8" value="&lt;b&gt;Equipment Coding files&lt;/b&gt;&lt;br&gt;&lt;br&gt;SharePoint, one folder per site. Kept by hand: for every machine and loss description, the equipment that caused the loss.&lt;br&gt;&lt;br&gt;Columns: MachineName | OEELossLvl3Desc | Merged Unique Identifier | Equipment | Lvl 3 Loss Name (empty in all rows)&lt;br&gt;&lt;br&gt;Nottingham: 4,331 rows, 62 machines, 130 equipment values. Weinheim: 267 rows, 6 machines.&lt;br&gt;&lt;br&gt;Example: O5 100% Inspection -&amp;gt; 100% Inspection" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="330" height="300" as="geometry" />
        </mxCell>
        <mxCell id="p11c9" value="&lt;b&gt;Equipment Coding H / N / W (hidden)&lt;/b&gt;&lt;br&gt;Merged Unique Identifier, Equipment, Lvl 3 Loss Name&lt;br&gt;key = machine name + loss description. An empty Equipment becomes &amp;quot;Unclassed&amp;quot;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="430" y="170" width="330" height="94" as="geometry" />
        </mxCell>
        <mxCell id="p11c10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p11c8" target="p11c9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p11c11" value="&lt;b&gt;Daily Losses EU [Equipment]&lt;/b&gt;&lt;br&gt;looked up with the key machine + loss description" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="830" y="170" width="330" height="62" as="geometry" />
        </mxCell>
        <mxCell id="p11c12" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p11c9" target="p11c11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p11c13" value="Pages that use Equipment: Planned Losses, Unplanned Losses" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="1230" y="170" width="330" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p11c14" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="p11c11" target="p11c13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p11c15" value="&lt;b&gt;How one stop finds its equipment: the machine and the description must be equal&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="1500" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p11c16" value="&lt;b&gt;1 A stop in the Insights Hub data&lt;/b&gt;&lt;br&gt;&lt;br&gt;Machine: B2 Line&lt;br&gt;&lt;br&gt;Reason (leaf): 001 PRESSED EMERGENCY IN MAIN P.B.PANEL AREA&lt;br&gt;&lt;br&gt;Second reason level (stand-in): for example Capper" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="330" height="168" as="geometry" />
        </mxCell>
        <mxCell id="p11c17" value="&lt;b&gt;2 The report builds a key&lt;/b&gt;&lt;br&gt;&lt;br&gt;Equipment Loss Key = machine name + loss description&lt;br&gt;&lt;br&gt;B2 Auto 001 PRESSED EMERGENCY IN MAIN P.B.PANEL AREA" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="430" y="540" width="330" height="168" as="geometry" />
        </mxCell>
        <mxCell id="p11c18" value="&lt;b&gt;3 It looks for the same text in the file&lt;/b&gt;&lt;br&gt;&lt;br&gt;Provideam descriptions look like: 100% Inspection&lt;br&gt;&lt;br&gt;Hull descriptions seen in the guide: Cleaning Area, Labeller Head 1 Coding" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="830" y="540" width="330" height="168" as="geometry" />
        </mxCell>
        <mxCell id="p11c19" value="&lt;b&gt;Texts are equal&lt;/b&gt;&lt;br&gt;Nottingham: 98% of the unplanned stops have an entry. Weinheim: 70%." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="1230" y="540" width="330" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p11c20" value="&lt;b&gt;Texts differ&lt;/b&gt;&lt;br&gt;The stop gets &amp;quot;Unclassed&amp;quot; or no equipment. B2 reason texts of Insights Hub are alarm texts, not Provideam descriptions." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="1230" y="632" width="330" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p11c21" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="p11c16" target="p11c17">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p11c22" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="p11c17" target="p11c18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p11c23" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#82b366;" edge="1" parent="1" source="p11c18" target="p11c19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p11c24" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="p11c18" target="p11c20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p11c25" value="&lt;b&gt;What can make the texts differ or the file fail&lt;/b&gt;&lt;br&gt;1. The reason text of Insights Hub (B2: alarm texts) is not the Provideam description. Fix: a mapping from the Insights Hub reason to the Provideam description, or an equipment column kept in Insights Hub.&lt;br&gt;2. Coverage depends on the people who keep the file: 98% (Nottingham) and 70% (Weinheim) of the unplanned stops. New loss types need a new row.&lt;br&gt;3. The Hull file was not downloaded. Access to the folder is needed." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="728" width="1520" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram><diagram name="Background: Loss Units" id="page12">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" /><mxCell id="bg-note" value="&lt;b&gt;Background page (state of 2026-10-14, copied from powerbi-data-map.drawio)&lt;/b&gt;&lt;br&gt;Since then: Provideam rows take Loss Units from Volume Loss Correction; SIH rows use design speed x stop minutes, and their Time in Mins is the stop minutes (Loss in CUs = Loss Units)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="-80" width="1000" height="70" as="geometry"/></mxCell>
        <mxCell id="p12c2" value="&lt;b&gt;Loss Units: from the Volume Loss Correction files to the Loss Units column&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p12c3" value="Purple = needs the Volume Loss Correction files. They are a daily Provideam report (OEE Loss, group by object), not a manual file. Hull file: NOT downloaded (no access). Nottingham and Weinheim files were checked. Blue = Power BI visual." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1520" height="62" as="geometry" />
        </mxCell>
        <mxCell id="p12c4" value="&lt;b&gt;1 Source file&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="330" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p12c5" value="&lt;b&gt;2 Table in the report&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="140" width="330" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p12c6" value="&lt;b&gt;3 Columns it fills&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="830" y="140" width="330" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p12c7" value="&lt;b&gt;4 Where they are used&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1230" y="140" width="330" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p12c8" value="&lt;b&gt;Volume Loss Correction files&lt;/b&gt;&lt;br&gt;&lt;br&gt;SharePoint, one folder per site. Written by a Provideam report (OEE Loss, group by object), one file per month plus the current month.&lt;br&gt;&lt;br&gt;Columns: ShiftStartDate | MachineName | OEELossLvl3Group | OEELossLvl3SubGroup | OEELossLvl3Desc | Time | Loss Units&lt;br&gt;&lt;br&gt;Example: Fette12, Not Logged, Not Logged, 00:20:00, 11.87 units" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="330" height="300" as="geometry" />
        </mxCell>
        <mxCell id="p12c9" value="&lt;b&gt;Volume Loss Correction H / N / W (hidden)&lt;/b&gt;&lt;br&gt;Loss Units, Volume Key, Time in Mins, Hour/Minute/Second Time&lt;br&gt;Volume Key = day + machine + group + sub group + description. The key must be unique (maintenance guide)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="430" y="170" width="330" height="94" as="geometry" />
        </mxCell>
        <mxCell id="p12c10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p12c8" target="p12c9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p12c11" value="&lt;b&gt;Daily Losses EU [Loss Units]&lt;/b&gt;&lt;br&gt;joined on the Volume Key" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="830" y="170" width="330" height="62" as="geometry" />
        </mxCell>
        <mxCell id="p12c12" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;" edge="1" parent="1" source="p12c9" target="p12c11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p12c13" value="2 Unplanned Loss %, 3 Planned Loss %" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="1230" y="170" width="330" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p12c14" value="5 Top 5 Loss Categories, 8 Unplanned Loss vs Target" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="1230" y="216" width="330" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p12c15" value="7 Planned Loss vs Target, 9 Top Losses" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="1230" y="262" width="330" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p12c16" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="p12c11" target="p12c13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p12c17" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="p12c11" target="p12c14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p12c18" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="p12c11" target="p12c15">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p12c19" value="&lt;b&gt;How Loss Units are made: the rule is the same in both systems&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="1500" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p12c20" value="&lt;b&gt;1 Insights Hub (our assumption)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Loss Units = design speed per minute x stop minutes&lt;br&gt;&lt;br&gt;design speed from the product (productCollections/.../products)&lt;br&gt;&lt;br&gt;duration from downtimeReasons" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="330" height="168" as="geometry" />
        </mxCell>
        <mxCell id="p12c21" value="&lt;b&gt;2 Provideam (the file)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Loss Units = loss time x capacity per planned minute of the product&lt;br&gt;&lt;br&gt;Checked on Nottingham: 2,341 of 2,349 machine-days within 3% (median ratio 1)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="430" y="540" width="330" height="168" as="geometry" />
        </mxCell>
        <mxCell id="p12c22" value="&lt;b&gt;3 The report&lt;/b&gt;&lt;br&gt;&lt;br&gt;Daily Losses EU [Loss Units] is looked up by the Volume Key&lt;br&gt;&lt;br&gt;Loss % = Loss Units / Capacity (Plan OPT)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="830" y="540" width="330" height="168" as="geometry" />
        </mxCell>
        <mxCell id="p12c23" value="&lt;b&gt;Same rule&lt;/b&gt;&lt;br&gt;If the speed per minute is the same, the Loss Units are the same." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="1230" y="540" width="330" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p12c24" value="&lt;b&gt;Different speed&lt;/b&gt;&lt;br&gt;Capacity per minute of Provideam differs from the design speed of Insights Hub: the numbers differ." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="1230" y="632" width="330" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p12c25" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="p12c20" target="p12c21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p12c26" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="1" source="p12c21" target="p12c22">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p12c27" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#82b366;" edge="1" parent="1" source="p12c22" target="p12c23">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p12c28" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="p12c22" target="p12c24">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p12c29" value="&lt;b&gt;What can make the texts differ or the file fail&lt;/b&gt;&lt;br&gt;1. The rule is confirmed on Nottingham data, not on Hull (Hull file missing). The speed per minute decides the result: Provideam capacity against Insights Hub design speed (B2: one speed per product, GT4: not always the design speed).&lt;br&gt;2. The file is a daily total per machine, reason and day. Insights Hub has one row per stop. The report joins on day + machine + reason. Fix: build the same key, and check that the sum per key is equal.&lt;br&gt;3. Planned losses exist in the file (groups Planned Losses, Production Not Scheduled). Insights Hub has no planned stops in the Hull data." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="728" width="1520" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram><diagram name="Background: Provideam vs Insights Hub" id="page13">
