        <mxCell id="p10c17" value="11 Site, 12 Department, 14 Line, 15 Product Type selectors (EU-Level Overview)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;" parent="1" vertex="1">
