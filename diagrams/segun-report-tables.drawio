ometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Conventions and decisions" id="segun3"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t3c2" value="&lt;b&gt;Conventions&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="30" as="geometry"/></mxCell><mxCell id="t3c3" value="&lt;b&gt;Naming&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="180" height="50" as="geometry"/></mxCell><mxCell id="t3c4" value="Table names start with shift_ and follow the report section. Column names use the words on the report (machine, rejects, stops, worst_alarm), not the Insights Hub KPI names." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="220" y="60" width="860" height="50" as="geometry"/></mxCell><mxCell id="t3c5" value="&lt;b&gt;Keys&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="180" height="40" as="geometry"/></mxCell><mxCell id="t3c6" value="Every table starts with line, production_day, window (day or crew name). One slicer filters every visual." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="220" y="110" width="860" height="40" as="geometry"/></mxCell><mxCell id="t3c7" value="&lt;b&gt;Times&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="180" height="40" as="geometry"/></mxCell><mxCell id="t3c8" value="Local time only, as text HH:MM (_local). No UTC, no ids, no loaded_at in these tables: they stay in rpt_*." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="220" y="150" width="860" height="40" as="geometry"/></mxCell><mxCell id="t3c9" value="&lt;b&gt;Numbers&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="180" height="50" as="geometry"/></mxCell><mxCell id="t3c10" value="Percent as 0 to 100 (_pct). Durations twice: _min (number, to sum) and _text (&amp;quot;3h 43m&amp;quot;, to show). Counts whole numbers. CU = bottles at the target rate." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="220" y="190" width="860" height="50" as="geometry"/></mxCell><mxCell id="t3c11" value="&lt;b&gt;Long tables&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="180" height="50" as="geometry"/></mxCell><mxCell id="t3c12" value="Where the report shows a bar of parts or a ring per KPI (shift_kpi, shift_capacity, shift_machine_time) the table is unpivoted: one row per part, with a label as on the report and an _order column for sorting and colour." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="220" y="240" width="860" height="50" as="geometry"/></mxCell><mxCell id="t3c13" value="&lt;b&gt;Missing&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="180" height="50" as="geometry"/></mxCell><mxCell id="t3c14" value="A column the report needs but we cannot fill stays in the table, empty, and is marked here. Nothing is invented. Provideam &amp;quot;vs&amp;quot; numbers are dropped (cross-check only)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="220" y="290" width="860" height="50" as="geometry"/></mxCell><mxCell id="t3c15" value="&lt;b&gt;rpt_* stays&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="180" height="50" as="geometry"/></mxCell><mxCell id="t3c16" value="rpt_window, rpt_hour, rpt_event stay as the detail source in the lake. The shift_* tables are built from them (plus later sources) and are all Segun reads." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="220" y="340" width="860" height="50" as="geometry"/></mxCell><mxCell id="t3c17" value="&lt;b&gt;Open decisions&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1000" height="30" as="geometry"/></mxCell><mxCell id="t3c18" value="Where to build shift_*: (a) a new VFC step after the shift report flow reads rpt_* and writes shift_* parquet, (b) a Tableau / Power BI prep step. Recommendation: (a), so the logic lives in one place." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="1040" height="50" as="geometry"/></mxCell><mxCell id="t3c19" value="Report per day, per shift, or both? The window key allows both; the PDF covers the whole day." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="1040" height="40" as="geometry"/></mxCell><mxCell id="t3c20" value="Report name and order of each machine, and whether 05 Antares shows (Config)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="1040" height="40" as="geometry"/></mxCell><mxCell id="t3c21" value="Running time for the running rate: line net production time or the Filler run time (the PDF uses 9h 08m)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1040" height="40" as="geometry"/></mxCell><mxCell id="t3c22" value="Next step after this plan is approved: dummy data, one sheet per table, values from the PDF, MISSING where no source." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="1040" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>