ry"/></mxCell><mxCell id="34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="26" target="33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="35" value="PowerBI/EU OEE Dashboard ASz/: Plan OPT/, Line Losses/, Volume Loss Correction/, Equipment Coding/, GlidePath Targets/, Shift Pattern Naming/, MachineNames/." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="970" y="420" width="340" height="74" as="geometry"/></mxCell><mxCell id="36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="28" target="35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="37" value="Local copy of the&#xa;raw exports" style="text;html=0;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="150" height="59" as="geometry"/></mxCell><mxCell id="38" value="sharepoint/source_original/&lt;kind&gt;/site=&lt;Site&gt;/ (UTF-16, tab). The notebook reads these. kind = plan_opt, line_losses, volume_loss_correction." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="520" width="340" height="59" as="geometry"/></mxCell><mxCell id="39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="31" target="38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="40" value="Same, site=Hull." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="590" y="520" width="340" height="59" as="geometry"/></mxCell><mxCell id="41" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="33" target="40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="42" value="Same, site=Nottingham." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="970" y="520" width="340" height="59" as="geometry"/></mxCell><mxCell id="43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="35" target="42"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="44" value="Rules that differ&#xa;(the notebook switches)" style="text;html=0;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="605" width="150" height="59" as="geometry"/></mxCell><mxCell id="45" value="machine_filter: EU drops machines and areas. minutes: EU drops seconds (losses duration, plan times). sub_group_names: EU renames Hull sub groups." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="210" y="605" width="340" height="59" as="geometry"/></mxCell><mxCell id="46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="38" target="45"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="47" value="file_order: Hull site sorts losses files by Date created. target_key: machine instead of machine-site. glidepath: site file instead of regional." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="590" y="605" width="340" height="59" as="